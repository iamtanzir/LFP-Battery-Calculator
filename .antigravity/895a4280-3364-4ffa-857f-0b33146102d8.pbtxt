        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            // Battery Cylinder Custom Canvas Drawing"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            Row("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                modifier = Modifier"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                    .fillMaxWidth()"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                    .height(90.dp),"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                verticalAlignment = Alignment.CenterVertically,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                horizontalArrangement = Arrangement.Center"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            ) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
