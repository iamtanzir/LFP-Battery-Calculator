          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        else -> \"\342\200\242 To fully recharge your ${viewModel.totalWattHours.toInt()} Wh battery bank in 5 peak sun hours, a solar PV array of at least ${viewModel.recommendedSolarWatts.roundToInt()} Watts is required.\""
