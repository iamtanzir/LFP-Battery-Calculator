    replacement_chunks {
      target_content: "    // Save Configuration Dialog\n    if (showSaveDialog) {\n        AlertDialog(\n            onDismissRequest = { showSaveDialog = false },\n            title = { Text(\"\340\246\254\340\247\215\340\246\257\340\246\276\340\246\237\340\246\276\340\246\260\340\246\277 \340\246\241\340\246\277\340\246\234\340\246\276\340\246\207\340\246\250 \340\246\270\340\246\202\340\246\260\340\246\225\340\247\215\340\246\267\340\246\243 \340\246\225\340\246\260\340\247\201\340\246\250\", fontWeight = FontWeight.Bold) },\n            text = {\n                Column {\n                    Text(\n                        \"\340\246\206\340\246\252\340\246\250\340\246\276\340\246\260 \340\246\225\340\246\276\340\246\270\340\247\215\340\246\237\340\246\256 \340\246\241\340\246\277\340\246\234\340\246\276\340\246\207\340\246\250 \340\246\225\340\246\260\340\246\276 LFP \340\246\254\340\247\215\340\246\257\340\246\276\340\246\237\340\246\276\340\246\260\340\246\277 \340\246\252\340\247\215\340\246\257\340\246\276\340\246\225 \340\246\270\340\247\207\340\246\237\340\246\206\340\246\252\340\246\237\340\246\277 \340\246\250\340\246\276\340\246\256 \340\246\246\340\246\277\340\247\237\340\247\207 \340\246\270\340\247\207\340\246\255 \340\246\225\340\246\260\340\247\207 \340\246\260\340\246\276\340\246\226\340\247\201\340\246\250\340\245\244\",\n                        style = MaterialTheme.typography.bodyMedium,\n                        color = MaterialTheme.colorScheme.onSurfaceVariant\n                    )\n                    Spacer(modifier = Modifier.height(12.dp))\n                    OutlinedTextField(\n                        value = configNameInput,\n                        onValueChange = { configNameInput = it },\n                        label = { Text(\"\340\246\241\340\246\277\340\246\234\340\246\276\340\246\207\340\246\250 \340\246\254\340\246\276 \340\246\252\340\247\215\340\246\257\340\246\276\340\246\225\340\247\207\340\246\260 \340\246\250\340\246\276\340\246\256\") },\n                        singleLine = true,\n                        modifier = Modifier\n                            .fillMaxWidth()\n                            .testTag(\"config_name_input\"),\n                        keyboardOptions = KeyboardOptions(imeAction = ImeAction.Done),\n                        keyboardActions = KeyboardActions(onDone = { focusManager.clearFocus() })\n                    )\n                }\n            },\n            confirmButton = {\n                Button(\n                    onClick = {\n                        if (configNameInput.isNotBlank()) {\n                            viewModel.saveCurrentConfig(configNameInput)\n                            showSaveDialog = false\n                        }\n                    },\n                    modifier = Modifier.testTag(\"save_config_confirm\")\n                ) {\n                    Text(\"\340\246\270\340\246\202\340\246\260\340\246\225\340\247\215\340\246\267\340\246\243 \340\246\225\340\246\260\340\247\201\340\246\250\")\n                }\n            },\n            dismissButton = {\n                TextButton(onClick = { showSaveDialog = false }) {\n                    Text(\"\340\246\254\340\246\276\340\246\244\340\246\277\340\246\262\")\n                }\n            }\n        )\n    }\n}"
      replacement_content: "    // Save Configuration Dialog\n    if (showSaveDialog) {\n        AlertDialog(\n            onDismissRequest = { showSaveDialog = false },\n            title = { Text(t(\"dialog_save_title\"), fontWeight = FontWeight.Bold) },\n            text = {\n                Column {\n                    Text(\n                        t(\"dialog_save_desc\"),\n                        style = MaterialTheme.typography.bodyMedium,\n                        color = MaterialTheme.colorScheme.onSurfaceVariant\n                    )\n                    Spacer(modifier = Modifier.height(12.dp))\n                    OutlinedTextField(\n                        value = configNameInput,\n                        onValueChange = { configNameInput = it },\n                        label = { Text(t(\"dialog_input_label\")) },\n                        singleLine = true,\n                        modifier = Modifier\n                            .fillMaxWidth()\n                            .testTag(\"config_name_input\"),\n                        keyboardOptions = KeyboardOptions(imeAction = ImeAction.Done),\n                        keyboardActions = KeyboardActions(onDone = { focusManager.clearFocus() })\n                    )\n                }\n            },\n            confirmButton = {\n                Button(\n                    onClick = {\n                        if (configNameInput.isNotBlank()) {\n                            viewModel.saveCurrentConfig(configNameInput)\n                            showSaveDialog = false\n                        }\n                    },\n                    modifier = Modifier.testTag(\"save_config_confirm\")\n                ) {\n                    Text(t(\"dialog_save\"))\n                }\n            },\n            dismissButton = {\n                TextButton(onClick = { showSaveDialog = false }) {\n                    Text(t(\"dialog_cancel\"))\n                }\n            }\n        )\n    }\n\n    // Language Selection Dialog\n    if (showLanguageDialog) {\n        AlertDialog(\n            onDismissRequest = { showLanguageDialog = false },\n            title = { Text(t(\"select_language_title\"), fontWeight = FontWeight.Bold) },\n            text = {\n                Column(\n                    modifier = Modifier.fillMaxWidth(),\n                    verticalArrangement = Arrangement.spacedBy(8.dp)\n                ) {\n                    val languages = listOf(\n                        \"en\" to \"English\",\n                        \"bn\" to \"\340\246\254\340\246\276\340\246\202\340\246\262\340\246\276 (Bengali)\",\n                        \"zh\" to \"\344\270\255\346\226\207 (Chinese)\",\n                        \"de\" to \"Deutsch (German)\",\n                        \"ko\" to \"\355\225\234\352\265\255\354\226\264 (Korean)\"\n                    )\n                    languages.forEach { (code, name) ->\n                        val isSelected = viewModel.appLanguage == code\n                        Surface(\n                            modifier = Modifier\n                                .fillMaxWidth()\n                                .clickable {\n                                    viewModel.appLanguage = code\n                                    showLanguageDialog = false\n                                },\n                            shape = RoundedCornerShape(8.dp),\n                            color = if (isSelected) MaterialTheme.colorScheme.primaryContainer else MaterialTheme.colorScheme.surface,\n                            border = if (isSelected) androidx.compose.foundation.BorderStroke(1.dp, MaterialTheme.colorScheme.primary) else null\n                        ) {\n                            Row(\n                                modifier = Modifier\n                                    .fillMaxWidth()\n                                    .padding(14.dp),\n                                horizontalArrangement = Arrangement.SpaceBetween,\n                                verticalAlignment = Alignment.CenterVertically\n                            ) {\n                                Text(\n                                    text = name,\n                                    fontWeight = if (isSelected) FontWeight.Bold else FontWeight.Normal,\n                                    color = if (isSelected) MaterialTheme.colorScheme.onPrimaryContainer else MaterialTheme.colorScheme.onSurface\n                                )\n                                if (isSelected) {\n                                    Icon(\n                                        imageVector = Icons.Default.Check,\n                                        contentDescription = null,\n                                        tint = MaterialTheme.colorScheme.primary\n                                    )\n                                }\n                            }\n                        }\n                    }\n                }\n            },\n            confirmButton = {},\n            dismissButton = {\n                TextButton(onClick = { showLanguageDialog = false }) {\n                    Text(t(\"dialog_cancel\"))\n                }\n            }\n        )\n    }\n}"
    }
