ight = 16.sp\n                    )\n                }\n            },\n            confirmButton = {\n                Button(\n                    onClick = { showCopyrightDialog = false },\n                    colors = ButtonDefaults.buttonColors(containerColor = MaterialTheme.colorScheme.primary)\n                ) {\n                    Text(\"\340\246\254\340\247\201\340\246\235\340\247\207\340\246\233\340\246\277 (Close)\")\n                }\n            }\n        )\n    }\n}"
