        lines {
          text: "        \"bn\" -> \"\342\200\242 \340\246\206\340\246\252\340\246\250\340\246\276\340\246\260 ${viewModel.totalWattHours.toInt()} Wh \340\246\254\340\247\215\340\246\257\340\246\276\340\246\237\340\246\276\340\246\260\340\246\277 \340\247\253 \340\246\230\340\246\243\340\247\215\340\246\237\340\246\276\340\246\260 \340\246\260\340\247\214\340\246\246\340\247\215\340\246\260\340\247\207 \340\246\252\340\247\201\340\246\260\340\247\213\340\246\252\340\247\201\340\246\260\340\246\277 \340\246\260\340\246\277\340\246\232\340\246\276\340\246\260\340\247\215\340\246\234 \340\246\225\340\246\260\340\246\244\340\247\207 \340\246\250\340\247\215\340\246\257\340\247\202\340\246\250\340\246\244\340\246\256 ${viewModel.recommendedSolarWatts.roundToInt()} \340\246\223\340\247\237\340\246\276\340\246\237\340\247\207\340\246\260 \340\246\252\340\247\215\340\246\257\340\246\276\340\246\250\340\247\207\340\246\262 \340\246\205\340\247\215\340\246\257\340\246\276\340\246\260\340\247\207 \340\246\262\340\246\276\340\246\227\340\246\254\340\247\207\340\245\244\""
