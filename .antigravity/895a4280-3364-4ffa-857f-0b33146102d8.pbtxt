        }
        lines {
          text: "                        val cardBg = if (selected) MaterialTheme.colorScheme.primaryContainer.copy(alpha = 0.25f) else MaterialTheme.colorScheme.surfaceVariant.copy(alpha = 0.2f)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                        val border = if (selected) borderStroke(1.5.dp, MaterialTheme.colorScheme.primary) else borderStroke(0.5.dp, Color.LightGray.copy(alpha = 0.5f))"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
