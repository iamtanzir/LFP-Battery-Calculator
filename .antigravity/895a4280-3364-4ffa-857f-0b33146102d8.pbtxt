        lines {
          text: "                    val level = dodPercent / 100.0"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    val animatedLevel by animateFloatAsState("
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                        targetValue = level.toFloat(),"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
