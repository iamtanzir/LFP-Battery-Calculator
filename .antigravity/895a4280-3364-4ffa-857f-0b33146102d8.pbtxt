        }
        lines {
          text: "                Text("
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    text = \"\340\246\206\340\246\252\340\246\250\340\246\276\340\246\260 \340\246\254\340\247\215\340\246\257\340\246\276\340\246\237\340\246\276\340\246\260\340\246\277\340\246\260 \340\246\270\340\247\207\340\246\262 \340\246\237\340\246\276\340\246\207\340\246\252 \340\246\250\340\246\277\340\246\260\340\247\215\340\246\254\340\246\276\340\246\232\340\246\250 \340\246\225\340\246\260\340\247\201\340\246\250\340\245\244 \340\246\217\340\246\237\340\246\277 \340\246\205\340\246\237\340\247\213\340\246\256\340\247\207\340\246\237\340\246\277\340\246\225 \340\246\270\340\246\276\340\246\207\340\246\225\340\247\207\340\246\262 \340\246\262\340\246\276\340\246\207\340\246\253 \340\246\250\340\246\277\340\246\260\340\247\215\340\246\247\340\246\276\340\246\260\340\246\243 \340\246\225\340\246\260\340\246\254\340\247\207\340\245\244\","
