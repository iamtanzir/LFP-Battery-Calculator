        }
        lines {
          text: "                        label = { Text(\"\340\246\241\340\246\277\340\246\234\340\246\276\340\246\207\340\246\250 \340\246\254\340\246\276 \340\246\252\340\247\215\340\246\257\340\246\276\340\246\225\340\247\207\340\246\260 \340\246\250\340\246\276\340\246\256\") },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
