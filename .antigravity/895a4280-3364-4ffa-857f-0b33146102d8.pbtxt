        }
        lines {
          text: "    // Current State Settings"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    var selectedCellChoice by mutableStateOf(cellChoices[5]) // Default to Prismatic 100Ah"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    var seriesCells by mutableStateOf(4) // 4S is default 12V"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    var parallelCells by mutableStateOf(1) // 1P"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    var depthOfDischargePercent by mutableStateOf(80.0) // 80% is standard DoD for cycle preservation"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    // Backup Requirement States"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    var targetBackupHours by mutableStateOf(4.0) // Target backup hours"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    var selectedGridType by mutableStateOf(\"offgrid\") // \"offgrid\", \"ongrid\", \"hybrid\""
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    // Map to keep quantities of selected appliances"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    val applianceQuantities = mutableStateMapOf<String, Int>().apply {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        // Initialize default quantities"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        standardAppliances.forEach { this[it.id] = 0 }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        this[\"light\"] = 4"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        this[\"fan\"] = 2"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        this[\"router\"] = 1"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    // Saved Configurations Flow from Local SQLite Room Database"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    val savedConfigs: StateFlow<List<BatteryConfig>> = repository.allConfigs"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        .stateIn("
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            scope = viewModelScope,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            started = SharingStarted.WhileSubscribed(5000),"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            initialValue = emptyList()"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        )"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    // Calculations (Derived State)"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "    // --- Computed Battery Metrics ---"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    val packNominalVoltage: Double"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        get() = seriesCells * cellVoltage"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "        get() = seriesCells * 3.2"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    val packCapacityAh: Double"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        get() = parallelCells * cellCapacityAh"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "        get() = parallelCells * selectedCellChoice.capacityAh"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    val totalWattHours: Double"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        get() = packNominalVoltage * packCapacityAh"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    val usableWattHours: Double"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        get() = totalWattHours * (depthOfDischargePercent / 100.0)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    val usableCapacityAh: Double"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        get() = packCapacityAh * (depthOfDischargePercent / 100.0)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    // Automatically calculate cycle life based on Cell Form, Capacity, and DoD settings"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    val cycleLifeEstimate: Int"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        get() = estimateCycleLife(depthOfDischargePercent)"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "    // Estimate cycle life curve of premium LFP chemistry"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "    private fun estimateCycleLife(dod: Double): Int {"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "        return when {"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "            dod >= 100.0 -> 2500"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "            dod >= 90.0 -> {"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "                val fraction = (100.0 - dod) / 10.0"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "                (2500 + fraction * 1000).toInt()"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "            }"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "            dod >= 80.0 -> {"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "                val fraction = (90.0 - dod) / 10.0"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "                (3500 + fraction * 1500).toInt()"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "            }"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "            dod >= 50.0 -> {"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "                val fraction = (80.0 - dod) / 30.0"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "                (5000 + fraction * 3000).toInt()"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "            }"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "            dod >= 20.0 -> {"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "                val fraction = (50.0 - dod) / 30.0"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "                (8000 + fraction * 4000).toInt()"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "            }"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "            else -> {"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "                val fraction = (20.0 - Math.max(0.0, dod)) / 20.0"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "                (12000 + fraction * 3000).toInt()"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "            }"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "        }"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "    }"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "    // Load custom presets"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "        get() {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            val base = selectedCellChoice.baseCycles"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            val dod = depthOfDischargePercent"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            // Curve equation representing degradation acceleration at higher DoD values"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            val multiplier = when {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                dod >= 100.0 -> 0.625"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                dod >= 90.0 -> 0.625 + (100.0 - dod) * 0.0175 // 90% DoD has ~80% cycle life"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                dod >= 80.0 -> 0.8 + (90.0 - dod) * 0.02 // 80% DoD has 100% cycle life"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                dod >= 50.0 -> 1.0 + (80.0 - dod) * 0.02 // 50% DoD has ~160% cycle life"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                dod >= 20.0 -> 1.6 + (50.0 - dod) * 0.03 // 20% DoD has ~250% cycle life"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                else -> 2.5 + (20.0 - Math.max(0.0, dod)) * 0.05"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            return (base * multiplier).roundToInt()"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    // --- Computed Appliance Loads & Demands ---"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    val totalRunningWatts: Double"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        get() {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            return standardAppliances.sumOf { appliance ->"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                val qty = applianceQuantities[appliance.id] ?: 0"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                appliance.nominalWatts * qty"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    val peakSurgeWatts: Double"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        get() {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            return standardAppliances.sumOf { appliance ->"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                val qty = applianceQuantities[appliance.id] ?: 0"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                appliance.nominalWatts * appliance.surgeMultiplier * qty"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    // Starting surge current in Amperes at the battery pack nominal voltage"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    val startingSurgeAmps: Double"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        get() {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            val volts = packNominalVoltage"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            return if (volts > 0) peakSurgeWatts / volts else 0.0"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    // Calculated continuous backup current in Amperes"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    val continuousRunningAmps: Double"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        get() {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            val volts = packNominalVoltage"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            return if (volts > 0) totalRunningWatts / volts else 0.0"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    // Calculated Energy target needed for the selected appliances over target backup hours (Wh)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    val targetRequiredEnergyWh: Double"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        get() = totalRunningWatts * targetBackupHours"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    // Target minimum battery capacity needed in Ampere hours (Ah) to sustain load safely"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    val targetRequiredCapacityAh: Double"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        get() {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
