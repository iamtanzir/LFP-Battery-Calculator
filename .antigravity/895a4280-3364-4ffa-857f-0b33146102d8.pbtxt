        lines {
          text: "        \"bn\" -> \"\340\247\251. \340\246\270\340\247\213\340\246\262\340\246\276\340\246\260 \340\246\252\340\247\215\340\246\257\340\246\276\340\246\250\340\247\207\340\246\262 \340\246\260\340\246\277\340\246\232\340\246\276\340\246\260\340\247\215\340\246\234 \340\246\227\340\246\276\340\246\207\340\246\241 (Solar Panel Sizing):\""
