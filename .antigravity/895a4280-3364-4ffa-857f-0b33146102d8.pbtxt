          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        Appliance(\"mobile\", \"Smart Phone Charger\", \"\340\246\256\340\247\213\340\246\254\340\246\276\340\246\207\340\246\262 \340\246\232\340\246\276\340\246\260\340\247\215\340\246\234\340\246\276\340\246\260\", 18.0, 1.0, \"smartphone\")"
