        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    HorizontalDivider(modifier = Modifier.padding(vertical = 8.dp))"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    // Status analysis compared with configured battery size"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    val batterySufficiency = viewModel.capacitySufficiencyStatus"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    val statusText = when (batterySufficiency) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                        \"OPTIMAL\" -> when (viewModel.appLanguage) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                            \"bn\" -> \"\340\246\205\340\246\244\340\246\277\340\246\260\340\246\277\340\246\225\340\247\215\340\246\244 \340\246\254\340\247\215\340\246\257\340\246\276\340\246\225\340\246\206\340\246\252 \340\246\247\340\246\276\340\246\260\340\246\243\340\246\225\340\247\215\340\246\267\340\246\256\340\246\244\340\246\276 \340\246\206\340\246\233\340\247\207! (Optimal & Safe)\""
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                            \"zh\" -> \"\346\234\211\345\205\205\350\266\263\347\232\204\345\244\207\344\273\275\345\256\271\351\207\217\357\274\201(\345\256\211\345\205\250\346\216\250\350\215\220)\""
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                            \"de\" -> \"Hervorragende Backup-Kapazit\303\244t! (Optimal)\""
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                            \"ko\" -> \"\354\227\254\354\234\240\353\241\234\354\232\264 \353\260\261\354\227\205 \354\232\251\353\237\211 \355\231\225\353\263\264! (\354\225\210\354\240\204 \353\260\217 \354\265\234\354\240\201)\""
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                            else -> \"Excellent Backup Capacity! (Optimal & Safe)\""
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                        }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                        \"SUFFICIENT\" -> when (viewModel.appLanguage) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                            \"bn\" -> \"\340\246\252\340\247\215\340\246\257\340\246\276\340\246\225 \340\246\247\340\246\276\340\246\260\340\246\243\340\246\225\340\247\215\340\246\267\340\246\256\340\246\244\340\246\276 \340\246\252\340\246\260\340\247\215\340\246\257\340\246\276\340\246\252\340\247\215\340\246\244! (Sufficient)\""
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                            \"zh\" -> \"\347\224\265\346\261\240\345\214\205\345\256\271\351\207\217\345\205\205\350\266\263\357\274\201(\345\205\205\350\266\263)\""
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                            \"de\" -> \"Pack-Kapazit\303\244t ist ausreichend! (Sufficient)\""
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                            \"ko\" -> \"\353\260\260\355\204\260\353\246\254 \355\214\251 \354\232\251\353\237\211\354\235\264 \354\266\251\353\266\204\355\225\251\353\213\210\353\213\244! (\354\266\251\353\266\204)\""
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                            else -> \"Pack Capacity is Sufficient! (Sufficient)\""
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                        }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                        \"LOW\" -> when (viewModel.appLanguage) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                            \"bn\" -> \"\340\246\254\340\247\215\340\246\257\340\246\276\340\246\237\340\246\276\340\246\260\340\246\277 \340\246\247\340\246\276\340\246\260\340\246\243\340\246\225\340\247\215\340\246\267\340\246\256\340\246\244\340\246\276 \340\246\225\340\246\256 (\340\246\254\340\247\215\340\246\257\340\246\276\340\246\225\340\246\206\340\246\252 \340\246\270\340\246\256\340\247\237 \340\246\225\340\246\256\340\247\207 \340\246\257\340\246\276\340\246\254\340\247\207)\""
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                            \"zh\" -> \"\347\224\265\346\261\240\345\256\271\351\207\217\350\276\203\344\275\216 (\345\244\207\344\273\275\346\227\266\351\227\264\345\260\206\347\274\251\347\237\255)\""
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                            \"de\" -> \"Geringe Akkukapazit\303\244t (Backupzeit verk\303\274rzt sich)\""
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                            \"ko\" -> \"\353\260\260\355\204\260\353\246\254 \354\232\251\353\237\211 \353\266\200\354\241\261 (\353\260\261\354\227\205 \354\213\234\352\260\204\354\235\264 \353\213\250\354\266\225\353\220\250)\""
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                            else -> \"Low battery capacity (backup time will be shorter)\""
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                        }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                        else -> when (viewModel.appLanguage) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                            \"bn\" -> \"\340\246\205\340\246\252\340\247\215\340\246\260\340\246\244\340\247\201\340\246\262 \340\246\254\340\247\215\340\246\257\340\246\276\340\246\237\340\246\276\340\246\260\340\246\277 \340\246\252\340\247\215\340\246\257\340\246\276\340\246\225! \340\246\252\340\246\260\340\247\215\340\246\257\340\246\276\340\246\252\340\247\215\340\246\244 \340\246\254\340\247\215\340\246\257\340\246\276\340\246\225\340\246\206\340\246\252 \340\246\252\340\246\276\340\246\254\340\247\207\340\246\250 \340\246\250\340\246\276\340\245\244\""
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                            \"zh\" -> \"\347\224\265\346\261\240\345\214\205\345\256\271\351\207\217\344\270\215\350\266\263\357\274\201\346\227\240\346\263\225\346\273\241\350\266\263\347\233\256\346\240\207\345\244\207\344\273\275\343\200\202\""
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                            \"de\" -> \"Ungen\303\274gende Akkukapazit\303\244t! Ziel wird nicht erreicht.\""
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                            \"ko\" -> \"\353\260\260\355\204\260\353\246\254 \354\232\251\353\237\211\354\235\264 \353\247\244\354\232\260 \353\266\200\354\241\261\355\225\251\353\213\210\353\213\244! \353\252\251\355\221\234\353\245\274 \353\213\254\354\204\261\355\225\240 \354\210\230 \354\227\206\354\212\265\353\213\210\353\213\244.\""
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                            else -> \"Insufficient battery pack! Won\'t meet target backup.\""
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                        }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    val statusColor = when (batterySufficiency) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                        \"OPTIMAL\" -> BatteryFull"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                        \"SUFFICIENT\" -> GreenPrimaryLight"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                        \"LOW\" -> BatteryHalf"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
