          text: "                            size = Size(mainBodyWidth, mainBodyHeight),"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                            cornerRadius = CornerRadius(10.dp.toPx(), 10.dp.toPx()),"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                            style = Stroke(width = strokeWidth)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                        )"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
