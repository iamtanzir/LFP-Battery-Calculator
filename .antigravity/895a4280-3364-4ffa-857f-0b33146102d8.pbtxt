        lines {
          text: "        \"zh\" -> \"\342\200\242 \345\234\2505\345\260\217\346\227\266\346\234\211\346\225\210\345\205\211\347\205\247\344\270\213\345\256\214\345\205\250\345\205\205\346\273\241\346\202\250\347\232\204 ${viewModel.totalWattHours.toInt()} Wh \347\224\265\346\261\240\357\274\214\350\207\263\345\260\221\351\234\200\350\246\201 ${viewModel.recommendedSolarWatts.roundToInt()} \347\223\246\347\211\271\347\232\204\345\244\252\351\230\263\350\203\275\347\224\265\346\261\240\346\235\277\343\200\202\""
