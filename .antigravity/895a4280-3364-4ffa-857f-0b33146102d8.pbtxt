    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "// TAB 3: Solar installation advisor guidelines & Bills of materials\n@Composable\nfun SolarGridGuideTab(viewModel: BatteryViewModel) {\n    val scrollState = rememberScrollState()\n\n    Column(\n        modifier = Modifier\n            .fillMaxSize()\n            .verticalScroll(scrollState)\n            .padding(12.dp),\n        verticalArrangement = Arrangement.spacedBy(14.dp)\n    ) {\n        // Grid Selector\n        Card(\n            modifier = Modifier.fillMaxWidth(),\n            colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.surface)\n        ) {\n            Column(modifier = Modifier.padding(16.dp)) {\n                Text(\n                    text = \"\340\246\270\340\247\213\340\246\262\340\246\276\340\246\260 \340\246\227\340\247\215\340\246\260\340\246\277\340\246\241 \340\246\205\340\246\252\340\246\266\340\246\250 \340\246\250\340\246\277\340\246\260\340\247\215\340\246\254\340\246\276\340\246\232\340\246\250 \340\246\225\340\246\260\340\247\201\340\246\250\",\n                    fontWeight = FontWeight.Bold,\n                    style = MaterialTheme.typography.titleMedium,\n                    color = MaterialTheme.colorScheme.primary\n                )\n                Text(\n                    text = \"\340\246\206\340\246\252\340\246\250\340\246\276\340\246\260 \340\246\254\340\246\276\340\246\270\340\246\276 \340\246\254\340\246\276 \340\246\252\340\247\215\340\246\260\340\246\234\340\247\207\340\246\225\340\247\215\340\246\237\340\247\207\340\246\260 \340\246\260\340\246\277\340\246\225\340\247\213\340\247\237\340\246\276\340\246\260\340\246\256\340\247\207\340\246\250\340\247\215\340\246\237 \340\246\205\340\246\250\340\247\201\340\246\257\340\246\276\340\247\237\340\247\200 \340\246\205\340\246\250-\340\246\227\340\247\215\340\246\260\340\246\277\340\246\241, \340\246\205\340\246\253-\340\246\227\340\247\215\340\246\260\340\246\277\340\246\241 \340\246\254\340\246\276 \340\246\271\340\246\276\340\246\207\340\246\254\340\247\215\340\246\260\340\246\277\340\246\241 \340\246\250\340\246\277\340\246\260\340\247\215\340\246\254\340\246\276\340\246\232\340\246\250 \340\246\225\340\246\260\340\247\201\340\246\250\340\245\244\",\n                    style = MaterialTheme.typography.bodySmall,\n                    color = MaterialTheme.colorScheme.onSurfaceVariant,\n                    modifier = Modifier.padding(bottom = 12.dp)\n                )\n\n                Row(\n                    modifier = Modifier.fillMaxWidth(),\n                    horizontalArrangement = Arrangement.spacedBy(8.dp)\n                ) {\n                    val gridTypes = listOf(\n                        \"offgrid\" to \"\340\246\205\340\246\253-\340\246\227\340\247\215\340\246\260\340\246\277\340\246\241 (Off-Grid)\",\n                        \"ongrid\" to \"\340\246\205\340\246\250-\340\246\227\340\247\215\340\246\260\340\246\277\340\246\241 (On-Grid)\",\n                        \"hybrid\" to \"\340\246\271\340\246\276\340\246\207\340\246\254\340\247\215\340\246\260\340\246\277\340\246\241 (Hybrid)\"\n                    )\n                    gridTypes.forEach { (type, label) ->\n                        val selected = viewModel.selectedGridType == type\n                        ElevatedFilterChip(\n                            selected = selected,\n                            onClick = { viewModel.selectedGridType = type },\n                            label = { Text(label, fontSize = 11.sp, fontWeight = FontWeight.Bold) },\n                            modifier = Modifier.weight(1f)\n                        )\n                    }\n                }\n            }\n        }\n\n        // Dynamic guidelines based on selection\n        Card(\n            modifier = Modifier.fillMaxWidth(),\n            colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.surface)\n        ) {\n            Column(modifier = Modifier.padding(16.dp)) {\n                when (viewModel.selectedGridType) {\n                    \"offgrid\" -> {\n                        Text(\n                            text = \"\360\237\224\213 \340\246\205\340\246\253-\340\246\227\340\247\215\340\246\260\340\246\277\340\246\241 \340\246\270\340\246\277\340\246\270\340\247\215\340\246\237\340\247\207\340\246\256 \340\246\227\340\246\276\340\246\207\340\246\241\340\246\262\340\246\276\340\246\207\340\246\250 (Off-Grid System)\",\n                            fontWeight = FontWeight.Bold,\n                            style = MaterialTheme.typography.titleMedium,\n                            color = MaterialTheme.colorScheme.primary\n                        )\n                        Spacer(modifier = Modifier.height(8.dp))\n                        Text(\n                            text = \"\340\246\205\340\246\253-\340\246\227\340\247\215\340\246\260\340\246\277\340\246\241 \340\246\270\340\247\213\340\246\262\340\246\276\340\246\260 \340\246\270\340\246\277\340\246\270\340\247\215\340\246\237\340\247\207\340\246\256 \340\246\227\340\247\215\340\246\260\340\246\277\340\246\241 \340\246\254\340\246\276 \340\246\234\340\246\276\340\246\244\340\247\200\340\247\237 \340\246\254\340\246\277\340\246\246\340\247\215\340\246\257\340\247\201\340\247\216 \340\246\262\340\246\276\340\246\207\340\246\250\340\247\207\340\246\260 \340\246\270\340\246\276\340\246\245\340\247\207 \340\246\257\340\247\201\340\246\225\340\247\215\340\246\244 \340\246\245\340\246\276\340\246\225\340\247\207 \340\246\250\340\246\276\340\245\244 \340\246\217\340\246\237\340\246\277 \340\246\270\340\246\256\340\247\215\340\246\252\340\247\202\340\246\260\340\247\215\340\246\243 \340\246\270\340\247\215\340\246\254\340\247\237\340\246\202\340\246\270\340\246\256\340\247\215\340\246\252\340\247\202\340\246\260\340\247\215\340\246\243\340\245\244 \340\246\246\340\246\277\340\246\250\340\247\207 \340\246\270\340\247\213\340\246\262\340\246\276\340\246\260 \340\246\223 \340\246\260\340\246\2