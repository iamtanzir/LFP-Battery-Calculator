  file_change {
    absolute_path_uri: "file:///app/src/main/java/com/example/ui/BatteryCalculatorScreen.kt"
    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "// Helpers\nfun borderStroke(width: androidx.compose.ui.unit.Dp, color: Color) =\n    androidx.compose.foundation.BorderStroke(width, color)\n\nprivate fun Double.format(digits: Int): String = String.format(Locale.getDefault(), \"%.${digits}f\", this)\n\n\n// TAB 4: Saved Systems History Tab\n@Composable\nfun SavedSystemsTab(\n    savedConfigs: List<BatteryConfig>,\n    lang: String,\n    onLoadConfig: (BatteryConfig) -> Unit,\n    onDeleteConfig: (Int) -> Unit\n) {\n    val t = { key: String -> BatteryLocalizer.get(key, lang) }\n    val usableLabel = when (lang) {\n        \"bn\" -> \"\340\246\254\340\247\215\340\246\257\340\246\254\340\246\271\340\246\276\340\246\260\340\246\257\340\247\213\340\246\227\340\247\215\340\246\257\"\n        \"zh\" -> \"\345\217\257\347\224\250\350\203\275\351\207\217\"\n        \"de\" -> \"Nutzbar\"\n        \"ko\" -> \"\352\260\200\354\232\251 \354\227\220\353\204\210\354\247\200\"\n        else -> \"Usable\"\n    }\n\n    if (savedConfigs.isEmpty()) {\n        Box(\n            modifier = Modifier\n                .fillMaxSize()\n                .padding(32.dp),\n            contentAlignment = Alignment.Center\n        ) {\n            Column(\n                horizontalAlignment = Alignment.CenterHorizontally,\n                verticalArrangement = Arrangement.Center\n            ) {\n                Icon(\n                    imageVector = Icons.Default.History,\n                    contentDescription = null,\n                    modifier = Modifier.size(64.dp),\n                    tint = MaterialTheme.colorScheme.onSurfaceVariant.copy(alpha = 0.4f)\n                )\n                Spacer(modifier = Modifier.height(12.dp))\n                Text(\n                    text = t(\"no_saved\"),\n                    fontWeight = FontWeight.Bold,\n                    style = MaterialTheme.typography.titleMedium,\n                    color = MaterialTheme.colorScheme.onSurfaceVariant\n                )\n                Text(\n                    text = t(\"no_saved_desc\"),\n                    style = MaterialTheme.typography.bodySmall,\n                    textAlign = TextAlign.Center,\n                    color = MaterialTheme.colorScheme.onSurfaceVariant.copy(alpha = 0.7f),\n                    modifier = Modifier.padding(top = 4.dp)\n                )\n            }\n        }\n    } else {\n        LazyColumn(\n            modifier = Modifier\n                .fillMaxSize()\n                .padding(horizontal = 16.dp),\n            verticalArrangement = Arrangement.spacedBy(10.dp)\n        ) {\n            item {\n                Text(\n                    text = t(\"saved_designs_title\"),\n                    style = MaterialTheme.typography.titleMedium,\n                    fontWeight = FontWeight.Bold,\n                    color = MaterialTheme.colorScheme.primary,\n                    modifier = Modifier.padding(vertical = 8.dp)\n                )\n            }\n\n            items(savedConfigs, key = { it.id }) { config ->\n                val nominalV = config.seriesCells * 3.2\n                val totalKwh = (nominalV * config.cellCapacityAh) / 1000.0\n                val usableKwh = totalKwh * (config.depthOfDischargePercent / 100.0)\n\n                Card(\n                    modifier = Modifier\n                        .fillMaxWidth()\n                        .clickable { onLoadConfig(config) }\n                        .testTag(\"saved_config_item_${config.id}\"),\n                    colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.surface)\n                ) {\n                    Row(\n                        modifier = Modifier\n                            .fillMaxWidth()\n                            .padding(16.dp),\n                        verticalAlignment = Alignment.CenterVertically,\n                        horizontalArrangement = Arrangement.SpaceBetween\n                    ) {\n                        Column(modifier = Modifier.weight(1f)) {\n                            Text(\n                                text = config.name,\n                                fontWeight = FontWeight.Bold,\n                                style = MaterialTheme.typography.bodyLarge,\n                                color = MaterialTheme.colorScheme.onSurface\n                            )\n                            Spacer(modifier = Modifier.height(4.dp))\n                            Text(\n                                text = \"${config.seriesCells}S ${config.parallelCells}P \342\200\242 ${nominalV.format(1)}V \342\200\242 ${config.cellCapacityAh.toInt()}Ah Rated\",\n                                style = MaterialTheme.typography.bodySmall,\n                                color = MaterialTheme.colorScheme.onSurfaceVariant\n                            )\n                            Text(\n                                text = \"$usableLabel: ${usableKwh.format(2)} kWh (${config.depthOfDischargePercent.roundToInt()}% DoD)\",\n                                style = MaterialTheme.typography.bodySmall,\n                                color = MaterialTheme.colorScheme.primary,\n                                fontWeight = FontWeight.SemiBold\n                            )\n                        }\n\n                        IconButton(\n                            onClick = { onDeleteConfig(config.id) },\n                            modifier = Modifier.testTag(\"delete_config_${config.id}\")\n                        ) {\n                            Icon(\n                                imageVector = Icons.Default.Delete,\n                                contentDescription = t(\"delete_btn\"),\n                                tint = MaterialTheme.colorScheme.error.copy(alpha = 0.8f)\n                            )\n                        }\n                    }\n                }\n            }\n        }\n    }\n}"
      replacement_content: "// Helpers\nfun borderStroke(width: androidx.compose.ui.unit.Dp, color: Color) =\n    androidx.compose.foundation.BorderStroke(width, color)\n\nprivate fun Double.format(digits: Int): String = String.format(Locale.getDefault(), \"%.${digits}f\", this)\n\n\n@Composable\nfun DeveloperCopyrightSection() {\n    Card(\n        modifier = Modifier\n            .fillMaxWidth()\n            .padding(vertical = 16.dp),\n        colors = CardDefaults.cardColors(\n            containerColor = MaterialTheme.colorScheme.surfaceVariant.copy(alpha = 0.5f)\n        ),\n        border = androidx.compose.foundation.BorderStroke(1.dp, MaterialTheme.colorScheme.outline.copy(alpha = 0.2f))\n    ) {\n        Column(\n            modifier = Modifier.padding(16.dp),\n            horizontalAlignment = Alignment.CenterHorizontally\n        ) {\n            Row(\n                verticalAlignment = Alignment.CenterVertically,\n                horizontalArrangement = Arrangement.Center,\n                modifier = Modifier.fillMaxWidth()\n            ) {\n                Icon(\n                    imageVector = Icons.Default.Verified,\n                    contentDescription = \"Verified Owner\",\n                    tint = Color(0xFF4CAF50),\n                    modifier = Modifier.size(20.dp)\n                )\n                Spacer(modifier = Modifier.width(6.dp))\n                Text(\n                    text = \"\340\246\206\340\246\207\340\246\250\340\246\227\340\246\244 \340\246\270\340\246\244\340\246\260\340\247\215\340\246\225\340\246\254\340\246\276\340\246\260\340\247\215\340\246\244\340\246\276 \340\246\223 \340\246\225\340\246\252\340\246\277\340\246\260\340\246\276\340\246\207\340\246\237 \340\246\205\340\246\247\340\246\277\340\246\225\340\246\276\340\246\260\",\n                    fontWeight = FontWeight.Bold,\n                    style = MaterialTheme.typography.titleSmall,\n                    color = MaterialTheme.colorScheme.onSurfaceVariant,\n                    textAlign = TextAlign.Center\n                )\n            }\n            \n            Spacer(modifier = Modifier.height(8.dp))\n            \n            Text(\n                text = \"Developer & Owner: Tanzir Ahmed\",\n                fontWeight = FontWeight.Bold,\n                style = MaterialTheme.typography.bodyMedium,\n                color = MaterialTheme.colorScheme.primary,\n                textAlign = TextAlign.Center\n            )\n            \n            Text(\n                text = \"https://github.com/iamtanzir\",\n                style = MaterialTheme.typography.bodySmall,\n                color = MaterialTheme.colorScheme.secondary,\n                textAlign = TextAlign.Center,\n                modifier = Modifier.padding(bottom = 8.dp)\n            )\n            \n            Spacer(\n                modifier = Modifier\n                    .fillMaxWidth()\n                    .height(1.dp)\n                    .background(MaterialTheme.colorScheme.outline.copy(alpha = 0.15f))\n                    .padding(vertical = 8.dp)\n            )\n            \n            Text(\n                text = \"\340\246\217\340\246\207 \340\246\270\340\246\276\340\246\207\340\246\237, \340\246\241\340\246\277\340\246\234\340\246\276\340\246\207\340\246\250 \340\246\223 \340\246\225\340\246\250\340\247\215\340\246\237\340\247\215\340\246\260\340\247\213\340\246\262 \340\246\270\340\246\277\340\246\270\340\247\215\340\246\237\340\247\207\340\246\256\340\247\207\340\246\260 \340\246\225\340\247\213\340\246\250\340\247\213 \340\246\205\340\246\202\340\246\266 \340\246\205\340\246\250\340\247\201\340\246\256\340\246\244\340\246\277 \340\246\233\340\246\276\340\247\234\340\246\276 \340\246\225\340\247\215\340\246\262\340\247\213\340\246\250 \340\246\254\340\246\276 \340\246\250\340\246\225\340\246\262 \340\246\225\340\246\260\340\246\276 \340\246\270\340\246\256\340\247\215\340\246\252\340\247\202\340\246\260\340\247\215\340\246\243 \340\246\254\340\247\207\340\246\206\340\246\207\340\246\250\340\246\277\340\245\244 \340\246\252\340\246\276\340\246\207\340\246\260\340\247\207\340\246\270\340\246\277 \340\246\225\340\246\260\340\246\276 \340\246\271\340\246\262\340\247\207 \340\246\270\340\246\276\340\246\207\340\246\254\340\246\276\340\246\260 \340\246\270\340\247\201\340\246\260\340\246\225\340\247\215\340\246\267\340\246\276 \340\246\206\340\246\207\340\246\250 \340\246\223 \340\246\225\340\246\252\340\246\277\340\246\260\340\246\276\340\246\207\340\246\237 \340\246\206\340\246\207\340\246\250\340\247\207\340\246\260 \340\246\205\340\246\247\340\247\200\340\246\250\340\247\207 \340\246\206\340\246\207\340\246\250\340\246\277 \340\246\254\340\247\215\340\246\257\340\246\254\340\246\270\340\247\215\340\246\245\340\246\276 \340\246\250\340\247\207\340\247\237\340\246\276 \340\246\271\340\246\254\340\247\207\340\245\244\",\n                style = MaterialTheme.typography.bodySmall,\n                color = MaterialTheme.colorScheme.onSurfaceVariant.copy(alpha = 0.85f),\n                textAlign = TextAlign.Center,\n                lineHeight = 18.sp,\n                modifier = Modifier.padding(bottom = 8.dp, top = 8.dp)\n            )\n            \n            Text(\n                text = \"Unauthorized cloning or replication will face direct legal action under Cyber Security & Copyright Laws of BD.\",\n                style = MaterialTheme.typography.labelSmall,\n                color = MaterialTheme.colorScheme.error,\n                textAlign = TextAlign.Center,\n                lineHeight = 14.sp,\n                fontWeight = FontWeight.SemiBold\n            )\n        }\n    }\n}\n\n\n// TAB 4: Saved Systems History Tab\n@Composable\nfun SavedSystemsTab(\n    savedConfigs: List<BatteryConfig>,\n    lang: String,\n    onLoadConfig: (BatteryConfig) -> Unit,\n    onDeleteConfig: (Int) -> Unit\n) {\n    val t = { key: String -> BatteryLocalizer.get(key, lang) }\n    val usableLabel = when (lang) {\n        \"bn\" -> \"\340\246\254\340\247\215\340\246\257\340\246\254\340\246\271\340\246\276\340\246\260\340\246\257\340\247\213\340\246\227\340\247\215\340\246\257\"\n        \"zh\" -> \"\345\217\257\347\224\250\350\203\275\351\207\217\"\n        \"de\" -> \"Nutzbar\"\n        \"ko\" -> \"\352\260\200\354\232\251 \354\227\220\353\204\210\354\247\200\"\n        else -> \"Usable\"\n    }\n\n    LazyColumn(\n        modifier = Modifier\n            .fillMaxSize()\n            .padding(horizontal = 16.dp),\n        verticalArrangement = Arrangement.spacedBy(10.dp)\n    ) {\n        if (savedConfigs.isEmpty()) {\n            item {\n                Column(\n                    modifier = Modifier\n                        .fillMaxWidth()\n                        .padding(vertical = 32.dp),\n                    horizontalAlignment = Alignment.CenterHorizontally,\n                    verticalArrangement = Arrangement.Center\n                ) {\n                    Icon(\n                        imageVector = Icons.Default.History,\n                        contentDescription = null,\n                        modifier = Modifier.size(64.dp),\n                        tint = MaterialTheme.colorScheme.onSurfaceVariant.copy(alpha = 0.4f)\n                    )\n                    Spacer(modifier = Modifier.height(12.dp))\n                    Text(\n                        text = t(\"no_saved\"),\n                        fontWeight = FontWeight.Bold,\n                        style = MaterialTheme.typography.titleMedium,\n                        color = MaterialTheme.colorScheme.onSurfaceVariant\n                    )\n                    Text(\n                        text = t(\"no_saved_desc\"),\n                        style = MaterialTheme.typography.bodySmall,\n                        textAlign = TextAlign.Center,\n                        color = MaterialTheme.colorScheme.onSurfaceVariant.copy(alpha = 0.7f),\n                        modifier = Modifier.padding(top = 4.dp)\n                    )\n                }\n            }\n        } else {\n            item {\n                Text(\n                    text = t(\"saved_designs_title\"),\n                    style = MaterialTheme.typography.titleMedium,\n                    fontWeight = FontWeight.Bold,\n                    color = MaterialTheme.colorScheme.primary,\n                    modifier = Modifier.padding(vertical = 8.dp)\n                )\n            }\n\n            items(savedConfigs, key = { it.id }) { config ->\n                val nominalV = config.seriesCells * 3.2\n                val totalKwh = (nominalV * config.cellCapacityAh) / 1000.0\n                val usableKwh = totalKwh * (config.depthOfDischargePercent / 100.0)\n\n                Card(\n                    modifier = Modifier\n                        .fillMaxWidth()\n                        .clickable { onLoadConfig(config) }\n                        .testTag(\"saved_config_item_${config.id}\"),\n                    colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.surface)\n                ) {\n                    Row(\n                        modifier = Modifier\n                            .fillMaxWidth()\n                            .padding(16.dp),\n                        verticalAlignment = Alignment.CenterVertically,\n                        horizontalArrangement = Arrangement.SpaceBetween\n                    ) {\n                        Column(modifier = Modifier.weight(1f)) {\n                            Text(\n                                text = config.name,\n                                fontWeight = FontWeight.Bold,\n                                style = MaterialTheme.typography.bodyLarge,\n                                color = MaterialTheme.colorScheme.onSurface\n                            )\n                            Spacer(modifier = Modifier.height(4.dp))\n                            Text(\n                                text = \"${config.seriesCells}S ${config.parallelCells}P \342\200\242 ${nominalV.format(1)}V \342\200\242 ${config.cellCapacityAh.toInt()}Ah Rated\",\n                                style = MaterialTheme.typography.bodySmall,\n                                color = MaterialTheme.colorScheme.onSurfaceVariant\n                            )\n                            Text(\n                                text = \"$usableLabel: ${usableKwh.format(2)} kWh (${config.depthOfDischargePercent.roundToInt()}% DoD)\",\n                                style = MaterialTheme.typography.bodySmall,\n                                color = MaterialTheme.colorScheme.primary,\n                                fontWeight = FontWeight.SemiBold\n                            )\n                        }\n\n                        IconButton(\n                            onClick = { onDeleteConfig(config.id) },\n                            modifier = Modifier.testTag(\"delete_config_${config.id}\")\n                        ) {\n                            Icon(\n                                imageVector = Icons.Default.Delete,\n                                contentDescription = t(\"delete_btn\"),\n                                tint = MaterialTheme.colorScheme.error.copy(alpha = 0.8f)\n                            )\n                        }\n                    }\n                }\n            }\n        }\n\n        // Developer Copyright and Security Verification Banner\n        item {\n            DeveloperCopyrightSection()\n            Spacer(modifier = Modifier.height(24.dp))\n        }\n    }\n}"
    }
