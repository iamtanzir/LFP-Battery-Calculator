        lines {
          text: "        \"de\" -> \"On-Grid-Systeme arbeiten direkt mit Ihrem Stromnetz zusammen. \303\234bersch\303\274ssige Energie wird \303\274ber Net-Metering eingespeist.\""
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        \"ko\" -> \"\352\263\204\355\206\265\354\227\260\352\263\204\355\230\225 \354\213\234\354\212\244\355\205\234\354\235\200 \354\240\204\353\240\245\353\247\235\352\263\274 \354\227\260\353\217\231\355\225\230\354\227\254 \354\236\221\353\217\231\355\225\251\353\213\210\353\213\244. \353\202\256 \353\217\231\354\225\210 \354\203\235\354\202\260\353\220\234 \354\227\254\353\266\204\354\235\230 \354\240\204\352\270\260\353\212\224 \352\263\204\355\206\265\354\204\240\354\234\274\353\241\234 \354\227\255\354\206\241\354\266\234\353\220\251\353\213\210\353\213\244.\""
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        else -> \"On-grid systems operate in direct sync with the utility provider. Extra solar electricity generated during day is exported back via net-metering.\""
