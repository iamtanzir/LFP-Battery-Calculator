        }
        lines {
          text: "    val scrollState = rememberScrollState()"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    val t = { key: String -> BatteryLocalizer.get(key, viewModel.appLanguage) }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    val baseLifeLabel = when (viewModel.appLanguage) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        \"bn\" -> \"\340\246\254\340\247\207\340\246\270 \340\246\262\340\246\276\340\246\207\340\246\253\""
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        \"zh\" -> \"\345\237\272\347\241\200\345\257\277\345\221\275\""
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
