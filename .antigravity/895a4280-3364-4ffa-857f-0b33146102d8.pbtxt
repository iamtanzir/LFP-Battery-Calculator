          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                ) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                    val presets = listOf("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                        4 to \"12V (4S)\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                        8 to \"24V (8S)\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                        12 to \"36V (12S)\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                        16 to \"48V (16S)\""
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                    )"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                    presets.forEach { (sCount, label) ->"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                        val selected = viewModel.seriesCells == sCount"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                        SuggestionChip("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                            onClick = { viewModel.applySVoltPreset(sCount) },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                            label = { Text(label, style = MaterialTheme.typography.bodySmall) },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                            colors = SuggestionChipDefaults.suggestionChipColors("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                                containerColor = if (selected) MaterialTheme.colorScheme.primaryContainer else Color.Transparent,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                                labelColor = if (selected) MaterialTheme.colorScheme.onPrimaryContainer else MaterialTheme.colorScheme.onSurface"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                            ),"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                            modifier = Modifier.weight(1f)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                        )"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                    }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        // Parallel & Cell Capacity Section"
