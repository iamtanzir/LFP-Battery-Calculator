        }
        lines {
          text: "        soc >= 90.0 -> 3.26 + (soc - 90.0) * (3.30 - 3.26) / 5.0"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        soc >= 80.0 -> 3.24 + (soc - 80.0) * (3.26 - 3.24) / 10.0"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        soc >= 50.0 -> 3.20 + (soc - 50.0) * (3.24 - 3.20) / 30.0"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        soc >= 20.0 -> 3.15 + (soc - 20.0) * (3.20 - 3.15) / 30.0"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        soc >= 10.0 -> 3.05 + (soc - 10.0) * (3.15 - 3.05) / 10.0"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        soc >= 5.0 -> 2.85 + (soc - 5.0) * (3.05 - 2.85) / 5.0"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        soc >= 2.0 -> 2.60 + (soc - 2.0) * (2.85 - 2.60) / 3.0"
