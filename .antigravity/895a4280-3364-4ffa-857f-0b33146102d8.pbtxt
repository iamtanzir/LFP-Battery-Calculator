        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    Spacer(modifier = Modifier.height(12.dp))"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    Button("
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                        onClick = onProceedToSetup,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                        modifier = Modifier.fillMaxWidth(),"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                        colors = ButtonDefaults.buttonColors(containerColor = MaterialTheme.colorScheme.primary)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    ) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                        Text(\"\340\246\252\340\247\215\340\246\257\340\246\276\340\246\225 \340\246\225\340\247\215\340\246\257\340\246\276\340\246\262\340\246\225\340\247\201\340\246\262\340\247\207\340\246\237\340\246\260\340\247\207 \340\246\252\340\247\215\340\246\257\340\246\276\340\246\225 \340\246\241\340\246\277\340\246\234\340\246\276\340\246\207\340\246\250 \340\246\256\340\247\207\340\246\262\340\246\276\340\246\250\", fontWeight = FontWeight.Bold)"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
