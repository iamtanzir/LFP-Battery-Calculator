          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                        if (fillWidth > 0f) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                            drawRoundRect("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                                brush = brush,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                                topLeft = Offset(innerPadding, innerPadding),"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                                size = Size(fillWidth, fillHeight),"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                                cornerRadius = CornerRadius(8.dp.toPx(), 8.dp.toPx())"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                            )"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                        }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                        // Draw lines showing depth limits"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                        if (animatedLevel < 1f) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                            val limitX = innerPadding + fillWidth"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                            drawLine("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                                color = Color.Red.copy(alpha = 0.6f),"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                                start = Offset(limitX, innerPadding),"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                                end = Offset(limitX, innerPadding + fillHeight),"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                                strokeWidth = 2.dp.toPx()"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                            )"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                        }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                    }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
