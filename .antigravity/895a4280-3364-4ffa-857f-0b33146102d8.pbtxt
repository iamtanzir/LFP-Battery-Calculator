        lines {
          text: "                    OutlinedTextField("
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                        value = configNameInput,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
