verflow\nimport androidx.compose.ui.unit.dp\nimport androidx.compose.ui.unit.sp\nimport androidx.lifecycle.compose.collectAsStateWithLifecycle\nimport com.example.R\nimport com.example.data.BatteryConfig\nimport com.example.ui.theme.*\nimport java.util.Locale\nimport kotlin.math.roundToInt\n\n@OptIn(ExperimentalMaterial3Api::class)\n@Composable\nfun BatteryCalculatorScreen(\n    viewModel: BatteryViewModel,\n    modifier: Modifier = Modifier\n) {\n    val savedConfigs by viewModel.savedConfigs.collectAsStateWithLifecycle()\n    val focusManager = LocalFocusManager.current\n\n    // Local UI states\n    var activeTab by remember { mutableStateOf(0) } // 0: Devices & Load, 1: Battery Setup, 2: Solar Grid Guide, 3: Saved Packs\n    var showSaveDialog by remember { mutableStateOf(false) }\n    var configNameInput by remember { mutableStateOf(\"\") }\n\n    Scaffold(\n        topBar = {\n            CenterAlignedTopAppBar(\n                title = {\n                    Row(\n                        verticalAlignment = Alignment.CenterVertically,\n                        horizontalArrangement = Arrangement.Center\n                    ) {\n                        Icon(\n                            imageVector = Icons.Default.Eco,\n                            contentDescription = null,\n                            tint = BatteryFull,\n                            modifier = Modifier.size(26.dp)\n                        )\n                        Spacer(modifier = Modifier.width(8.dp))\n                        Text(\n                            text = \"LFP Energy Lab & Solar Hub\",\n                            fontWeight = FontWeight.ExtraBold,\n                            fontSize = 20.sp,\n                            color = MaterialTheme.colorScheme.onBackground\n                        )\n                    }\n                },\n                colors = TopAppBarDefaults.centerAlignedTopAppBarColors(\n                    containerColor = MaterialTheme.colorScheme.background\n                )\n            )\n        },\n        modifier = modifier\n            .fillMaxSize()\n            .windowInsetsPadding(WindowInsets.safeDrawing)\n    ) { innerPadding ->\n        Column(\n            modifier = Modifier\n                .padding(innerPadding)\n                .fillMaxSize()\n                .background(MaterialTheme.colorScheme.background)\n        ) {\n            // Dynamic Interactive Battery Gauge Header\n            val totalKwh = viewModel.totalWattHours / 1000.0\n            val usableKwh = viewModel.usableWattHours / 1000.0\n\n            BatteryVisualHeader(\n                seriesCells = viewModel.seriesCells,\n                parallelCells = viewModel.parallelCells,\n                totalCapacityAh = viewModel.packCapacityAh,\n                nominalVoltage = viewModel.packNominalVoltage,\n                totalKwh = totalKwh,\n                usableKwh = usableKwh,\n                dodPercent = viewModel.depthOfDischargePercent,\n                cycleLife = viewModel.cycleLifeEstimate,\n                cellName = viewModel.selectedCellChoice.modelName,\n                cellForm = viewModel.selectedCellChoice.form\n            )\n\n            // Multi-tab Navigation Bar\n            ScrollableTabRow(\n                selectedTabIndex = activeTab,\n                containerColor = MaterialTheme.colorScheme.background,\n                contentColor = MaterialTheme.colorScheme.primary,\n                edgePadding = 12.dp,\n                modifier = Modifier.fillMaxWidth()\n            ) {\n                Tab(\n                    selected = activeTab == 0,\n                    onClick = { activeTab = 0 },\n                    text = { Text(\"\340\247\247. \340\246\262\340\247\213\340\246\241 \340\246\270\340\246\277\340\246\262\340\247\207\340\246\225\340\246\266\340\246\250\", fontWeight = FontWeight.Bold) },\n                    icon = { Icon(Icons.Default.Bolt, contentDescription = null) }\n                )\n                Tab(\n                    selected = activeTab == 1,\n                    onClick = { activeTab = 1 },\n                    text = { Text(\"\340\247\250. \340\246\252\340\247\215\340\246\257\340\246\276\340\246\225 \340\246\225\340\247\215\340\246\257\340\246\276\340\246\262\340\246\225\340\247\201\340\246\262\340\247\207\340\246\237\340\246\260\", fontWeight = FontWeight.Bold) },\n                    icon = { Icon(Icons.Default.Settings, contentDescription = null) }\n                )\n                Tab(\n                    selected = activeTab == 2,\n                    onClick = { activeTab = 2 },\n                    text = { Text(\"\340\247\251. \340\246\227\340\247\215\340\246\260\340\246\277\340\246\241 \340\246\227\340\246\276\340\246\207\340\246\241 \340\246\223 \340\246\211\340\246\252\340\246\225\340\246\260\340\246\243\", fontWeight = FontWeight.Bold) },\n                    icon = { Icon(Icons.Default.SolarPower, contentDescription = null) }\n                )\n                Tab(\n                    selected = activeTab == 3,\n                    onClick = { activeTab = 3 },\n                    text = { Text(\"\340\247\252. \340\246\270\340\246\202\340\246\260\340\246\225\340\247\215\340\246\267\340\246\277\340\246\244 \340\246\241\340\246\277\340\246\234\340\246\276\340\246\207\340\246\250\", fontWeight = FontWeight.Bold) },\n                    icon = { Icon(Icons.Default.History, contentDescription = null) }\n                )\n            }\n\n            Spacer(modifier = Modifier.height(6.dp))\n\n            // Tab Contents\n            Box(\n                modifier = Modifier\n                    .weight(1f)\n                    .fillMaxWidth()\n            ) {\n                when (activeTab) {\n                    0 -> ApplianceSelectionTab(\n                        viewModel = viewModel,\n                        onProceedToSetup = { activeTab = 1 }\n                    )\n                    1 -> CalculatorConfigTab(\n                        viewModel = viewModel,\n                        onSaveClicked = {\n                            val formStr = if (viewModel.selectedCellChoice.form == LfpCellForm.CYLINDRICAL) \"Cyl\" else \"Pris\"\n                            configNameInput = \"${viewModel.seriesCells}S${viewModel.parallelCells}P (${formStr} ${viewModel.selectedCellChoice.capacityAh.roundToInt()}Ah)\"\n                            showSaveDialog = true\n                        }\n                    )\n                    2 -> SolarGridGuideTab(viewModel = viewModel)\n                    3 -> SavedSystemsTab(\n                        savedConfigs = savedConfigs,\n                        onLoadConfig = { config ->\n                            viewModel.loadConfig(config)\n                            activeTab = 1 // Switch back to calculator\n                        },\n                        onDeleteConfig = { id -> viewModel.deleteConfig(id) }\n                    )\n                }\n            }\n        }\n    }\n\n    // Save Configuration Dialog\n    if (showSaveDialog) {\n        AlertDialog(\n            onDismissRequest = { showSaveDialog = false },\n            title = { Text(\"\340\246\254\340\247\215\340\246\257\340\246\276\340\246\237\340\246\276\340\246\260\340\246\277 \340\246\241\340\246\277\340\246\234\340\246\276\340\246\207\340\246\250 \340\246\270\340\246\202\340\246\260\340\246\225\340\247\215\340\246\267\340\246\243 \340\246\225\340\246\260\340\247\201\340\246\250\", fontWeight = FontWeight.Bold) },\n            text = {\n                Column {\n                    Text(\n                        \"\340\246\206\340\246\252\340\246\250\340\246\276\340\246\260 \340\246\225\340\246\276\340\246\270\340\247\215\340\246\237\340\246\256 \340\246\241\340\246\277\340\246\234\340\246\276\340\246\207\340\246\250 \340\246\225\340\246\260\340\246\276 LFP \340\246\254\340\247\215\340\246\257\340\246\276\340\246\237\340\246\276\340\246\260\340\246\277 \340\246\252\340\247\215\340\246\257\340\246\276\340\246\225 \340\246\270\340\247\207\340\246\237\340\246\206\340\246\252\340\246\237\340\246\277 \340\246\250\340\246\276\340\246\256 \340\246\246\340\246\277\340\247\237\340\247\207 \340\246\270\340\247\207\340\246\255 \340\246\225\340\246\260\340\247\207 \340\246\260\340\246\276\340\246\226\340\247\201\340\246\250\340\245\244\",\n                        style = MaterialTheme.typography.bodyMedium,\n                        color = MaterialTheme.colorScheme.onSurfaceVariant\n                    )\n                    Spacer(modifier = Modifier.height(12.dp))\n                    OutlinedTextField(\n                        value = configNameInput,\n                        onValueChange = { configNameInput = it },\n                        label = { Text(\"\340\246\241\340\246\277\340\246\234\340\246\276\340\246\207\340\246\250 \340\246\254\340\246\276 \340\246\252\340\247\215\340\246\257\340\246\276\340\246\225\340\247\207\340\246\260 \340\246\250\340\246\276\340\246\256\") },\n                        singleLine = true,\n                        modifier = Modifier\n                            .fillMaxWidth()\n                            .testTag(\"config_name_input\"),\n                        keyboardOptions = KeyboardOptions(imeAction = ImeAction.Done),\n                        keyboardActions = KeyboardActions(onDone = { focusManager.clearFocus() })\n                    )\n                }\n            },\n            confirmButton = {\n                Button(\n                    onClick = {\n                        if (configNameInput.isNotBlank()) {\n                            viewModel.saveCurrentConfig(configNameInput)\n                            showSaveDialog = false\n                        }\n                    },\n                    modifier = Modifier.testTag(\"save_config_confirm\")\n                ) {\n                    Text(\"\340\246\270\340\246\202\340\246\260\340\246\225\340\247\215\340\246\267\340\246\243 \340\246\225\340\246\260\340\247\201\340\246\250\")\n                }\n            },\n            dismissButton = {\n                TextButton(onClick = { showSaveDialog = false }) {\n                    Text(\"\340\246\254\340\246\276\340\246\244\340\246\277\340\246\262\")\n                }\n            }\n        )\n    }\n}\n\n@Composable\nfun BatteryVisualHeader(\n    seriesCells: Int,\n    parallelCells: Int,\n    totalCapacityAh: Double,\n    nominalVoltage: Double,\n    totalKwh: Double,\n    usableKwh: Double,\n    dodPercent: Double,\n    cycleLife: Int,\n    cellName: String,\n    cellForm: LfpCellForm\n) {\n    Card(\n        modifier = Modifier\n            .fillMaxWidth()\n            .padding(horizontal = 12.dp, vertical = 6.dp),\n        colors = CardDefaults.cardColors(\n            containerColor = MaterialTheme.colorScheme.surfaceVariant.copy(alpha = 0.35f)\n        ),\n        shape = RoundedCornerShape(16.dp)\n    ) {\n        Column(\n            modifier = Modifier\n                .fillMaxWidth()\n                .padding(12.dp),\n            horizontalAlignment = Alignment.CenterHorizontally\n        ) {\n            Row(\n                modifier = Modifier.fillMaxWidth(),\n                horizontalArrangement = Arrangement.SpaceBetween,\n                verticalAlignment = Alignment.CenterVertically\n            ) {\n                // Info block\n                Column {\n                    Text(\n                        text = \"\340\246\252\340\247\215\340\246\257\340\246\276\340\246\225 \340\246\225\340\246\250\340\246\253\340\246\277\340\246\227\340\246\276\340\246\260\340\247\207\340\246\266\340\246\250\",\n                        style = MaterialTheme.typography.labelSmall,\n                        color = MaterialTheme.colorScheme.primary,\n                        fontWeight = FontWeight.Bold\n                    )\n                    Text(\n                        text = \"${seriesCells}S ${parallelCells}P LFP Pack\",\n                        style = MaterialTheme.typography.titleMedium,\n                        fontWeight = FontWeight.Bold,\n                        color = MaterialTheme.colorScheme.onSurface\n                    )\n                    Text(\n                        text = \"${nominalVoltage.format(1)} V | ${totalCapacityAh.roundToInt()} Ah Rated\",\n                        style = MaterialTheme.typography.bodySmall,\n                        color = MaterialTheme.colorScheme.onSurfaceVariant\n                    )\n                }\n\n                // Energy details\n                Column(horizontalAlignment = Alignment.End) {\n                    Text(\n                        text = \"\340\246\206\340\247\237\340\247\201\340\246\267\340\247\215\340\246\225\340\246\276\340\246\262 (CYCLE LIFE)\",\n                        style = MaterialTheme.typography.labelSmall,\n                        color = MaterialTheme.colorScheme.onSurfaceVariant,\n                        fontWeight = FontWeight.Bold\n                    )\n                    Text(\n                        text = \"~$cycleLife \340\246\270\340\246\276\340\246\207\340\246\225\340\247\207\340\246\262\",\n                        style = MaterialTheme.typography.titleMedium,\n                        fontWeight = FontWeight.ExtraBold,\n                        color = if (dodPercent <= 80.0) BatteryFull else BatteryHalf\n                    )\n                    Text(\n                        text = \"${dodPercent.roundToInt()}% DoD \340\246\241\340\246\277\340\246\270\340\246\232\340\246\276\340\246\260\340\247\215\340\246\234\340\247\207\",\n                        style = MaterialTheme.typography.bodySmall,\n                        color = MaterialTheme.colorScheme.onSurfaceVariant\n                    )\n                }\n            }\n\n            Spacer(modifier = Modifier.height(10.dp))\n\n            // Battery Cylinder Custom Drawing representing the DoD Usable energy\n            Row(\n                modifier = Modifier\n                    .fillMaxWidth()\n                    .height(70.dp),\n                verticalAlignment = Alignment.CenterVertically,\n                horizontalArrangement = Arrangement.Center\n            ) {\n                Box(\n                    modifier = Modifier\n                        .fillMaxWidth()\n                        .height(60.dp),\n                    contentAlignment = Alignment.Center\n                ) {\n                    val level = dodPercent / 100.0\n                    val animatedLevel by animateFloatAsState(\n                        targetValue = level.toFloat(),\n                        animationSpec = tween(600),\n                        label = \"BatteryLevelGauge\"\n                    )\n\n                    Canvas(modifier = Modifier.fillMaxSize()) {\n                        val strokeWidth = 2.5.dp.toPx()\n                        val capWidth = 10.dp.toPx()\n                        val capHeight = 18.dp.toPx()\n\n                        val mainBodyWidth = size.width - capWidth - 6.dp.toPx()\n                        val mainBodyHeight = size.height\n\n                        // 1. Draw Battery Outer Border Container (Main Body)\n                        drawRoundRect(\n                            color = Color.LightGray.copy(alpha = 0.4f),\n                            size = Size(mainBodyWidth, mainBodyHeight),\n                            cornerRadius = CornerRadius(10.dp.toPx(), 10.dp.toPx()),\n                            style = Stroke(width = strokeWidth)\n                        )\n\n                        // 2. Draw Battery Positive Terminal Cap (Right Side)\n                        drawRoundRect(\n                            color = Color.LightGray.copy(alpha = 0.4f),\n                            topLeft = Offset(mainBodyWidth, (mainBodyHeight - capHeight) / 2),\n                            size = Size(capWidth, capHeight),\n                            cornerRadius = CornerRadius(3.dp.toPx(), 3.dp.toPx())\n                        )\n\n                        // 3. Draw Inner Fluid Fill representing the Configurable DoD Usable Energy\n                        val innerPadding = 5.dp.toPx()\n                        val maxFillWidth = mainBodyWidth - (innerPadding * 2)\n                        val fillHeight = mainBodyHeight - (innerPadding * 2)\n\n                        val fillWidth = maxFillWidth * animatedLevel\n\n                        val brush = Brush.linearGradient(\n                            colors = listOf(\n                                GreenPrimaryLight,\n                                BatteryFull\n                            )\n                        )\n\n                        if (fillWidth > 0f) {\n                            drawRoundRect(\n                                brush = brush,\n                                topLeft = Offset(innerPadding, innerPadding),\n                                size = Size(fillWidth, fillHeight),\n                                cornerRadius = CornerRadius(6.dp.toPx(), 6.dp.toPx())\n                            )\n                        }\n\n                        // Draw lines showing depth limits (DoD threshold marker)\n                        if (animatedLevel < 1f) {\n                            val limitX = innerPadding + fillWidth\n                            drawLine(\n                                color = Color.Red.copy(alpha = 0.7f),\n                                start = Offset(limitX, innerPadding),\n                                end = Offset(limitX, innerPadding + fillHeight),\n                                strokeWidth = 2.dp.toPx()\n                            )\n                        }\n                    }\n\n                    // Inside overlays showing energy metrics\n                    Row(\n                        modifier = Modifier\n                            .fillMaxSize()\n                            .padding(horizontal = 16.dp),\n                        verticalAlignment = Alignment.CenterVertically,\n                        horizontalArrangement = Arrangement.SpaceBetween\n                    ) {\n                        Column {\n                            Text(\n                                text = \"\340\246\254\340\247\215\340\246\257\340\246\254\340\246\271\340\246\276\340\246\260\340\246\257\340\247\213\340\246\227\340\247\215\340\246\257: ${usableKwh.format(2)} kWh\",\n                                style = MaterialTheme.typography.bodySmall,\n                                fontWeight = FontWeight.Bold,\n                                color = MaterialTheme.colorScheme.onSurface\n                            )\n                            Text(\n                                \"Usable Battery Capacity\",\n                                style = MaterialTheme.typography.labelSmall,\n                                color = MaterialTheme.colorScheme.onSurfaceVariant,\n                                fontSize = 10.sp\n                            )\n                        }\n\n                        Column(horizontalAlignment = Alignment.End) {\n                            Text(\n                                text = \"\340\246\256\340\247\213\340\246\237 \340\246\266\340\246\225\340\247\215\340\246\244\340\246\277: ${totalKwh.format(2)} kWh\",\n                                style = MaterialTheme.typography.bodySmall,\n                                fontWeight = FontWeight.Bold,\n                                color = MaterialTheme.colorScheme.onSurfaceVariant\n                            )\n                            Text(\n                                \"Total System Storage\",\n                                style = MaterialTheme.typography.labelSmall,\n                                color = MaterialTheme.colorScheme.onSurfaceVariant,\n                                fontSize = 10.sp\n                            )\n                        }\n                    }\n                }\n            }\n\n            Spacer(modifier = Modifier.height(4.dp))\n            Row(\n                modifier = Modifier.fillMaxWidth(),\n                horizontalArrangement = Arrangement.SpaceBetween\n            ) {\n                Text(\n                    text = \"\340\246\270\340\247\207\340\246\262 \340\246\256\340\246\241\340\247\207\340\246\262: $cellName\",\n                    style = MaterialTheme.typography.labelSmall,\n                    color = MaterialTheme.colorScheme.onSurfaceVariant\n                )\n                Text(\n                    text = \"\340\246\237\340\246\276\340\246\207\340\246\252: ${if (cellForm == LfpCellForm.CYLINDRICAL) \"\340\246\270\340\246\277\340\246\262\340\246\277\340\246\250\340\247\215\340\246\241\340\247\215\340\246\260\340\246\277\340\246\225\340\247\215\340\246\257\340\246\276\340\246\262 (Cylindrical)\" else \"\340\246\252\340\247\215\340\246\260\340\246\277\340\246\234\340\246\256\340\247\207\340\246\237\340\246\277\340\246\225 (Prismatic)\"}\",\n                    style = MaterialTheme.typography.labelSmall,\n                    color = MaterialTheme.colorScheme.primary\n                )\n            }\n        }\n    }\n}\n\n// TAB 1: Household Appliance selection and Load calculator\n@Composable\nfun ApplianceSelectionTab(\n    viewModel: BatteryViewModel,\n    onProceedToSetup: () -> Unit\n) {\n    val scrollState = rememberScrollState()\n\n    Column(\n        modifier = Modifier\n            .fillMaxSize()\n            .verticalScroll(scrollState)\n            .padding(12.dp),\n        verticalArrangement = Arrangement.spacedBy(12.dp)\n    ) {\n        // Bengali Subheader introducing the section\n        Card(\n            colors = CardDefaults.cardColors(\n                containerColor = MaterialTheme.colorScheme.primaryContainer.copy(alpha = 0.15f)\n            ),\n            modifier = Modifier.fillMaxWidth()\n        ) {\n            Column(modifier = Modifier.padding(12.dp)) {\n                Text(\n                    text = \"\340\246\254\340\246\276\340\246\270\340\246\276\340\247\237 \340\246\254\340\247\215\340\246\257\340\246\254\340\246\271\340\247\203\340\246\244 \340\246\262\340\247\213\340\246\241 \340\246\270\340\246\277\340\246\262\340\247\207\340\246\225\340\246\266\340\246\250 \340\246\225\340\246\260\340\247\201\340\246\250 \360\237\222\241\",\n                    fontWeight = FontWeight.Bold,\n                    style = MaterialTheme.typography.bodyLarge,\n                    color = MaterialTheme.colorScheme.primary\n                )\n                Text(\n                    text = \"\340\246\206\340\246\252\340\246\250\340\246\276\340\246\260 \340\246\254\340\246\276\340\247\234\340\246\277\340\246\244\340\247\207 \340\246\270\340\246\232\340\246\260\340\246\276\340\246\232\340\246\260 \340\246\254\340\247\215\340\246\257\340\246\254\340\246\271\340\247\203\340\246\244 \340\246\207\340\246\262\340\247\207\340\246\225\340\246\237\340\247\215\340\246\260\340\246\250\340\246\277\340\246\225 \340\246\270\340\246\276\340\246\256\340\246\227\340\247\215\340\246\260\340\247\200 \340\246\223 \340\246\252\340\247\215\340\246\260\340\247\237\340\247\213\340\246\234\340\246\250\340\247\200\340\247\237 \340\246\254\340\247\215\340\246\257\340\246\276\340\246\225\340\246\206\340\246\252\340\247\207\340\246\260 \340\246\270\340\246\256\340\247\237 \340\246\250\340\246\277\340\246\260\340\247\215\340\246\254\340\246\276\340\246\232\340\246\250 \340\246\225\340\246\260\340\247\201\340\246\250\340\245\244 \340\246\270\340\246\277\340\246\270\340\247\215\340\246\237\340\247\207\340\246\256 \340\246\205\340\246\237\340\247\213\340\246\256\340\247\207\340\246\237\340\246\277\340\246\225 \340\246\223\340\247\237\340\246\276\340\246\237, \340\246\252\340\246\277\340\246\225 \340\246\262\340\247\213\340\246\241 \340\246\223 \340\246\270\340\246\240\340\246\277\340\246\225 \340\246\225\340\247\215\340\246\257\340\246\276\340\246\254\340\246\262 \340\246\271\340\246\277\340\246\270\340\247\207\340\246\254 \340\246\225\340\246\260\340\246\254\340\247\207\340\245\244\",\n                    style = MaterialTheme.typography.bodySmall,\n                    color = MaterialTheme.colorScheme.onSurfaceVariant\n                )\n            }\n        }\n\n        // Global Target Backup Hours Card\n        Card(\n            modifier = Modifier.fillMaxWidth(),\n            colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.surface)\n        ) {\n            Column(modifier = Modifier.padding(16.dp)) {\n                Row(\n                    modifier = Modifier.fillMaxWidth(),\n                    horizontalArrangement = Arrangement.SpaceBetween,\n                    verticalAlignment = Alignment.CenterVertically\n                ) {\n                    Text(\n                        text = \"\340\246\254\340\247\215\340\246\257\340\246\276\340\246\225\340\246\206\340\246\252 \340\246\252\340\246\276\340\246\223\340\247\237\340\246\276\340\246\260\340\247\207\340\246\260 \340\246\237\340\246\276\340\246\260\340\247\215\340\246\227\340\247\207\340\246\237 \340\246\270\340\246\256\340\247\237\",\n                        fontWeight = FontWeight.Bold,\n                        style = MaterialTheme.typography.bodyLarge\n                    )\n                    Text(\n                        text = \"${viewModel.targetBackupHours.roundToInt()} \340\246\230\340\246\243\340\247\215\340\246\237\340\246\276\",\n                        fontWeight = FontWeight.ExtraBold,\n                        color = MaterialTheme.colorScheme.primary,\n                        style = MaterialTheme.typography.titleLarge\n                    )\n                }\n                Slider(\n                    value = viewModel.targetBackupHours.toFloat(),\n                    onValueChange = { viewModel.targetBackupHours = it.roundToInt().toDouble() },\n                    valueRange = 1f..24f,\n                    steps = 22,\n                    modifier = Modifier.fillMaxWidth()\n                )\n                Row(\n                    modifier = Modifier.fillMaxWidth(),\n                    horizontalArrangement = Arrangement.SpaceBetween\n                ) {\n                    Text(\"\340\247\247 \340\246\230\340\246\243\340\247\215\340\246\237\340\246\276\", style = MaterialTheme.typography.bodySmall, color = Color.Gray)\n                    Text(\"\340\247\247\340\247\250 \340\246\230\340\246\243\340\247\215\340\246\237\340\246\276\", style = MaterialTheme.typography.bodySmall, color = Color.Gray)\n                    Text(\"\340\247\250\340\247\252 \340\246\230\340\246\243\340\247\215\340\246\237\340\246\276\", style = MaterialTheme.typography.bodySmall, color = Color.Gray)\n                }\n            }\n        }\n\n        // List of household appliances with Counter Controls\n        Text(\n            text = \"\340\246\241\340\246\277\340\246\255\340\246\276\340\246\207\340\246\270 \340\246\244\340\246\276\340\246\262\340\246\277\340\246\225\340\246\276 \340\246\223 \340\246\270\340\246\202\340\246\226\340\247\215\340\246\257\340\246\276\",\n            fontWeight = FontWeight.Bold,\n            style = MaterialTheme.typography.titleMedium,\n            modifier = Modifier.padding(horizontal = 4.dp, vertical = 2.dp)\n        )\n\n        viewModel.standardAppliances.forEach { appliance ->\n            val quantity = viewModel.applianceQuantities[appliance.id] ?: 0\n\n            Card(\n                modifier = Modifier.fillMaxWidth(),\n                colors = CardDefaults.cardColors(\n                    containerColor = if (quantity > 0) MaterialTheme.colorScheme.primaryContainer.copy(alpha = 0.15f) else MaterialTheme.colorScheme.surface\n                ),\n                border = if (quantity > 0) borderStroke(1.dp, MaterialTheme.colorScheme.primary.copy(alpha = 0.3f)) else null\n            ) {\n                Row(\n                    modifier = Modifier\n                        .fillMaxWidth()\n                        .padding(12.dp),\n                    verticalAlignment = Alignment.CenterVertically,\n                    horizontalArrangement = Arrangement.SpaceBetween\n                ) {\n                    // Left side details\n                    Row(\n                        verticalAlignment = Alignment.CenterVertically,\n                        modifier = Modifier.weight(1f)\n                    ) {\n                        // Dynamic Material Icons\n                        val iconVector = when (appliance.iconName) {\n                            \"lightbulb\" -> Icons.Default.Lightbulb\n                            \"mode_fan\" -> Icons.Default.Air\n                            \"tv\" -> Icons.Default.Tv\n                            \"router\" -> Icons.Default.Router\n                            \"kitchen\" -> Icons.Default.Kitchen\n                            \"water\" -> Icons.Default.WaterDrop\n                            \"ac_unit\" -> Icons.Default.AcUnit\n                            \"laptop\" -> Icons.Default.Laptop\n                            \"microwave\" -> Icons.Default.SoupKitchen\n                            else -> Icons.Default.Smartphone\n                        }\n\n                        Surface(\n                            shape = RoundedCornerShape(8.dp),\n                            color = MaterialTheme.colorScheme.secondaryContainer.copy(alpha = 0.4f),\n                            modifier = Modifier.size(40.dp)\n                        ) {\n                            Box(contentAlignment = Alignment.Center) {\n                                Icon(\n                                    imageVector = iconVector,\n                                    contentDescription = null,\n                                    tint = MaterialTheme.colorScheme.primary,\n                                    modifier = Modifier.size(22.dp)\n                                )\n                            }\n                        }\n\n                        Spacer(modifier = Modifier.width(10.dp))\n\n                        Column {\n                            Text(\n                                text = appliance.nameBn,\n                                fontWeight = FontWeight.Bold,\n                                style = MaterialTheme.typography.bodyLarge\n                            )\n                            Text(\n                                text = \"${appliance.nominalWatts.toInt()} \340\246\223\340\246\257\340\246\274\340\246\276\340\246\237 \342\200\242 \340\246\270\340\247\215\340\246\237\340\246\276\340\246\260\340\247\215\340\246\237\340\246\206\340\246\252 \340\246\270\340\246\276\340\246\260\340\247\215\340\246\234: ${appliance.surgeMultiplier}x\",\n                                style = MaterialTheme.typography.bodySmall,\n                                color = MaterialTheme.colorScheme.onSurfaceVariant\n                            )\n                        }\n                    }\n\n                    // Right side counters\n                    Row(\n                        verticalAlignment = Alignment.CenterVertically,\n                        horizontalArrangement = Arrangement.spacedBy(8.dp)\n                    ) {\n                        IconButton(\n                            onClick = { viewModel.decrementAppliance(appliance.id) },\n                            colors = IconButtonDefaults.iconButtonColors(\n                                containerColor = MaterialTheme.colorScheme.surfaceVariant\n                            ),\n                            modifier = Modifier.size(32.dp)\n                        ) {\n                            Icon(Icons.Default.Remove, contentDescription = \"Decrement\", modifier = Modifier.size(16.dp))\n                        }\n\n                        Text(\n                            text = quantity.toString(),\n                            fontWeight = FontWeight.Bold,\n                            fontSize = 16.sp,\n                            modifier = Modifier.widthIn(min = 20.dp),\n                            textAlign = TextAlign.Center\n                        )\n\n                        IconButton(\n                            onClick = { viewModel.incrementAppliance(appliance.id) },\n                            colors = IconButtonDefaults.iconButtonColors(\n                                containerColor = MaterialTheme.colorScheme.primaryContainer\n                            ),\n                            modifier = Modifier.size(32.dp)\n                        ) {\n                            Icon(Icons.Default.Add, contentDescription = \"Increment\", modifier = Modifier.size(16.dp))\n                        }\n                    }\n                }\n            }\n        }\n\n        // Dynamic Calculations Results Panel\n        if (viewModel.totalRunningWatts > 0) {\n            Card(\n                colors = CardDefaults.cardColors(\n                    containerColor = MaterialTheme.colorScheme.surfaceVariant.copy(alpha = 0.5f)\n                ),\n                modifier = Modifier\n                    .fillMaxWidth()\n                    .padding(vertical = 4.dp),\n                shape = RoundedCornerShape(12.dp)\n            ) {\n                Column(modifier = Modifier.padding(16.dp)) {\n                    Text(\n                        text = \"\360\237\223\212 \340\246\262\340\247\213\340\246\241\340\247\207\340\246\260 \340\246\271\340\246\277\340\246\270\340\246\276\340\246\254 \340\246\223 \340\246\227\340\246\276\340\246\207\340\246\241\340\246\262\340\246\276\340\246\207\340\246\250 (Real-time Report)\",\n                        fontWeight = FontWeight.Bold,\n                        style = MaterialTheme.typography.titleMedium,\n                        color = MaterialTheme.colorScheme.primary\n                    )\n                    Spacer(modifier = Modifier.height(10.dp))\n\n                    Row(\n                        modifier = Modifier.fillMaxWidth(),\n                        horizontalArrangement = Arrangement.SpaceBetween\n                    ) {\n                        Text(\"\340\246\256\340\247\213\340\246\237 \340\246\232\340\246\262\340\246\256\340\246\276\340\246\250 \340\246\262\340\247\213\340\246\241:\", style = MaterialTheme.typography.bodyMedium)\n                        Text(\n                            \"${viewModel.totalRunningWatts.toInt()} Watts\",\n                            fontWeight = FontWeight.Bold,\n                            style = MaterialTheme.typography.bodyMedium\n                        )\n                    }\n\n                    Row(\n                        modifier = Modifier.fillMaxWidth(),\n                        horizontalArrangement = Arrangement.SpaceBetween,\n                        modifier = Modifier.padding(top = 4.dp)\n                    ) {\n                        Text(\"\340\246\252\340\246\277\340\246\225 \340\246\270\340\246\276\340\246\260\340\247\215\340\246\234 \340\246\262\340\247\213\340\246\241 (\340\247\247\340\247\246 \340\246\270\340\247\207\340\246\225\340\247\207\340\246\250\340\247\215\340\246\241):\", style = MaterialTheme.typography.bodyMedium)\n                        Text(\n                            \"${viewModel.peakSurgeWatts.toInt()} Watts\",\n                            fontWeight = FontWeight.Bold,\n                            color = Color(0xFFE64A19),\n                            style = MaterialTheme.typography.bodyMedium\n                        )\n                    }\n\n                    Row(\n                        modifier = Modifier.fillMaxWidth(),\n                        horizontalArrangement = Arrangement.SpaceBetween,\n                        modifier = Modifier.padding(top = 4.dp)\n                    ) {\n                        Text(\"\340\246\252\340\247\215\340\246\260\340\247\237\340\247\213\340\246\234\340\246\250\340\247\200\340\247\237 \340\246\266\340\246\225\340\247\215\340\246\244\340\246\277 (Wh):\", style = MaterialTheme.typography.bodyMedium)\n                        Text(\n                            \"${viewModel.targetRequiredEnergyWh.toInt()} Wh (${(viewModel.targetRequiredEnergyWh / 1000.0).format(2)} kWh)\",\n                            fontWeight = FontWeight.Bold,\n                            style = MaterialTheme.typography.bodyMedium\n                        )\n                    }\n\n                    HorizontalDivider(modifier = Modifier.padding(vertical = 8.dp))\n\n                    // Status analysis compared with configured battery size\n                    val batterySufficiency = viewModel.capacitySufficiencyStatus\n                    val statusText = when (batterySufficiency) {\n                        \"OPTIMAL\" -> \"\340\246\205\340\246\244\340\246\277\340\246\260\340\246\277\340\246\225\340\247\215\340\246\244 \340\246\254\340\247\215\340\246\257\340\246\276\340\246\225\340\246\206\340\246\252 \340\246\247\340\246\276\340\246\260\340\246\243\340\246\225\340\247\215\340\246\267\340\246\256\340\246\244\340\246\276 \340\246\206\340\246\233\340\247\207! (Optimal & Safe)\"\n                        \"SUFFICIENT\" -> \"\340\246\252\340\247\215\340\246\257\340\246\276\340\246\225 \340\246\247\340\246\276\340\246\260\340\246\243\340\246\225\340\247\215\340\246\267\340\246\256\340\246\244\340\246\276 \340\246\252\340\246\260\340\247\215\340\246\257\340\246\276\340\246\252\340\247\215\340\246\244! (Sufficient)\"\n                        \"LOW\" -> \"\340\246\254\340\247\215\340\246\257\340\246\276\340\246\237\340\246\276\340\246\260\340\246\277 \340\246\247\340\246\276\340\246\260\340\246\243\340\246\225\340\247\215\340\246\267\340\246\256\340\246\244\340\246\276 \340\246\225\340\246\256 (\340\246\254\340\247\215\340\246\257\340\246\276\340\246\225\340\246\206\340\246\252 \340\246\270\340\246\256\340\247\237 \340\246\225\340\246\256\340\247\207 \340\246\257\340\246\276\340\246\254\340\247\207)\"\n                        else -> \"\340\246\205\340\246\252\340\247\215\340\246\260\340\246\244\340\247\201\340\246\262 \340\246\254\340\247\215\340\246\257\340\246\276\340\246\237\340\246\276\340\246\260\340\246\277 \340\246\252\340\247\215\340\246\257\340\246\276\340\246\225! \340\246\252\340\246\260\340\247\215\340\246\257\340\246\276\340\246\252\340\247\215\340\246\244 \340\246\254\340\247\215\340\246\257\340\246\276\340\246\225\340\246\206\340\246\252 \340\246\252\340\246\276\340\246\254\340\247\207\340\246\250 \340\246\250\340\246\276\340\245\244\"\n                    }\n\n                    val statusColor = when (batterySufficiency) {\n                        \"OPTIMAL\" -> BatteryFull\n                        \"SUFFICIENT\" -> GreenPrimaryLight\n                        \"LOW\" -> BatteryHalf\n                        else -> BatteryLow\n                    }\n\n                    Row(\n                        modifier = Modifier.fillMaxWidth(),\n                        verticalAlignment = Alignment.CenterVertically\n                    ) {\n                        Icon(\n                            imageVector = if (batterySufficiency == \"OPTIMAL\" || batterySufficiency == \"SUFFICIENT\") Icons.Default.CheckCircle else Icons.Default.Warning,\n                            contentDescription = null,\n                            tint = statusColor,\n                            modifier = Modifier.size(20.dp)\n                        )\n                        Spacer(modifier = Modifier.width(6.dp))\n                        Text(\n                            text = statusText,\n                            fontWeight = FontWeight.Bold,\n                            color = statusColor,\n                            style = MaterialTheme.typography.bodySmall\n                        )\n                    }\n\n                    Spacer(modifier = Modifier.height(12.dp))\n\n                    Button(\n                        onClick = onProceedToSetup,\n                        modifier = Modifier.fillMaxWidth(),\n                        colors = ButtonDefaults.buttonColors(containerColor = MaterialTheme.colorScheme.primary)\n                    ) {\n                        Text(\"\340\246\252\340\247\215\340\246\257\340\246\276\340\246\225 \340\246\225\340\247\215\340\246\257\340\246\276\340\246\262\340\246\225\340\247\201\340\246\262\340\247\207\340\246\237\340\246\260\340\247\207 \340\246\252\340\247\215\340\246\257\340\246\276\340\246\225 \340\246\241\340\246\277\340\246\234\340\246\276\340\246\207\340\246\250 \340\246\256\340\247\207\340\246\262\340\246\276\340\246\250\", fontWeight = FontWeight.Bold)\n                        Spacer(modifier = Modifier.width(4.dp))\n                        Icon(Icons.Default.ArrowForward, contentDescription = null, modifier = Modifier.size(16.dp))\n                    }\n                }\n            }\n        }\n    }\n}\n\n// TAB 2: Configurable LFP battery cells & pack details calculator\n@Composable\nfun CalculatorConfigTab(\n    viewModel: BatteryViewModel,\n    onSaveClicked: () -> Unit\n) {\n    val scrollState = rememberScrollState()\n\n    Column(\n        modifier = Modifier\n            .fillMaxSize()\n            .verticalScroll(scrollState)\n            .padding(12.dp),\n        verticalArrangement = Arrangement.spacedBy(14.dp)\n    ) {\n        // Cell choice section (From 15Ah to 314Ah)\n        Card(\n            modifier = Modifier.fillMaxWidth(),\n            colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.surface)\n        ) {\n            Column(modifier = Modifier.padding(16.dp)) {\n                Text(\n                    text = \"LFP \340\246\270\340\247\207\340\246\262 \340\246\270\340\246\277\340\246\262\340\247\207\340\246\225\340\246\266\340\246\250 (15Ah - 314Ah)\",\n                    fontWeight = FontWeight.Bold,\n                    style = MaterialTheme.typography.titleMedium,\n                    color = MaterialTheme.colorScheme.primary\n                )\n                Text(\n                    text = \"\340\246\206\340\246\252\340\246\250\340\246\276\340\246\260 \340\246\254\340\247\215\340\246\257\340\246\276\340\246\237\340\246\276\340\246\260\340\246\277\340\246\260 \340\246\270\340\247\207\340\246\262 \340\246\237\340\246\276\340\246\207\340\246\252 \340\246\250\340\246\277\340\246\260\340\247\215\340\246\254\340\246\276\340\246\232\340\246\250 \340\246\225\340\246\260\340\247\201\340\246\250\340\245\244 \340\246\217\340\246\237\340\246\277 \340\246\205\340\246\237\340\247\213\340\246\256\340\247\207\340\246\237\340\246\277\340\246\225 \340\246\270\340\246\276\340\246\207\340\246\225\340\247\207\340\246\262 \340\246\262\340\246\276\340\246\207\340\246\253 \340\246\250\340\246\277\340\246\260\340\247\215\340\246\247\340\246\276\340\246\260\340\246\243 \340\246\225\340\246\260\340\246\254\340\247\207\340\245\244\",\n                    style = MaterialTheme.typography.bodySmall,\n                    color = MaterialTheme.colorScheme.onSurfaceVariant,\n                    modifier = Modifier.padding(bottom = 12.dp)\n                )\n\n                // Grid selection of Cell choices\n                Column(verticalArrangement = Arrangement.spacedBy(8.dp)) {\n                    viewModel.cellChoices.forEach { choice ->\n                        val selected = viewModel.selectedCellChoice.id == choice.id\n                        val cardBg = if (selected) MaterialTheme.colorScheme.primaryContainer.copy(alpha = 0.25f) else MaterialTheme.colorScheme.surfaceVariant.copy(alpha = 0.2f)\n                        val border = if (selected) borderStroke(1.5.dp, MaterialTheme.colorScheme.primary) else borderStroke(0.5.dp, Color.LightGray.copy(alpha = 0.5f))\n\n                        Row(\n                            modifier = Modifier\n                                .fillMaxWidth()\n                                .clip(RoundedCornerShape(8.dp))\n                                .background(cardBg)\n                                .border(border, RoundedCornerShape(8.dp))\n                                .clickable { viewModel.applyCellChoice(choice.id) }\n                                .padding(12.dp),\n                            horizontalArrangement = Arrangement.SpaceBetween,\n                            verticalAlignment = Alignment.CenterVertically\n                        ) {\n                            Row(verticalAlignment = Alignment.CenterVertically) {\n                                RadioButton(\n                                    selected = selected,\n                                    onClick = { viewModel.applyCellChoice(choice.id) }\n                                )\n                                Spacer(modifier = Modifier.width(4.dp))\n                                Column {\n                                    Text(\n                                        text = choice.modelName,\n                                        fontWeight = FontWeight.Bold,\n                                        style = MaterialTheme.typography.bodyMedium\n                                    )\n                                    Text(\n                                        text = \"\340\246\254\340\247\207\340\246\270 \340\246\262\340\246\276\340\246\207\340\246\253: ${choice.baseCycles} \340\246\270\340\246\276\340\246\207\340\246\225\340\247\207\340\246\262 \342\200\242 \340\246\253\340\246\260\340\247\215\340\246\256: ${if (choice.form == LfpCellForm.CYLINDRICAL) \"Cylindrical\" else \"Prismatic\"}\",\n                                        style = MaterialTheme.typography.labelSmall,\n                                        color = MaterialTheme.colorScheme.onSurfaceVariant\n                                    )\n                                }\n                            }\n\n                            Text(\n                                text = \"${choice.capacityAh.toInt()} Ah\",\n                                fontWeight = FontWeight.Bold,\n                                color = MaterialTheme.colorScheme.primary,\n                                style = MaterialTheme.typography.bodyMedium\n                            )\n                        }\n                    }\n                }\n            }\n        }\n\n        // Series count & Voltage configuration\n        Card(\n            modifier = Modifier.fillMaxWidth(),\n            colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.surface)\n        ) {\n            Column(modifier = Modifier.padding(16.dp)) {\n                Row(\n                    modifier = Modifier.fillMaxWidth(),\n                    horizontalArrangement = Arrangement.SpaceBetween,\n                    verticalAlignment = Alignment.CenterVertically\n                ) {\n                    Text(\n                        text = \"\340\246\270\340\246\277\340\246\260\340\246\277\340\246\234 \340\246\270\340\247\207\340\246\262 \340\246\223 \340\246\255\340\247\213\340\246\262\340\247\215\340\246\237\340\247\207\340\246\234 (Series - S)\",\n                        fontWeight = FontWeight.Bold,\n                        style = MaterialTheme.typography.titleMedium\n                    )\n                    Text(\n                        text = \"${viewModel.seriesCells}S (${viewModel.packNominalVoltage.format(1)} V)\",\n                        fontWeight = FontWeight.ExtraBold,\n                        color = MaterialTheme.colorScheme.primary,\n                        style = MaterialTheme.typography.titleMedium\n                    )\n                }\n\n                Spacer(modifier = Modifier.height(8.dp))\n\n                Slider(\n                    value = viewModel.seriesCells.toFloat(),\n                    onValueChange = { viewModel.seriesCells = it.roundToInt() },\n                    valueRange = 1f..32f,\n                    steps = 30,\n                    modifier = Modifier.fillMaxWidth()\n                )\n\n                Spacer(modifier = Modifier.height(4.dp))\n\n                // Standard S quick buttons\n                Row(\n                    modifier = Modifier.fillMaxWidth(),\n                    horizontalArrangement = Arrangement.spacedBy(8.dp)\n                ) {\n                    val quickVoltages = listOf(\n                        4 to \"12V (4S)\",\n                        8 to \"24V (8S)\",\n                        16 to \"48V (16S)\"\n                    )\n                    quickVoltages.forEach { (sCount, label) ->\n                        val selected = viewModel.seriesCells == sCount\n                        SuggestionChip(\n                            onClick = { viewModel.applySVoltPreset(sCount) },\n                            label = { Text(label) },\n                            colors = SuggestionChipDefaults.suggestionChipColors(\n                                containerColor = if (selected) MaterialTheme.colorScheme.primaryContainer else Color.Transparent,\n                                labelColor = if (selected) MaterialTheme.colorScheme.onPrimaryContainer else MaterialTheme.colorScheme.onSurface\n                            ),\n                            modifier = Modifier.weight(1f)\n                        )\n                    }\n                }\n            }\n        }\n\n        // Parallel count settings\n        Card(\n            modifier = Modifier.fillMaxWidth(),\n            colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.surface)\n        ) {\n            Column(modifier = Modifier.padding(16.dp)) {\n                Row(\n                    modifier = Modifier.fillMaxWidth(),\n                    horizontalArrangement = Arrangement.SpaceBetween,\n                    verticalAlignment = Alignment.CenterVertically\n                ) {\n                    Text(\n                        text = \"\340\246\252\340\247\215\340\246\257\340\246\276\340\246\260\340\246\276\340\246\262\340\246\276\340\246\262 \340\246\270\340\247\207\340\246\262 \340\246\223 \340\246\256\340\247\213\340\246\237 \340\246\217\340\246\256\340\247\215\340\246\252\340\246\277\340\246\257\340\246\274\340\246\276\340\246\260 (Parallel - P)\",\n                        fontWeight = FontWeight.Bold,\n                        style = MaterialTheme.typography.titleMedium\n                    )\n                    Text(\n                        text = \"${viewModel.parallelCells}P (${viewModel.packCapacityAh.toInt()} Ah)\",\n                        fontWeight = FontWeight.ExtraBold,\n                        color = MaterialTheme.colorScheme.primary,\n                        style = MaterialTheme.typography.titleMedium\n                    )\n                }\n\n                Spacer(modifier = Modifier.height(8.dp))\n\n                Slider(\n                    value = viewModel.parallelCells.toFloat(),\n                    onValueChange = { viewModel.parallelCells = it.roundToInt() },\n                    valueRange = 1f..16f,\n                    steps = 14,\n                    modifier = Modifier.fillMaxWidth()\n                )\n            }\n        }\n\n        // Discharge depth settings\n        Card(\n            modifier = Modifier.fillMaxWidth(),\n            colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.surface)\n        ) {\n            Column(modifier = Modifier.padding(16.dp)) {\n                Row(\n                    modifier = Modifier.fillMaxWidth(),\n                    horizontalArrangement = Arrangement.SpaceBetween,\n                    verticalAlignment = Alignment.CenterVertically\n                ) {\n                    Text(\n                        text = \"\340\246\241\340\246\277\340\246\270\340\246\232\340\246\276\340\246\260\340\247\215\340\246\234 \340\246\241\340\247\207\340\246\252\340\246\245 \340\246\270\340\247\207\340\246\237\340\246\277\340\246\202\340\246\270 (DoD %)\",\n                        fontWeight = FontWeight.Bold,\n                        style = MaterialTheme.typography.titleMedium\n                    )\n                    Text(\n                        text = \"${viewModel.depthOfDischargePercent.roundToInt()}%\",\n                        fontWeight = FontWeight.ExtraBold,\n                        color = if (viewModel.depthOfDischargePercent <= 80.0) BatteryFull else BatteryHalf,\n                        style = MaterialTheme.typography.titleMedium\n                    )\n                }\n\n                Text(\n                    text = \"LFP \340\246\254\340\247\215\340\246\257\340\246\276\340\246\237\340\246\276\340\246\260\340\246\277 \340\246\252\340\247\215\340\246\257\340\246\276\340\246\225 \340\247\256\340\247\246% \340\246\241\340\246\277\340\246\270\340\246\232\340\246\276\340\246\260\340\247\215\340\246\234\340\247\207 \340\246\260\340\246\276\340\246\226\340\246\262\340\247\207 \340\246\270\340\246\254\340\246\232\340\247\207\340\247\237\340\247\207 \340\246\246\340\247\200\340\246\260\340\247\215\340\246\230\340\246\270\340\247\215\340\246\245\340\246\276\340\246\257\340\246\274\340\247\200 \340\246\271\340\247\237 \340\246\217\340\246\254\340\246\202 \340\246\270\340\246\276\340\246\207\340\246\225\340\247\207\340\246\262 \340\246\262\340\246\276\340\246\207\340\246\253 \340\246\254\340\246\271\340\247\201\340\246\227\340\247\201\340\246\243 \340\246\254\340\247\207\340\247\234\340\247\207 \340\246\257\340\246\276\340\247\237\340\245\244\",\n                    style = MaterialTheme.typography.bodySmall,\n                    color = MaterialTheme.colorScheme.onSurfaceVariant,\n                    modifier = Modifier.padding(top = 4.dp, bottom = 12.dp)\n                )\n\n                Slider(\n                    value = viewModel.depthOfDischargePercent.toFloat(),\n                    onValueChange = { viewModel.depthOfDischargePercent = it.roundToInt().toDouble() },\n                    valueRange = 10f..100f,\n                    modifier = Modifier.fillMaxWidth()\n                )\n\n                Row(\n                    modifier = Modifier.fillMaxWidth(),\n                    horizontalArrangement = Arrangement.spacedBy(8.dp)\n                ) {\n                    val dops = listOf(\n                        80.0 to \"80% (\340\246\254\340\247\207\340\246\270\340\247\215\340\246\237 \340\246\262\340\246\276\340\246\207\340\246\253)\",\n                        90.0 to \"90% (\340\246\255\340\246\276\340\246\260\340\246\270\340\246\276\340\246\256\340\247\215\340\246\257)\",\n                        100.0 to \"100% (\340\246\270\340\246\260\340\247\215\340\246\254\340\247\213\340\246\232\340\247\215\340\246\232 \340\246\260\340\247\207\340\246\236\340\247\215\340\246\234)\"\n                    )\n                    dops.forEach { (dod, label) ->\n                        val selected = viewModel.depthOfDischargePercent == dod\n                        SuggestionChip(\n                            onClick = { viewModel.depthOfDischargePercent = dod },\n                            label = { Text(label, fontSize = 11.sp) },\n                            colors = SuggestionChipDefaults.suggestionChipColors(\n                                containerColor = if (selected) MaterialTheme.colorScheme.primaryContainer else Color.Transparent,\n                                labelColor = if (selected) MaterialTheme.colorScheme.onPrimaryContainer else MaterialTheme.colorScheme.onSurface\n                            ),\n                            modifier = Modifier.weight(1f)\n                        )\n                    }\n                }\n            }\n        }\n\n        // Save Battery Pack Button\n        Button(\n            onClick = onSaveClicked,\n            modifier = Modifier\n                .fillMaxWidth()\n                .height(48.dp)\n                .testTag(\"save_config_button\"),\n            colors = ButtonDefaults.buttonColors(containerColor = MaterialTheme.colorScheme.primary)\n        ) {\n            Icon(Icons.Default.Save, contentDescription = null)\n            Spacer(modifier = Modifier.width(8.dp))\n            Text(\"\340\246\241\340\246\277\340\246\234\340\246\276\340\246\207\340\246\250\340\246\237\340\246\277 \340\246\270\340\247\207\340\246\255 \340\246\225\340\246\260\340\247\207 \340\246\260\340\246\276\340\246\226\340\247\201\340\246\250\", fontWeight = FontWeight.Bold)\n        }\n    }\n}\n\n// TAB 3: Solar installation advisor guidelines & Bills of materials\n@Composable\nfun SolarGridGuideTab(viewModel: BatteryViewModel) {\n    val scrollState = rememberScrollState()\n\n    Column(\n        modifier = Modifier\n            .fillMaxSize()\n            .verticalScroll(scrollState)\n            .padding(12.dp),\n        verticalArrangement = Arrangement.spacedBy(14.dp)\n    ) {\n        // Grid Selector\n        Card(\n            modifier = Modifier.fillMaxWidth(),\n            colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.surface)\n        ) {\n            Column(modifier = Modifier.padding(16.dp)) {\n                Text(\n                    text = \"\340\246\270\340\247\213\340\246\262\340\246\276\340\246\260 \340\246\227\340\247\215\340\246\260\340\246\277\340\246\241 \340\246\205\340\246\252\340\246\266\340\246\250 \340\246\250\340\246\277\340\246\260\340\247\215\340\246\254\340\246\276\340\246\232\340\246\250 \340\246\225\340\246\260\340\247\201\340\246\250\",\n                    fontWeight = FontWeight.Bold,\n                    style = MaterialTheme.typography.titleMedium,\n                    color = MaterialTheme.colorScheme.primary\n                )\n                Text(\n                    text = \"\340\246\206\340\246\252\340\246\250\340\246\276\340\246\260 \340\246\254\340\246\276\340\246\270\340\246\276 \340\246\254\340\246\276 \340\246\252\340\247\215\340\246\260\340\246\234\340\247\207\340\246\225\340\247\215\340\246\237\340\247\207\340\246\260 \340\246\260\340\246\277\340\246\225\340\247\213\340\247\237\340\246\276\340\246\260\340\246\256\340\247\207\340\246\250\340\247\215\340\246\237 \340\246\205\340\246\250\340\247\201\340\246\257\340\246\276\340\247\237\340\247\200 \340\246\205\340\246\250-\340\246\227\340\247\215\340\246\260\340\246\277\340\246\241, \340\246\205\340\246\253-\340\246\227\340\247\215\340\246\260\340\246\277\340\246\241 \340\246\254\340\246\276 \340\246\271\340\246\276\340\246\207\340\246\254\340\247\215\340\246\260\340\246\277\340\246\241 \340\246\250\340\246\277\340\246\260\340\247\215\340\246\254\340\246\276\340\246\232\340\246\250 \340\246\225\340\246\260\340\247\201\340\246\250\340\245\244\",\n                    style = MaterialTheme.typography.bodySmall,\n                    color = MaterialTheme.colorScheme.onSurfaceVariant,\n                    modifier = Modifier.padding(bottom = 12.dp)\n                )\n\n                Row(\n                    modifier = Modifier.fillMaxWidth(),\n                    horizontalArrangement = Arrangement.spacedBy(8.dp)\n                ) {\n                    val gridTypes = listOf(\n                        \"offgrid\" to \"\340\246\205\340\246\253-\340\246\227\340\247\215\340\246\260\340\246\277\340\246\241 (Off-Grid)\",\n                        \"ongrid\" to \"\340\246\205\340\246\250-\340\246\227\340\247\215\340\246\260\340\246\277\340\246\241 (On-Grid)\",\n                        \"hybrid\" to \"\340\246\271\340\246\276\340\246\207\340\246\254\340\247\215\340\246\260\340\246\277\340\246\241 (Hybrid)\"\n                    )\n                    gridTypes.forEach { (type, label) ->\n                        val selected = viewModel.selectedGridType == type\n                        ElevatedFilterChip(\n                            selected = selected,\n                            onClick = { viewModel.selectedGridType = type },\n                            label = { Text(label, fontSize = 11.sp, fontWeight = FontWeight.Bold) },\n                            modifier = Modifier.weight(1f)\n                        )\n                    }\n                }\n            }\n        }\n\n        // Dynamic guidelines based on selection\n        Card(\n            modifier = Modifier.fillMaxWidth(),\n            colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.surface)\n        ) {\n            Column(modifier = Modifier.padding(16.dp)) {\n                when (viewModel.selectedGridType) {\n                    \"offgrid\" -> {\n                        Text(\n                            text = \"\360\237\224\213 \340\246\205\340\246\253-\340\246\227\340\247\215\340\246\260\340\246\277\340\246\241 \340\246\270\340\246\277\340\246\270\340\247\215\340\246\237\340\247\207\340\246\256 \340\246\227\340\246\276\340\246\207\340\246\241\340\246\262\340\246\276\340\246\207\340\246\250 (Off-Grid System)\",\n                            fontWeight = FontWeight.Bold,\n                            style = MaterialTheme.typography.titleMedium,\n                            color = MaterialTheme.colorScheme.primary\n                        )\n                        Spacer(modifier = Modifier.height(8.dp))\n                        Text(\n                            text = \"\340\246\205\340\246\253-\340\246\227\340\247\215\340\246\260\340\246\277\340\246\241 \340\246\270\340\247\213\340\246\262\340\246\276\340\246\260 \340\246\270\340\246\277\340\246\270\340\247\215\340\246\237\340\247\207\340\246\256 \340\246\227\340\247\215\340\246\260\340\246\277\340\246\241 \340\246\254\340\246\276 \340\246\234\340\246\276\340\246\244\340\247\200\340\247\237 \340\246\254\340\246\277\340\246\246\340\247\215\340\246\257\340\247\201\340\247\216 \340\246\262\340\246\276\340\246\207\340\246\250\340\247\207\340\246\260 \340\246\270\340\246\276\340\246\245\340\247\207 \340\246\257\340\247\201\340\246\225\340\247\215\340\246\244 \340\246\245\340\246\276\340\246\225\340\247\207 \340\246\250\340\246\276\340\245\244 \340\246\217\340\246\237\340\246\277 \340\246\270\340\246\256\340\247\215\340\246\252\340\247\202\340\246\260\340\247\215\340\246\243 \340\246\270\340\247\215\340\246\254\340\247\237\340\246\202\340\246\270\340\246\256\340\247\215\340\246\252\340\247\202\340\246\260\340\247\215\340\246\243\340\245\244 \340\246\246\340\246\277\340\246\250\340\247\207 \340\246\270\340\247\213\340\246\262\340\246\276\340\246\260 \340\246\223 \340\246\260\340\246\276\340\246\244\340\247\207 \340\246\254\340\247\215\340\246\257\340\246\276\340\246\237\340\246\276\340\246\260\340\246\277\340\246\260 \340\246\256\340\246\276\340\246\247\340\247\215\340\246\257\340\246\256\340\247\207 \340\246\262\340\247\213\340\246\241 \340\246\232\340\246\276\340\246\262\340\246\276\340\246\250\340\247\213 \340\246\271\340\247\237\340\245\244\",\n                            style = MaterialTheme.typography.bodyMedium,\n                            color = MaterialTheme.colorScheme.onSurface\n                        )\n                        Spacer(modifier = Modifier.height(12.dp))\n\n                        Text(\"\340\246\270\340\247\201\340\246\254\340\246\277\340\246\247\340\246\276\340\246\270\340\246\256\340\247\202\340\246\271 (Advantages):\", fontWeight = FontWeight.Bold, color = BatteryFull)\n                        BulletPoint(\"\340\246\234\340\246\276\340\246\244\340\247\200\340\246\257\340\246\274 \340\246\227\340\247\215\340\246\260\340\246\277\340\246\241\340\247\207\340\246\260 \340\246\262\340\247\213\340\246\241\340\246\266\340\247\207\340\246\241\340\246\277\340\246\202 \340\246\245\340\247\207\340\246\225\340\247\207 \340\247\247\340\247\246\340\247\246% \340\246\256\340\247\201\340\246\225\340\247\215\340\246\244\340\246\277\340\245\244\")\n                        BulletPoint(\"\340\246\254\340\246\277\340\246\246\340\247\215\340\246\257\340\247\201\340\247\216 \340\246\254\340\246\277\340\246\262 \340\246\270\340\246\256\340\247\215\340\246\252\340\247\202\340\246\260\340\