  file_change {
    absolute_path_uri: "file:///app/src/main/java/com/example/ui/BatteryCalculatorScreen.kt"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "package com.example.ui\n\nimport androidx.compose.animation.AnimatedVisibility\nimport androidx.compose.animation.animateColorAsState\nimport androidx.compose.animation.core.animateFloatAsState\nimport androidx.compose.animation.core.tween\nimport androidx.compose.animation.fadeIn\nimport androidx.compose.animation.fadeOut\nimport androidx.compose.foundation.Canvas\nimport androidx.compose.foundation.background\nimport androidx.compose.foundation.border\nimport androidx.compose.foundation.clickable\nimport androidx.compose.foundation.layout.*\nimport androidx.compose.foundation.lazy.LazyColumn\nimport androidx.compose.foundation.lazy.items\nimport androidx.compose.foundation.rememberScrollState\nimport androidx.compose.foundation.shape.RoundedCornerShape\nimport androidx.compose.foundation.text.KeyboardActions\nimport androidx.compose.foundation.text.KeyboardOptions\nimport androidx.compose.foundation.verticalScroll\nimport androidx.compose.material.icons.Icons\nimport androidx.compose.material.icons.filled.*\nimport androidx.compose.material3.*\nimport androidx.compose.runtime.*\nimport androidx.compose.ui.Alignment\nimport androidx.compose.ui.Modifier\nimport androidx.compose.ui.draw.clip\nimport androidx.compose.ui.draw.shadow\nimport androidx.compose.ui.geometry.CornerRadius\nimport androidx.compose.ui.geometry.Offset\nimport androidx.compose.ui.geometry.Size\nimport androidx.compose.ui.graphics.Brush\nimport androidx.compose.ui.graphics.Color\nimport androidx.compose.ui.graphics.drawscope.Stroke\nimport androidx.compose.ui.graphics.vector.ImageVector\nimport androidx.compose.ui.platform.LocalFocusManager\nimport androidx.compose.ui.platform.testTag\nimport androidx.compose.ui.res.stringResource\nimport androidx.compose.ui.text.font.FontWeight\nimport androidx.compose.ui.text.input.ImeAction\nimport androidx.compose.ui.text.input.KeyboardType\nimport androidx.compose.ui.text.style.TextAlign\nimport androidx.compose.ui.text.style.TextOverflow\nimport androidx.compose.ui.unit.dp\nimport androidx.compose.ui.unit.sp\nimport androidx.lifecycle.compose.collectAsStateWithLifecycle\nimport com.example.R\nimport com.example.data.BatteryConfig\nimport com.example.ui.theme.*\nimport java.util.Locale\nimport kotlin.math.roundToInt\n\n@OptIn(ExperimentalMaterial3Api::class)\n@Composable\nfun BatteryCalculatorScreen(\n    viewModel: BatteryViewModel,\n    modifier: Modifier = Modifier\n) {\n    val savedConfigs by viewModel.savedConfigs.collectAsStateWithLifecycle()\n    val focusManager = LocalFocusManager.current\n\n    // Local UI states\n    var activeTab by remember { mutableStateOf(0) } // 0: Calculator, 1: Appliance Load, 2: Saved Systems\n    var showSaveDialog by remember { mutableStateOf(false) }\n    var configNameInput by remember { mutableStateOf(\"\") }\n\n    Scaffold(\n        topBar = {\n            CenterAlignedTopAppBar(\n                title = {\n                    Row(\n                        verticalAlignment = Alignment.CenterVertically,\n                        horizontalArrangement = Arrangement.Center\n                    ) {\n                        Icon(\n                            imageVector = Icons.Default.Eco,\n                            contentDescription = null,\n                            tint = GreenPrimaryDark,\n                            modifier = Modifier.size(24.dp)\n                        )\n                        Spacer(modifier = Modifier.width(8.dp))\n                        Text(\n                            text = \"LFP Energy Lab\",\n                            fontWeight = FontWeight.Bold,\n                            color = MaterialTheme.colorScheme.onBackground\n                        )\n                    }\n                },\n                colors = TopAppBarDefaults.centerAlignedTopAppBarColors(\n                    containerColor = MaterialTheme.colorScheme.background\n                )\n            )\n        },\n        modifier = modifier\n            .fillMaxSize()\n            .windowInsetsPadding(WindowInsets.safeDrawing)\n    ) { innerPadding ->\n        Column(\n            modifier = Modifier\n                .padding(innerPadding)\n                .fillMaxSize()\n                .background(MaterialTheme.colorScheme.background)\n        ) {\n            // 1. Dynamic Interactive Battery Gauge Header\n            BatteryVisualHeader(\n                seriesCells = viewModel.seriesCells,\n                parallelCells = viewModel.parallelCells,\n                totalCapacityAh = viewModel.packCapacityAh,\n                nominalVoltage = viewModel.packNominalVoltage,\n                totalKwh = viewModel.totalWattHours / 1000.0,\n                usableKwh = viewModel.usableWattHours / 1000.0,\n                dodPercent = viewModel.depthOfDischargePercent,\n                cycleLife = viewModel.cycleLifeEstimate\n            )\n\n            // 2. Navigation Tabs (Simple & elegant)\n            TabRow(\n                selectedTabIndex = activeTab,\n                containerColor = MaterialTheme.colorScheme.background,\n                contentColor = MaterialTheme.colorScheme.primary,\n                modifier = Modifier.fillMaxWidth()\n            ) {\n                Tab(\n                    selected = activeTab == 0,\n                    onClick = { activeTab = 0 },\n                    text = { Text(\"Pack Setup\", fontWeight = FontWeight.SemiBold) },\n                    icon = { Icon(Icons.Default.Settings, contentDescription = null) }\n                )\n                Tab(\n                    selected = activeTab == 1,\n                    onClick = { activeTab = 1 },\n                    text = { Text(\"Appliance Loads\", fontWeight = FontWeight.SemiBold) },\n                    icon = { Icon(Icons.Default.Bolt, contentDescription = null) }\n                )\n                Tab(\n                    selected = activeTab == 2,\n                    onClick = { activeTab = 2 },\n                    text = { Text(\"Saved Packs\", fontWeight = FontWeight.SemiBold) },\n                    icon = { Icon(Icons.Default.History, contentDescription = null) }\n                )\n            }\n\n            Spacer(modifier = Modifier.height(8.dp))\n\n            // 3. Tab Contents\n            Box(\n                modifier = Modifier\n                    .weight(1f)\n                    .fillMaxWidth()\n            ) {\n                when (activeTab) {\n                    0 -> CalculatorConfigTab(\n                        viewModel = viewModel,\n                        onSaveClicked = {\n                            configNameInput = \"${viewModel.seriesCells}S${viewModel.parallelCells}P LFP Pack\"\n                            showSaveDialog = true\n                        }\n                    )\n                    1 -> ApplianceLoadsTab(usableWh = viewModel.usableWattHours)\n                    2 -> SavedSystemsTab(\n                        savedConfigs = savedConfigs,\n                        onLoadConfig = { config ->\n                            viewModel.loadConfig(config)\n                            activeTab = 0 // Switch back to calculator\n                        },\n                        onDeleteConfig = { id -> viewModel.deleteConfig(id) }\n                    )\n                }\n            }\n        }\n    }\n\n    // Save Configuration Dialog\n    if (showSaveDialog) {\n        AlertDialog(\n            onDismissRequest = { showSaveDialog = false },\n            title = { Text(\"Save Battery Design\") },\n            text = {\n                Column {\n                    Text(\n                        \"Give this LFP battery system a description to save it in local storage.\",\n                        style = MaterialTheme.typography.bodyMedium,\n                        color = MaterialTheme.colorScheme.onSurfaceVariant\n                    )\n                    Spacer(modifier = Modifier.height(12.dp))\n                    OutlinedTextField(\n                        value = configNameInput,\n                        onValueChange = { configNameInput = it },\n                        label = { Text(\"System Name\") },\n                        singleLine = true,\n                        modifier = Modifier\n                            .fillMaxWidth()\n                            .testTag(\"config_name_input\"),\n                        keyboardOptions = KeyboardOptions(imeAction = ImeAction.Done),\n                        keyboardActions = KeyboardActions(onDone = { focusManager.clearFocus() })\n                    )\n                }\n            },\n            confirmButton = {\n                Button(\n                    onClick = {\n                        if (configNameInput.isNotBlank()) {\n                            viewModel.saveCurrentConfig(configNameInput)\n                            showSaveDialog = false\n                        }\n                    },\n                    modifier = Modifier.testTag(\"save_config_confirm\")\n                ) {\n                    Text(\"Save\")\n                }\n            },\n            dismissButton = {\n                TextButton(onClick = { showSaveDialog = false }) {\n                    Text(\"Cancel\")\n                }\n            }\n        )\n    }\n}\n\n@Composable\nfun BatteryVisualHeader(\n    seriesCells: Int,\n    parallelCells: Int,\n    totalCapacityAh: Double,\n    nominalVoltage: Double,\n    totalKwh: Double,\n    usableKwh: Double,\n    dodPercent: Double,\n    cycleLife: Int\n) {\n    Card(\n        modifier = Modifier\n            .fillMaxWidth()\n            .padding(16.dp),\n        colors = CardDefaults.cardColors(\n            containerColor = MaterialTheme.colorScheme.surfaceVariant.copy(alpha = 0.4f)\n        ),\n        shape = RoundedCornerShape(16.dp)\n    ) {\n        Column(\n            modifier = Modifier\n                .fillMaxWidth()\n                .padding(16.dp),\n            horizontalAlignment = Alignment.CenterHorizontally\n        ) {\n            Row(\n                modifier = Modifier.fillMaxWidth(),\n                horizontalArrangement = Arrangement.SpaceBetween,\n                verticalAlignment = Alignment.CenterVertically\n            ) {\n                // Info block\n                Column {\n                    Text(\n                        text = \"CONFIGURATION\",\n                        style = MaterialTheme.typography.labelSmall,\n                        color = MaterialTheme.colorScheme.onSurfaceVariant,\n                        fontWeight = FontWeight.Bold\n                    )\n                    Text(\n                        text = \"${seriesCells}S ${parallelCells}P Pack\",\n                        style = MaterialTheme.typography.titleLarge,\n                        fontWeight = FontWeight.Bold,\n                        color = MaterialTheme.colorScheme.primary\n                    )\n                    Text(\n                        text = String.format(Locale.getDefault(), \"%.1f V | %.0f Ah\", nominalVoltage, totalCapacityAh),\n                        style = MaterialTheme.typography.bodyMedium,\n                        color = MaterialTheme.colorScheme.onSurfaceVariant\n                    )\n                }\n\n                // Energy details\n                Column(horizontalAlignment = Alignment.End) {\n                    Text(\n                        text = \"EST. CYCLE LIFE\",\n                        style = MaterialTheme.typography.labelSmall,\n                        color = MaterialTheme.colorScheme.onSurfaceVariant,\n                        fontWeight = FontWeight.Bold\n                    )\n                    Text(\n                        text = \"~$cycleLife cycles\",\n                        style = MaterialTheme.typography.titleLarge,\n                        fontWeight = FontWeight.ExtraBold,\n                        color = if (dodPercent <= 80.0) BatteryFull else BatteryHalf\n                    )\n                    Text(\n                        text = \"At ${dodPercent.roundToInt()}% DoD\",\n                        style = MaterialTheme.typography.bodySmall,\n                        color = MaterialTheme.colorScheme.onSurfaceVariant\n                    )\n                }\n            }\n\n            Spacer(modifier = Modifier.height(16.dp))\n\n            // Battery Cylinder Custom Canvas Drawing\n            Row(\n                modifier = Modifier\n                    .fillMaxWidth()\n                    .height(90.dp),\n                verticalAlignment = Alignment.CenterVertically,\n                horizontalArrangement = Arrangement.Center\n            ) {\n                Box(\n                    modifier = Modifier\n                        .weight(1f)\n                        .height(80.dp),\n                    contentAlignment = Alignment.Center\n                ) {\n                    // Let\'s draw the custom battery cylinder\n                    val level = dodPercent / 100.0\n                    val animatedLevel by animateFloatAsState(\n                        targetValue = level.toFloat(),\n                        animationSpec = tween(600),\n                        label = \"BatteryLevel\"\n                    )\n\n                    Canvas(\n                        modifier = Modifier\n                            .fillMaxSize()\n                    ) {\n                        val strokeWidth = 3.dp.toPx()\n                        val capWidth = 12.dp.toPx()\n                        val capHeight = 24.dp.toPx()\n\n                        val mainBodyWidth = size.width - capWidth - 8.dp.toPx()\n                        val mainBodyHeight = size.height\n\n                        // 1. Draw Battery Outer Border Container (Main Body)\n                        drawRoundRect(\n                            color = Color.LightGray.copy(alpha = 0.5f),\n                            size = Size(mainBodyWidth, mainBodyHeight),\n                            cornerRadius = CornerRadius(12.dp.toPx(), 12.dp.toPx()),\n                            style = Stroke(width = strokeWidth)\n                        )\n\n                        // 2. Draw Battery Positive Terminal Cap (Right Side)\n                        drawRoundRect(\n                            color = Color.LightGray.copy(alpha = 0.5f),\n                            topLeft = Offset(mainBodyWidth, (mainBodyHeight - capHeight) / 2),\n                            size = Size(capWidth, capHeight),\n                            cornerRadius = CornerRadius(4.dp.toPx(), 4.dp.toPx())\n                        )\n\n                        // 3. Draw Inner Fluid Fill representing the Configurable DoD Usable Energy\n                        val innerPadding = 6.dp.toPx()\n                        val maxFillWidth = mainBodyWidth - (innerPadding * 2)\n                        val fillHeight = mainBodyHeight - (innerPadding * 2)\n\n                        val fillWidth = maxFillWidth * animatedLevel\n\n                        val brush = Brush.linearGradient(\n                            colors = listOf(\n                                GreenPrimaryDark,\n                                BatteryFull\n                            )\n                        )\n\n                        if (fillWidth > 0f) {\n                            drawRoundRect(\n                                brush = brush,\n                                topLeft = Offset(innerPadding, innerPadding),\n                                size = Size(fillWidth, fillHeight),\n                                cornerRadius = CornerRadius(8.dp.toPx(), 8.dp.toPx())\n                            )\n                        }\n\n                        // Draw lines showing depth limits\n                        if (animatedLevel < 1f) {\n                            val limitX = innerPadding + fillWidth\n                            drawLine(\n                                color = Color.Red.copy(alpha = 0.6f),\n                                start = Offset(limitX, innerPadding),\n                                end = Offset(limitX, innerPadding + fillHeight),\n                                strokeWidth = 2.dp.toPx()\n                            )\n                        }\n                    }\n\n                    // Inside texts showing energy metrics\n                    Row(\n                        modifier = Modifier\n                            .fillMaxSize()\n                            .padding(horizontal = 24.dp),\n                        verticalAlignment = Alignment.CenterVertically,\n                        horizontalArrangement = Arrangement.SpaceBetween\n                    ) {\n                        Column {\n                            Text(\n                                text = String.format(Locale.getDefault(), \"%.2f kWh\", usableKwh),\n                                style = MaterialTheme.typography.titleMedium,\n                                fontWeight = FontWeight.Bold,\n                                color = MaterialTheme.colorScheme.onSurface\n                            )\n                            Text(\n                                \"Usable Energy\",\n                                style = MaterialTheme.typography.labelSmall,\n                                color = MaterialTheme.colorScheme.onSurfaceVariant\n                            )\n                        }\n\n                        Column(horizontalAlignment = Alignment.End) {\n                            Text(\n                                text = String.format(Locale.getDefault(), \"%.2f kWh\", totalKwh),\n                                style = MaterialTheme.typography.titleMedium,\n                                fontWeight = FontWeight.Bold,\n                                color = MaterialTheme.colorScheme.onSurfaceVariant\n                            )\n                            Text(\n                                \"Total Capacity\",\n                                style = MaterialTheme.typography.labelSmall,\n                                color = MaterialTheme.colorScheme.onSurfaceVariant\n                            )\n                        }\n                    }\n                }\n            }\n        }\n    }\n}\n\n@Composable\nfun CalculatorConfigTab(\n    viewModel: BatteryViewModel,\n    onSaveClicked: () -> Unit\n) {\n    val scrollState = rememberScrollState()\n\n    Column(\n        modifier = Modifier\n            .fillMaxSize()\n            .verticalScroll(scrollState)\n            .padding(16.dp),\n        verticalArrangement = Arrangement.spacedBy(16.dp)\n    ) {\n        // Series & Voltage Section\n        Card(\n            modifier = Modifier.fillMaxWidth(),\n            colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.surface)\n        ) {\n            Column(modifier = Modifier.padding(16.dp)) {\n                Row(\n                    modifier = Modifier.fillMaxWidth(),\n                    horizontalArrangement = Arrangement.SpaceBetween,\n                    verticalAlignment = Alignment.CenterVertically\n                ) {\n                    Text(\n                        text = \"Series Cells (Nominal Voltage)\",\n                        fontWeight = FontWeight.Bold,\n                        style = MaterialTheme.typography.titleMedium\n                    )\n                    Text(\n                        text = \"${viewModel.seriesCells}S (${viewModel.packNominalVoltage}V)\",\n                        fontWeight = FontWeight.ExtraBold,\n                        color = MaterialTheme.colorScheme.primary,\n                        style = MaterialTheme.typography.titleMedium\n                    )\n                }\n\n                Spacer(modifier = Modifier.height(12.dp))\n\n                // Slider for Series S Count\n                Slider(\n                    value = viewModel.seriesCells.toFloat(),\n                    onValueChange = { viewModel.seriesCells = it.roundToInt() },\n                    valueRange = 1f..32f,\n                    steps = 30,\n                    modifier = Modifier\n                        .fillMaxWidth()\n                        .testTag(\"series_cells_slider\")\n                )\n\n                Spacer(modifier = Modifier.height(8.dp))\n\n                // Standard Voltage Quick Presets\n                Row(\n                    modifier = Modifier.fillMaxWidth(),\n                    horizontalArrangement = Arrangement.spacedBy(8.dp)\n                ) {\n                    val presets = listOf(\n                        4 to \"12V (4S)\",\n                        8 to \"24V (8S)\",\n                        12 to \"36V (12S)\",\n                        16 to \"48V (16S)\"\n                    )\n                    presets.forEach { (sCount, label) ->\n                        val selected = viewModel.seriesCells == sCount\n                        SuggestionChip(\n                            onClick = { viewModel.applySVoltPreset(sCount) },\n                            label = { Text(label, style = MaterialTheme.typography.bodySmall) },\n                            colors = SuggestionChipDefaults.suggestionChipColors(\n                                containerColor = if (selected) MaterialTheme.colorScheme.primaryContainer else Color.Transparent,\n                                labelColor = if (selected) MaterialTheme.colorScheme.onPrimaryContainer else MaterialTheme.colorScheme.onSurface\n                            ),\n                            modifier = Modifier.weight(1f)\n                        )\n                    }\n                }\n            }\n        }\n\n        // Parallel & Cell Capacity Section\n        Card(\n            modifier = Modifier.fillMaxWidth(),\n            colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.surface)\n        ) {\n            Column(modifier = Modifier.padding(16.dp)) {\n                Row(\n                    modifier = Modifier.fillMaxWidth(),\n                    horizontalArrangement = Arrangement.SpaceBetween,\n                    verticalAlignment = Alignment.CenterVertically\n                ) {\n                    Text(\n                        text = \"Parallel Cells & Cell Capacity\",\n                        fontWeight = FontWeight.Bold,\n                        style = MaterialTheme.typography.titleMedium\n                    )\n                    Text(\n                        text = \"${viewModel.parallelCells}P (${viewModel.packCapacityAh} Ah)\",\n                        fontWeight = FontWeight.ExtraBold,\n                        color = MaterialTheme.colorScheme.primary,\n                        style = MaterialTheme.typography.titleMedium\n                    )\n                }\n\n                Spacer(modifier = Modifier.height(12.dp))\n\n                // Parallel P Count Input\n                Text(\n                    text = \"Parallel Count (P): ${viewModel.parallelCells}\",\n                    style = MaterialTheme.typography.bodyMedium,\n                    color = MaterialTheme.colorScheme.onSurfaceVariant\n                )\n                Slider(\n                    value = viewModel.parallelCells.toFloat(),\n                    onValueChange = { viewModel.parallelCells = it.roundToInt() },\n                    valueRange = 1f..16f,\n                    steps = 14,\n                    modifier = Modifier\n                        .fillMaxWidth()\n                        .testTag(\"parallel_cells_slider\")\n                )\n\n                Spacer(modifier = Modifier.height(8.dp))\n\n                // Capacity Picker\n                Row(\n                    verticalAlignment = Alignment.CenterVertically,\n                    horizontalArrangement = Arrangement.SpaceBetween,\n                    modifier = Modifier.fillMaxWidth()\n                ) {\n                    Text(\n                        text = \"Cell Capacity: ${viewModel.cellCapacityAh} Ah\",\n                        style = MaterialTheme.typography.bodyMedium,\n                        color = MaterialTheme.colorScheme.onSurfaceVariant\n                    )\n                }\n                Slider(\n                    value = viewModel.cellCapacityAh.toFloat(),\n                    onValueChange = { viewModel.cellCapacityAh = it.roundToInt().toDouble() },\n                    valueRange = 10f..350f,\n                    modifier = Modifier.fillMaxWidth()\n                )\n\n                Spacer(modifier = Modifier.height(8.dp))\n\n                // Standard Ah Presets\n                Row(\n                    modifier = Modifier.fillMaxWidth(),\n                    horizontalArrangement = Arrangement.spacedBy(6.dp)\n                ) {\n                    val presets = listOf(50.0, 100.0, 200.0, 280.0, 304.0)\n                    presets.forEach { ah ->\n                        val selected = viewModel.cellCapacityAh == ah\n                        SuggestionChip(\n                            onClick = { viewModel.applyAhPreset(ah) },\n                            label = { Text(\"${ah.toInt()}Ah\", style = MaterialTheme.typography.bodySmall) },\n                            colors = SuggestionChipDefaults.suggestionChipColors(\n                                containerColor = if (selected) MaterialTheme.colorScheme.primaryContainer else Color.Transparent,\n                                labelColor = if (selected) MaterialTheme.colorScheme.onPrimaryContainer else MaterialTheme.colorScheme.onSurface\n                            ),\n                            modifier = Modifier.weight(1f)\n                        )\n                    }\n                }\n            }\n        }\n\n        // Discharge Depth (DoD) Settings Card\n        Card(\n            modifier = Modifier.fillMaxWidth(),\n            colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.surface)\n        ) {\n            Column(modifier = Modifier.padding(16.dp)) {\n                Row(\n                    modifier = Modifier.fillMaxWidth(),\n                    horizontalArrangement = Arrangement.SpaceBetween,\n                    verticalAlignment = Alignment.CenterVertically\n                ) {\n                    Text(\n                        text = \"Depth of Discharge (DoD)\",\n                        fontWeight = FontWeight.Bold,\n                        style = MaterialTheme.typography.titleMedium\n                    )\n                    Text(\n                        text = \"${viewModel.depthOfDischargePercent.roundToInt()}%\",\n                        fontWeight = FontWeight.ExtraBold,\n                        color = if (viewModel.depthOfDischargePercent <= 80.0) BatteryFull else BatteryHalf,\n                        style = MaterialTheme.typography.titleMedium\n                    )\n                }\n\n                Spacer(modifier = Modifier.height(6.dp))\n                Text(\n                    \"Standard LFP chemistry degrades significantly faster if repeatedly discharged to 100%. Limiting to 80% is recommended for solar storage.\",\n                    style = MaterialTheme.typography.bodySmall,\n                    color = MaterialTheme.colorScheme.onSurfaceVariant\n                )\n\n                Spacer(modifier = Modifier.height(12.dp))\n\n                Slider(\n                    value = viewModel.depthOfDischargePercent.toFloat(),\n                    onValueChange = { viewModel.depthOfDischargePercent = it.roundToInt().toDouble() },\n                    valueRange = 10f..100f,\n                    modifier = Modifier.fillMaxWidth()\n                )\n\n                Spacer(modifier = Modifier.height(8.dp))\n\n                // Standard DoD Presets\n                Row(\n                    modifier = Modifier.fillMaxWidth(),\n                    horizontalArrangement = Arrangement.spacedBy(8.dp)\n                ) {\n                    val dops = listOf(\n                        80.0 to \"80% (Max Life)\",\n                        90.0 to \"90% (Balanced)\",\n                        100.0 to \"100% (Max Range)\"\n                    )\n                    dops.forEach { (dod, label) ->\n                        val selected = viewModel.depthOfDischargePercent == dod\n                        SuggestionChip(\n                            onClick = { viewModel.depthOfDischargePercent = dod },\n                            label = { Text(label, style = MaterialTheme.typography.bodySmall) },\n                            colors = SuggestionChipDefaults.suggestionChipColors(\n                                containerColor = if (selected) MaterialTheme.colorScheme.primaryContainer else Color.Transparent,\n                                labelColor = if (selected) MaterialTheme.colorScheme.onPrimaryContainer else MaterialTheme.colorScheme.onSurface\n                            ),\n                            modifier = Modifier\n                                .weight(1f)\n                                .testTag(\"preset_${dod.toInt()}_dod\")\n                        )\n                    }\n                }\n            }\n        }\n\n        // Action Buttons\n        Row(\n            modifier = Modifier.fillMaxWidth(),\n            horizontalArrangement = Arrangement.spacedBy(16.dp)\n        ) {\n            Button(\n                onClick = onSaveClicked,\n                modifier = Modifier\n                    .weight(1f)\n                    .height(50.dp)\n                    .testTag(\"save_config_button\"),\n                colors = ButtonDefaults.buttonColors(containerColor = MaterialTheme.colorScheme.primary)\n            ) {\n                Icon(Icons.Default.Save, contentDescription = null)\n                Spacer(modifier = Modifier.width(8.dp))\n                Text(\"Save Setup\", fontWeight = FontWeight.Bold)\n            }\n        }\n    }\n}\n\n// Appliance Load Run-Time Estimator Tab\n@Composable\nfun ApplianceLoadsTab(usableWh: Double) {\n    val scrollState = rememberScrollState()\n\n    val standardLoads = listOf(\n        ApplianceLoad(\"LED Bulbs\", 15, \"ic_lightbulb\", Icons.Default.Lightbulb, \"Essential illumination\"),\n        ApplianceLoad(\"Wi-Fi Router\", 20, \"ic_router\", Icons.Default.NetworkWifi, \"Stay connected\"),\n        ApplianceLoad(\"Smart TV\", 80, \"ic_tv\", Icons.Default.Tv, \"Entertainment system\"),\n        ApplianceLoad(\"Mini Fridge\", 60, \"ic_minifridge\", Icons.Default.Kitchen, \"Compact cooler\"),\n        ApplianceLoad(\"Full Refrigerator\", 150, \"ic_fridge\", Icons.Default.Kitchen, \"Family-size appliance\"),\n        ApplianceLoad(\"Microwave\", 1000, \"ic_microwave\", Icons.Default.SoupKitchen, \"Quick food heating\"),\n        ApplianceLoad(\"Power Tools\", 400, \"ic_drill\", Icons.Default.Construction, \"Workshop gear\"),\n        ApplianceLoad(\"Air Conditioner\", 1200, \"ic_ac\", Icons.Default.AcUnit, \"Climate cooling\")\n    )\n\n    Column(\n        modifier = Modifier\n            .fillMaxSize()\n            .verticalScroll(scrollState)\n            .padding(16.dp)\n    ) {\n        Text(\n            text = \"Appliance Load Simulator\",\n            style = MaterialTheme.typography.titleMedium,\n            fontWeight = FontWeight.Bold,\n            color = MaterialTheme.colorScheme.primary\n        )\n        Text(\n            text = \"Estimates run time based on your configured usable energy capacity of ${(usableWh / 1000.0).format(2)} kWh:\",\n            style = MaterialTheme.typography.bodySmall,\n            color = MaterialTheme.colorScheme.onSurfaceVariant,\n            modifier = Modifier.padding(bottom = 16.dp)\n        )\n\n        standardLoads.forEach { appliance ->\n            val hours = usableWh / appliance.wattage\n            val durationText = formatHours(hours)\n\n            Card(\n                modifier = Modifier\n                    .fillMaxWidth()\n                    .padding(bottom = 10.dp),\n                colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.surface)\n            ) {\n                Row(\n                    modifier = Modifier\n                        .fillMaxWidth()\n                        .padding(16.dp),\n                    verticalAlignment = Alignment.CenterVertically,\n                    horizontalArrangement = Arrangement.SpaceBetween\n                ) {\n                    Row(\n                        verticalAlignment = Alignment.CenterVertically,\n                        modifier = Modifier.weight(1f)\n                    ) {\n                        Surface(\n                            shape = RoundedCornerShape(8.dp),\n                            color = MaterialTheme.colorScheme.primaryContainer.copy(alpha = 0.4f),\n                            modifier = Modifier.size(44.dp)\n                        ) {\n                            Box(contentAlignment = Alignment.Center) {\n                                Icon(\n                                    imageVector = appliance.icon,\n                                    contentDescription = null,\n                                    tint = MaterialTheme.colorScheme.primary\n                                )\n                            }\n                        }\n                        Spacer(modifier = Modifier.width(12.dp))\n                        Column {\n                            Text(\n                                text = appliance.name,\n                                fontWeight = FontWeight.Bold,\n                                style = MaterialTheme.typography.bodyLarge\n                            )\n                            Text(\n                                text = \"${appliance.wattage} Watts \342\200\242 ${appliance.description}\",\n                                style = MaterialTheme.typography.bodySmall,\n                                color = MaterialTheme.colorScheme.onSurfaceVariant,\n                                maxLines = 1,\n                                overflow = TextOverflow.Ellipsis\n                            )\n                        }\n                    }\n\n                    Column(horizontalAlignment = Alignment.End) {\n                        Text(\n                            text = durationText,\n                            fontWeight = FontWeight.ExtraBold,\n                            color = MaterialTheme.colorScheme.primary,\n                            style = MaterialTheme.typography.titleMedium\n                        )\n                        Text(\n                            \"Est. Runtime\",\n                            style = MaterialTheme.typography.labelSmall,\n                            color = MaterialTheme.colorScheme.onSurfaceVariant\n                        )\n                    }\n                }\n            }\n        }\n    }\n}\n\ndata class ApplianceLoad(\n    val name: String,\n    val wattage: Int,\n    val iconKey: String,\n    val icon: ImageVector,\n    val description: String\n)\n\nprivate fun formatHours(hours: Double): String {\n    if (hours < 1.0) {\n        val minutes = (hours * 60).roundToInt()\n        return \"$minutes mins\"\n    }\n    val h = hours.toInt()\n    val m = ((hours - h) * 60).roundToInt()\n    return if (m == 0) \"${h}h\" else \"${h}h ${m}m\"\n}\n\nprivate fun Double.format(digits: Int) = String.format(Locale.getDefault(), \"%.${digits}f\", this)\n\n\n// Saved Systems History Tab\n@Composable\nfun SavedSystemsTab(\n    savedConfigs: List<BatteryConfig>,\n    onLoadConfig: (BatteryConfig) -> Unit,\n    onDeleteConfig: (Int) -> Unit\n) {\n    if (savedConfigs.isEmpty()) {\n        Box(\n            modifier = Modifier\n                .fillMaxSize()\n                .padding(32.dp),\n            contentAlignment = Alignment.Center\n        ) {\n            Column(\n                horizontalAlignment = Alignment.CenterHorizontally,\n                verticalArrangement = Arrangement.Center\n            ) {\n                Icon(\n                    imageVector = Icons.Default.History,\n                    contentDescription = null,\n                    modifier = Modifier.size(64.dp),\n                    tint = MaterialTheme.colorScheme.onSurfaceVariant.copy(alpha = 0.4f)\n                )\n                Spacer(modifier = Modifier.height(12.dp))\n                Text(\n                    text = \"No saved batteries\",\n                    fontWeight = FontWeight.Bold,\n                    style = MaterialTheme.typography.titleMedium,\n                    color = MaterialTheme.colorScheme.onSurfaceVariant\n                )\n                Text(\n                    text = \"Configure a battery pack, and save it to easily restore or compare systems.\",\n                    style = MaterialTheme.typography.bodySmall,\n                    textAlign = TextAlign.Center,\n                    color = MaterialTheme.colorScheme.onSurfaceVariant.copy(alpha = 0.7f),\n                    modifier = Modifier.padding(top = 4.dp)\n                )\n            }\n        }\n    } else {\n        LazyColumn(\n            modifier = Modifier\n                .fillMaxSize()\n                .padding(horizontal = 16.dp),\n            verticalArrangement = Arrangement.spacedBy(10.dp)\n        ) {\n            item {\n                Text(\n                    text = \"Saved Battery Designs\",\n                    style = MaterialTheme.typography.titleMedium,\n                    fontWeight = FontWeight.Bold,\n                    color = MaterialTheme.colorScheme.primary,\n                    modifier = Modifier.padding(vertical = 8.dp)\n                )\n            }\n\n            items(savedConfigs, key = { it.id }) { config ->\n                val nominalV = config.seriesCells * config.cellVoltage\n                val capacityAh = config.parallelCells * config.cellCapacityAh\n                val totalKwh = (nominalV * capacityAh) / 1000.0\n                val usableKwh = totalKwh * (config.depthOfDischargePercent / 100.0)\n\n                Card(\n                    modifier = Modifier\n                        .fillMaxWidth()\n                        .clickable { onLoadConfig(config) }\n                        .testTag(\"saved_config_item_${config.id}\"),\n                    colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.surface)\n                ) {\n                    Row(\n                        modifier = Modifier\n                            .fillMaxWidth()\n                            .padding(16.dp),\n                        verticalAlignment = Alignment.CenterVertically,\n                        horizontalArrangement = Arrangement.SpaceBetween\n                    ) {\n                        Column(modifier = Modifier.weight(1f)) {\n                            Text(\n                                text = config.name,\n                                fontWeight = FontWeight.Bold,\n                                style = MaterialTheme.typography.bodyLarge,\n                                color = MaterialTheme.colorScheme.onSurface\n                            )\n                            Spacer(modifier = Modifier.height(4.dp))\n                            Text(\n                                text = \"${config.seriesCells}S ${config.parallelCells}P \342\200\242 ${nominalV.format(1)}V \342\200\242 ${capacityAh.toInt()}Ah\",\n                                style = MaterialTheme.typography.bodySmall,\n                                color = MaterialTheme.colorScheme.onSurfaceVariant\n                            )\n                            Text(\n                                text = \"Usable: ${usableKwh.format(2)} kWh (${config.depthOfDischargePercent.roundToInt()}% DoD)\",\n                                style = MaterialTheme.typography.bodySmall,\n                                color = MaterialTheme.colorScheme.primary\n                            )\n                        }\n\n                        IconButton(\n                            onClick = { onDeleteConfig(config.id) },\n                            modifier = Modifier.testTag(\"delete_config_${config.id}\")\n                        ) {\n                            Icon(\n                                imageVector = Icons.Default.Delete,\n                                contentDescription = \"Delete design\",\n                                tint = MaterialTheme.colorScheme.error.copy(alpha = 0.8f)\n                            )\n                        }\n                    }\n                }\n            }\n        }\n    }\n}\n"
    }
