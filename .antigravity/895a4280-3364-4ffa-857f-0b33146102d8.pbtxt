        }
        lines {
          text: "        \"bn\" -> \"\360\237\224\213 \340\246\205\340\246\253-\340\246\227\340\247\215\340\246\260\340\246\277\340\246\241 \340\246\270\340\246\277\340\246\270\340\247\215\340\246\237\340\247\207\340\246\256 \340\246\227\340\246\276\340\246\207\340\246\241\340\246\262\340\246\276\340\246\207\340\246\250 (Off-Grid System)\""
