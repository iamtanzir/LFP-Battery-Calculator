          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                        val capWidth = 12.dp.toPx()"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                        val capHeight = 24.dp.toPx()"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                        val mainBodyWidth = size.width - capWidth - 8.dp.toPx()"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                        val mainBodyHeight = size.height"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                        // 1. Draw Battery Outer Border Container (Main Body)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                        drawRoundRect("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                            color = Color.LightGray.copy(alpha = 0.5f),"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                            size = Size(mainBodyWidth, mainBodyHeight),"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                            cornerRadius = CornerRadius(12.dp.toPx(), 12.dp.toPx()),"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                            style = Stroke(width = strokeWidth)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                        )"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                        // 2. Draw Battery Positive Terminal Cap (Right Side)"
