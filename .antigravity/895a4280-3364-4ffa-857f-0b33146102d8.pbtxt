        lines {
          text: "        \"de\" -> \"Off-Grid-Solarsysteme sind nicht an das Stromnetz angeschlossen. Sie sind autark. Tags\303\274ber Solarstrom, nachts Akkubetrieb.\""
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
