        lines {
          text: "        \"zh\" -> \"\345\271\266\347\275\221\347\263\273\347\273\237\347\233\264\346\216\245\344\270\216\345\205\254\345\205\261\347\224\265\347\275\221\345\215\217\345\220\214\345\267\245\344\275\234\343\200\202\347\231\275\345\244\251\344\272\247\347\224\237\347\232\204\345\244\232\344\275\231\347\224\265\345\212\233\351\200\232\350\277\207\345\207\200\350\256\241\351\207\217\345\207\272\345\217\243\345\233\236\347\224\265\347\275\221\343\200\202\""
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
