          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        // Cell choice section (From 15Ah to 314Ah)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
