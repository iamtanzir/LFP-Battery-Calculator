46\207\340\246\250 \340\246\217\340\246\226\340\246\276\340\246\250\340\247\207 \340\246\246\340\247\207\340\246\226\340\246\244\340\247\207 \340\246\252\340\246\276\340\246\254\340\247\207\340\246\250\340\245\244\",\n                        style = MaterialTheme.typography.bodySmall,\n                        textAlign = TextAlign.Center,\n                        color = MaterialTheme.colorScheme.onSurfaceVariant\n                    )\n                }\n            }\n        }\n    }\n}"
        replacement_content: "// TAB 3: Solar installation advisor guidelines & Bills of materials\n@Composable\nfun SolarGridGuideTab(viewModel: BatteryViewModel) {\n    val scrollState = rememberScrollState()\n    val t = { key: String -> BatteryLocalizer.get(key, viewModel.appLanguage) }\n\n    val advantagesLabel = when (viewModel.appLanguage) {\n        \"bn\" -> \"\340\246\270\340\247\201\340\246\254\340\246\277\340\246\247\340\246\276\340\246\270\340\246\256\340\247\202\340\246\271 (Advantages):\"\n        \"zh\" -> \"\344\274\230\345\212\277 (Advantages):\"\n        \"de\" -> \"Vorteile (Advantages):\"\n        \"ko\" -> \"\354\236\245\354\240\220 (Advantages):\"\n        else -> \"Advantages:\"\n    }\n    val disadvantagesLabel = when (viewModel.appLanguage) {\n        \"bn\" -> \"\340\246\205\340\246\270\340\247\201\340\246\254\340\246\277\340\246\247\340\246\276\340\246\270\340\246\256\340\247\202\340\246\271 (Disadvantages):\"\n        \"zh\" -> \"\345\212\243\345\212\277 (Disadvantages):\"\n        \"de\" -> \"Nachteile (Disadvantages):\"\n        \"ko\" -> \"\353\213\250\354\240\220 (Disadvantages):\"\n        else -> \"Disadvantages:\"\n    }\n\n    val offgridTitle = when (viewModel.appLanguage) {\n        \"bn\" -> \"\360\237\224\213 \340\246\205\340\246\253-\340\246\227\340\247\215\340\246\260\340\246\277\340\246\241 \340\246\270\340\246\277\340\246\270\340\247\215\340\246\237\340\247\207\340\246\256 \340\246\227\340\246\276\340\246\207\340\246\241\340\246\262\340\246\276\340\246\207\340\246\250 (Off-Grid System)\"\n        \"zh\" -> \"\360\237\224\213 \347\246\273\347\275\221\347\263\273\347\273\237\346\214\207\345\215\227 (Off-Grid System)\"\n        \"de\" -> \"\360\237\224\213 Off-Grid System Richtlinien\"\n        \"ko\" -> \"\360\237\224\213 \354\230\244\355\224\204\352\267\270\353\246\254\353\223\234 \354\213\234\354\212\244\355\205\234 \352\260\200\354\235\264\353\223\234\353\235\274\354\235\270\"\n        else -> \"\360\237\224\213 Off-Grid System Guidelines\"\n    }\n    val offgridDesc = when (viewModel.appLanguage) {\n        \"bn\" -> \"\340\246\205\340\246\253-\340\246\227\340\247\215\340\246\260\340\246\277\340\246\241 \340\246\270\340\247\213\340\246\262\340\246\276\340\246\260 \340\246\270\340\246\277\340\246\270\340\247\215\340\246\237\340\247\207\340\246\256 \340\246\227\340\247\215\340\246\260\340\246\277\340\246\241 \340\246\254\340\246\276 \340\246\234\340\246\276\340\246\244\340\247\200\340\247\237 \340\246\254\340\246\277\340\246\246\340\247\215\340\246\257\340\247\201\340\247\216 \340\246\262\340\246\276\340\246\207\340\246\250\340\247\207\340\246\260 \340\246\270\340\246\276\340\246\245\340\247\207 \340\246\257\340\247\201\340\246\225\340\247\215\340\246\244 \340\246\245\340\246\276\340\246\225\340\247\207 \340\246\250\340\246\276\340\245\244 \340\246\217\340\246\237\340\246\277 \340\246\270\340\246\256\340\247\215\340\246\252\340\247\202\340\246\260\340\247\215\340\246\243 \340\246\270\340\247\215\340\246\254\340\247\237\340\246\202\340\246\270\340\246\256\340\247\215\340\246\252\340\247\202\340\246\260\340\247\215\340\246\243\340\245\244 \340\246\246\340\246\277\340\246\250\340\247\207 \340\246\270\340\247\213\340\246\262\340\246\276\340\246\260 \340\246\223 \340\246\260\340\246\276\340\246\244\340\247\207 \340\246\254\340\247\215\340\246\257\340\246\276\340\246\237\340\246\276\340\246\260\340\246\277\340\246\260 \340\246\256\340\246\276\340\246\247\340\247\215\340\246\257\340\246\256\340\247\207 \340\246\262\340\247\213\340\246\241 \340\246\232\340\246\276\340\246\262\340\246\276\340\246\250\340\247\213 \340\246\271\340\247\237\340\245\244\"\n        \"zh\" -> \"\347\246\273\347\275\221\345\244\252\351\230\263\350\203\275\347\263\273\347\273\237\344\270\215\350\277\236\346\216\245\347\224\265\347\275\221\357\274\214\345\256\214\345\205\250\347\213\254\347\253\213\350\277\220\350\241\214\343\200\202\347\231\275\345\244\251\347\224\261\345\244\252\351\230\263\350\203\275\344\276\233\347\224\265\357\274\214\345\244\234\351\227\264\347\224\261\347\224\265\346\261\240\347\273\204\344\276\233\347\224\265\343\200\202\"\n        \"de\" -> \"Off-Grid-Solarsysteme sind nicht an das Stromnetz angeschlossen. Sie sind autark. Tags\303\274ber Solarstrom, nachts Akkubetrieb.\"\n        \"ko\" -> \"\354\230\244\355\224\204\352\267\270\353\246\254\353\223\234 \355\203\234\354\226\221\352\264\221 \354\213\234\354\212\244\355\205\234\354\235\200 \354\240\204\353\240\245\353\247\235\352\263\274 \354\227\260\352\262\260\353\220\230\354\247\200 \354\225\212\354\235\200 \354\236\220\353\246\275\355\230\225 \354\213\234\354\212\244\355\205\234\354\236\205\353\213\210\353\213\244. \353\202\256\354\227\220\353\212\224 \355\203\234\354\226\221\352\264\221\354\234\274\353\241\234, \353\260\244\354\227\220\353\212\224 \353\260\260\355\204\260\353\246\254\353\241\234 \354\240\204\353\240\245\354\235\204 \352\263\265\352\270\211\355\225\251\353\213\210\353\213\244.\"\n        else -> \"Off-grid solar systems are fully independent from the utility grid. Daytime loads run on solar, and nighttime is sustained by battery packs.\"\n    }\n    val offgridAdv1 = when (viewModel.appLanguage) {\n        \"bn\" -> \"\340\246\234\340\246\276\340\246\244\340\247\200\340\246\257\340\246\274 \340\246\227\340\247\215\340\246\260\340\246\277\340\246\241\340\247\207\340\246\260 \340\246\262\340\247\213\340\246\241\340\246\266\340\247\207\340\246\241\340\246\277\340\246\202 \340\246\245\340\247\207\340\246\225\340\247\207 \340\247\247\340\247\246\340\247\246% \340\246\256\340\247\201\340\246\225\340\247\215\340\246\244\340\246\277\340\245\244\"\n        \"zh\" -> \"100% \346\221\206\350\204\261\347\224\265\347\275\221\345\201\234\347\224\265\347\232\204\345\275\261\345\223\215\343\200\202\"\n        \"de\" -> \"100% Unabh\303\244ngigkeit von Netzausf\303\244llen.\"\n        \"ko\" -> \"\354\240\204\353\240\245\353\247\235 \354\240\225\354\240\204\354\234\274\353\241\234\353\266\200\355\204\260 100% \354\236\220\353\246\275.\"\n        else -> \"100% protection from utility grid load-shedding and power cuts.\"\n    }\n    val offgridAdv2 = when (viewModel.appLanguage) {\n        \"bn\" -> \"\340\246\254\340\246\277\340\246\246\340\247\215\340\246\257\340\247\201\340\247\216 \340\246\254\340\246\277\340\246\262 \340\246\270\340\246\256\340\247\215\340\246\252\340\247\202\340\246\260\340\247\215\340\246\243 \340\246\266\340\247\202\340\246\250\340\247\215\340\246\257 \340\246\237\340\246\276\340\246\225\340\246\276\340\247\237 \340\246\250\340\246\276\340\246\256\340\246\277\340\247\237\340\247\207 \340\246\206\340\246\250\340\246\276 \340\246\270\340\246\256\340\247\215\340\246\255\340\246\254\340\245\244\"\n        \"zh\" -> \"\345\217\257\344\273\245\345\260\206\347\224\265\350\264\271\351\231\215\350\207\263\351\233\266\343\200\202\"\n        \"de\" -> \"Stromkosten k\303\266nnen komplett auf Null gesenkt werden.\"\n        \"ko\" -> \"\354\240\204\352\270\260 \354\232\224\352\270\210\354\235\204 \354\231\204\354\240\204\355\236\210 0\354\233\220\354\234\274\353\241\234 \354\244\204\354\235\274 \354\210\230 \354\236\210\354\212\265\353\213\210\353\213\244.\"\n        else -> \"Completely eliminate monthly electricity utility bills.\"\n    }\n    val offgridAdv3 = when (viewModel.appLanguage) {\n        \"bn\" -> \"\340\246\252\340\246\276\340\246\271\340\246\276\340\247\234\340\246\277, \340\246\227\340\247\215\340\246\260\340\246\276\340\246\256\340\247\200\340\246\243 \340\246\254\340\246\276 \340\246\252\340\247\215\340\246\260\340\246\244\340\247\215\340\246\257\340\246\250\340\247\215\340\246\244 \340\246\205\340\246\236\340\247\215\340\246\232\340\246\262\340\247\207 \340\246\257\340\247\207\340\246\226\340\246\276\340\246\250\340\247\207 \340\246\254\340\246\277\340\246\246\340\247\215\340\246\257\340\247\201\340\247\216 \340\246\250\340\247\207\340\246\207 \340\246\270\340\247\207\340\246\226\340\246\276\340\246\250\340\247\207 \340\246\270\340\247\207\340\246\260\340\246\276 \340\246\270\340\246\256\340\246\276\340\246\247\340\246\276\340\246\250\340\245\244\"\n        \"zh\" -> \"\346\227\240\347\224\265\347\232\204\345\261\261\345\214\272\343\200\201\345\206\234\346\235\221\346\210\226\345\201\217\350\277\234\345\234\260\345\214\272\347\232\204\346\234\200\344\275\263\350\247\243\345\206\263\346\226\271\346\241\210\343\200\202\"\n        \"de\" -> \"Ideale L\303\266sung f\303\274r abgelegene Gebiete ohne Netzanschluss.\"\n        \"ko\" -> \"\354\240\204\353\240\245\353\247\235\354\235\264 \354\227\206\353\212\224 \354\230\244\354\247\200, \354\202\260\352\260\204 \354\247\200\354\227\255\354\235\204 \354\234\204\355\225\234 \354\265\234\352\263\240\354\235\230 \354\206\224\353\243\250\354\205\230.\"\n        else -> \"Best solution for remote, rural, or off-grid locations without grid access.\"\n    }\n    val offgridDis1 = when (viewModel.appLanguage) {\n        \"bn\" -> \"\340\246\252\340\247\215\340\246\260\340\246\276\340\246\245\340\246\256\340\246\277\340\246\225 \340\246\270\340\247\207\340\246\237\340\246\206\340\246\252 \340\246\226\340\246\260\340\246\232 \340\246\254\340\247\207\340\246\266\340\246\277 (\340\246\254\340\247\215\340\246\257\340\246\276\340\246\237\340\246\276\340\246\260\340\246\277 \340\246\225\340\246\277\340\246\250\340\246\244\340\247\207 \340\246\271\340\247\237)\340\245\244\"\n        \"zh\" -> \"\345\210\235\345\247\213\345\256\211\350\243\205\346\210\220\346\234\254\351\253\230\357\274\210\351\234\200\350\246\201\350\264\255\344\271\260\347\224\265\346\261\240\347\273\204\357\274\211\343\200\202\"\n        \"de\" -> \"H\303\266here Anfangsinvestition (Batteriespeicher erforderlich).\"\n        \"ko\" -> \"\354\264\210\352\270\260 \354\204\244\354\271\230 \353\271\204\354\232\251\354\235\264 \353\206\222\354\212\265\353\213\210\353\213\244 (\353\260\260\355\204\260\353\246\254 \355\214\251 \352\265\254\353\247\244 \355\225\204\354\232\224).\"\n        else -> \"High initial setup cost due to battery storage requirements.\"\n    }\n    val offgridDis2 = when (viewModel.appLanguage) {\n        \"bn\" -> \"\340\246\237\340\246\276\340\246\250\340\246\276 \340\246\225\340\247\237\340\247\207\340\246\225\340\246\246\340\246\277\340\246\250 \340\246\254\340\247\203\340\246\267\340\247\215\340\246\237\340\246\277 \340\246\254\340\246\276 \340\246\256\340\247\207\340\246\230\340\246\262\340\246\276 \340\246\245\340\246\276\340\246\225\340\246\262\340\247\207 \340\246\254\340\247\215\340\246\257\340\246\276\340\246\225\340\246\206\340\246\252\340\247\207 \340\246\270\340\246\256\340\246\270\340\247\215\340\246\257\340\246\276 \340\246\271\340\246\244\340\247\207 \340\246\252\340\246\276\340\246\260\340\247\207\340\245\244\"\n        \"zh\" -> \"\350\277\236\347\273\255\351\230\264\351\233\250\345\244\251\345\217\257\350\203\275\344\274\232\345\275\261\345\223\215\345\220\216\345\244\207\347\224\265\346\272\220\343\200\202\"\n        \"de\" -> \"Eingeschr\303\244nkte Leistung bei tagelangem Regen oder Bew\303\266lkung.\"\n        \"ko\" -> \"\354\236\245\352\270\260\352\260\204 \355\235\220\353\246\254\352\261\260\353\202\230 \353\271\204\352\260\200 \354\230\244\353\251\264 \353\260\261\354\227\205 \353\254\270\354\240\234\352\260\200 \353\260\234\354\203\235\355\225\240 \354\210\230 \354\236\210\354\212\265\353\213\210\353\213\244.\"\n        else -> \"Requires careful management during consecutive rainy or cloudy days.\"\n    }\n\n    val ongridTitle = when (viewModel.appLanguage) {\n        \"bn\" -> \"\342\232\241 \340\246\205\340\246\250-\340\246\227\340\247\215\340\246\260\340\246\277\340\246\241 \340\246\250\340\247\207\340\246\237 \340\246\256\340\246\277\340\246\237\340\246\276\340\246\260\340\246\277\340\246\202 \340\246\270\340\246\277\340\246\270\340\247\215\340\246\237\340\247\207\340\246\256 (On-Grid System)\"\n        \"zh\" -> \"\342\232\241 \345\271\266\347\275\221\345\207\200\350\256\241\351\207\217\347\263\273\347\273\237 (On-Grid System)\"\n        \"de\" -> \"\342\232\241 On-Grid Net-Metering System\"\n        \"ko\" -> \"\342\232\241 \354\230\250\352\267\270\353\246\254\353\223\234 \352\263\204\355\206\265\354\227\260\352\263\204\355\230\225 \354\213\234\354\212\244\355\205\234\"\n        else -> \"\342\232\241 On-Grid Net-Metering System\"\n    }\n    val ongridDesc = when (viewModel.appLanguage) {\n        \"bn\" -> \"\340\246\205\340\246\250-\340\246\227\340\247\215\340\246\260\340\246\277\340\246\241 \340\246\270\340\246\277\340\246\270\340\247\215\340\246\237\340\247\207\340\246\256 \340\246\270\340\246\260\340\246\276\340\246\270\340\246\260\340\246\277 \340\246\206\340\246\252\340\246\250\340\246\276\340\246\260 \340\246\254\340\246\276\340\247\234\340\246\277\340\246\260 \340\246\227\340\247\215\340\246\260\340\246\277\340\246\241 \340\246\254\340\246\276 \340\246\270\340\246\260\340\246\225\340\246\276\340\246\260\340\246\277 \340\246\254\340\246\277\340\246\246\340\247\215\340\246\257\340\247\201\340\247\216 \340\246\262\340\246\276\340\246\207\340\246\250\340\247\207\340\246\260 \340\246\270\340\246\276\340\246\245\340\247\207 \340\246\225\340\246\276\340\246\234 \340\246\225\340\246\260\340\247\207\340\245\244 \340\246\246\340\246\277\340\246\250\340\247\207 \340\246\211\340\247\216\340\246\252\340\246\276\340\246\246\340\246\277\340\246\244 \340\246\205\340\246\244\340\246\277\340\246\260\340\246\277\340\246\225\340\247\215\340\246\244 \340\246\254\340\246\277\340\246\246\340\247\215\340\246\257\340\247\201\340\247\216 \340\246\234\340\246\276\340\246\244\340\247\200\340\247\237 \340\246\227\340\247\215\340\246\260\340\246\277\340\246\241\340\247\207 \340\246\260\340\246\252\340\247\215\340\246\244\340\246\276\340\246\250\340\246\277 (Export) \340\246\271\340\247\237 \340\246\250\340\247\207\340\246\237 \340\246\256\340\246\277\340\246\237\340\246\276\340\246\260\340\246\277\340\246\202\340\247\237\340\247\207\340\246\260 \340\246\256\340\246\276\340\246\247\340\247\215\340\246\257\340\246\256\340\247\207\340\245\244\"\n        \"zh\" -> \"\345\271\266\347\275\221\347\263\273\347\273\237\347\233\264\346\216\245\344\270\216\345\205\254\345\205\261\347\224\265\347\275\221\345\215\217\345\220\214\345\267\245\344\275\234\343\200\202\347\231\275\345\244\251\344\272\247\347\224\237\347\232\204\345\244\232\344\275\231\347\224\265\345\212\233\351\200\232\350\277\207\345\207\200\350\256\241\351\207\217\345\207\272\345\217\243\345\233\236\347\224\265\347\275\221\343\200\202\"\n        \"de\" -> \"On-Grid-Systeme arbeiten direkt mit Ihrem Stromnetz zusammen. \303\234bersch\303\274ssige Energie wird \303\274ber Net-Metering eingespeist.\"\n        \"ko\" -> \"\352\263\204\355\206\265\354\227\260\352\263\204\355\230\225 \354\213\234\354\212\244\355\205\234\354\235\200 \354\240\204\353\240\245\353\247\235\352\263\274 \354\227\260\353\217\231\355\225\230\354\227\254 \354\236\221\353\217\231\355\225\251\353\213\210\353\213\244. \353\202\256 \353\217\231\354\225\210 \354\203\235\354\202\260\353\220\234 \354\227\254\353\266\204\354\235\230 \354\240\204\352\270\260\353\212\224 \352\263\204\355\206\265\354\204\240\354\234\274\353\241\234 \354\227\255\354\206\241\354\266\234\353\220\251\353\213\210\353\213\244.\"\n        else -> \"On-grid systems operate in direct sync with the utility provider. Extra solar electricity generated during day is exported back via net-metering.\"\n    }\n    val ongridAdv1 = when (viewModel.appLanguage) {\n        \"bn\" -> \"\340\246\270\340\246\254\340\246\232\340\247\207\340\247\237\340\247\207 \340\246\225\340\246\256 \340\246\226\340\246\260\340\246\232\340\247\207 \340\246\270\340\247\207\340\246\237\340\246\206\340\246\252 \340\246\225\340\246\260\340\246\276 \340\246\257\340\246\276\340\247\237 (\340\246\254\340\247\215\340\246\257\340\246\276\340\246\237\340\246\276\340\246\260\340\246\277\340\246\260 \340\246\252\340\247\215\340\246\260\340\247\237\340\247\213\340\246\234\340\246\250 \340\246\271\340