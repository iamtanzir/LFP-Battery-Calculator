    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "// TAB 1: Household Appliance selection and Load calculator\n@Composable\nfun ApplianceSelectionTab(\n    viewModel: BatteryViewModel,\n    onProceedToSetup: () -> Unit\n) {\n    val scrollState = rememberScrollState()\n\n    Column(\n        modifier = Modifier\n            .fillMaxSize()\n            .verticalScroll(scrollState)\n            .padding(12.dp),\n        verticalArrangement = Arrangement.spacedBy(12.dp)\n    ) {\n        // Bengali Subheader introducing the section\n        Card(\n            colors = CardDefaults.cardColors(\n                containerColor = MaterialTheme.colorScheme.primaryContainer.copy(alpha = 0.15f)\n            ),\n            modifier = Modifier.fillMaxWidth()\n        ) {\n            Column(modifier = Modifier.padding(12.dp)) {\n                Text(\n                    text = \"\340\246\254\340\246\276\340\246\270\340\246\276\340\247\237 \340\246\254\340\247\215\340\246\257\340\246\254\340\246\271\340\247\203\340\246\244 \340\246\262\340\247\213\340\246\241 \340\246\270\340\246\277\340\246\262\340\247\207\340\246\225\340\246\266\340\246\250 \340\246\225\340\246\260\340\247\201\340\246\250 \360\237\222\241\",\n                    fontWeight = FontWeight.Bold,\n                    style = MaterialTheme.typography.bodyLarge,\n                    color = MaterialTheme.colorScheme.primary\n                )\n                Text(\n                    text = \"\340\246\206\340\246\252\340\246\250\340\246\276\340\246\260 \340\246\254\340\246\276\340\247\234\340\246\277\340\246\244\340\247\207 \340\246\270\340\246\232\340\246\260\340\246\276\340\246\232\340\246\260 \340\246\254\340\247\215\340\246\257\340\246\254\340\246\271\340\247\203\340\246\244 \340\246\207\340\246\262\340\247\207\340\246\225\340\246\237\340\247\215\340\246\260\340\246\250\340\246\277\340\246\225 \340\246\270\340\246\276\340\246\256\340\246\227\340\247\215\340\246\260\340\247\200 \340\246\223 \340\246\252\340\247\215\340\246\260\340\247\237\340\247\213\340\246\234\340\246\250\340\247\200\340\247\237 \340\246\254\340\247\215\340\246\257\340\246\276\340\246\225\340\246\206\340\246\252\340\247\207\340\246\260 \340\246\270\340\246\256\340\247\237 \340\246\250\340\246\277\340\246\260\340\247\215\340\246\254\340\246\276\340\246\232\340\246\250 \340\246\225\340\246\260\340\247\201\340\246\250\340\245\244 \340\246\270\340\246\277\340\246\270\340\247\215\340\246\237\340\247\207\340\246\256 \340\246\205\340\246\237\340\247\213\340\246\256\340\247\207\340\246\237\340\246\277\340\246\225 \340\246\223\340\247\237\340\246\276\340\246\237, \340\246\252\340\246\277\340\246\225 \340\246\262\340\247\213\340\246\241 \340\246\223 \340\246\270\340\246\240\340\246\277\340\246\225 \340\246\225\340\247\215\340\246\257\340\246\276\340\246\254\340\246\262 \340\246\271\340\246\277\340\246\270\340\247\207\340\246\254 \340\246\225\340\246\260\340\246\254\340\247\207\340\245\244\",\n                    style = MaterialTheme.typography.bodySmall,\n                    color = MaterialTheme.colorScheme.onSurfaceVariant\n                )\n            }\n        }\n\n        // Global Target Backup Hours Card\n        Card(\n            modifier = Modifier.fillMaxWidth(),\n            colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.surface)\n        ) {\n            Column(modifier = Modifier.padding(16.dp)) {\n                Row(\n                    modifier = Modifier.fillMaxWidth(),\n                    horizontalArrangement = Arrangement.SpaceBetween,\n                    verticalAlignment = Alignment.CenterVertically\n                ) {\n                    Text(\n                        text = \"\340\246\254\340\247\215\340\246\257\340\246\276\340\246\225\340\246\206\340\246\252 \340\246\252\340\246\276\340\246\223\340\247\237\340\246\276\340\246\260\340\247\207\340\246\260 \340\246\237\340\246\276\340\246\260\340\247\215\340\246\227\340\247\207\340\246\237 \340\246\270\340\246\256\340\247\237\",\n                        fontWeight = FontWeight.Bold,\n                        style = MaterialTheme.typography.bodyLarge\n                    )\n                    Text(\n                        text = \"${viewModel.targetBackupHours.roundToInt()} \340\246\230\340\246\243\340\247\215\340\246\237\340\246\276\",\n                        fontWeight = FontWeight.ExtraBold,\n                        color = MaterialTheme.colorScheme.primary,\n                        style = MaterialTheme.typography.titleLarge\n                    )\n                }\n                Slider(\n                    value = viewModel.targetBackupHours.toFloat(),\n                    onValueChange = { viewModel.targetBackupHours = it.roundToInt().toDouble() },\n                    valueRange = 1f..24f,\n                    steps = 22,\n                    modifier = Modifier.fillMaxWidth()\n                )\n                Row(\n                    modifier = Modifier.fillMaxWidth(),\n                    horizontalArrangement = Arrangement.SpaceBetween\n                ) {\n                    Text(\"\340\247\247 \340\246\230\340\246\243\340\247\215\340\246\237\340\246\276\", style = MaterialTheme.typography.bodySmall, color = Color.Gray)\n                    Text(\"\340\247\247\340\247\250 \340\246\230\340\246\243\340\247\215\340\246\237\340\246\276\", style = MaterialTheme.typography.bodySmall, color = Color.Gray)\n                    Text(\"\340\247\250\340\247\252 \340\246\230\340\246\243\340\247\215\340\246\237\340\246\276\", style = MaterialTheme.typography.bodySmall, color = Color.Gray)\n                }\n            }\n        }\n\n        // List of household appliances with Counter Controls\n        Text(\n            text = \"\340\246\241\340\246\277\340\246\255\340\246\276\340\246\207\340\246\270 \340\246\244\340\246\276\340\246\262\340\246\277\340\246\225\340\246\276 \340\246\223 \340\246\270\340\246\202\340\246\226\340\247\215\340\246\257\340\246\276\",\n            fontWeight = FontWeight.Bold,\n            style = MaterialTheme.typography.titleMedium,\n            modifier = Modifier.padding(horizontal = 4.dp, vertical = 2.dp)\n        )\n\n        viewModel.standardAppliances.forEach { appliance ->\n            val quantity = viewModel.applianceQuantities[appliance.id] ?: 0\n\n            Card(\n                modifier = Modifier.fillMaxWidth(),\n                colors = CardDefaults.cardColors(\n                    containerColor = if (quantity > 0) MaterialTheme.colorScheme.primaryContainer.copy(alpha = 0.15f) else MaterialTheme.colorScheme.surface\n                ),\n                border = if (quantity > 0) borderStroke(1.dp, MaterialTheme.colorScheme.primary.copy(alpha = 0.3f)) else null\n            ) {\n                Row(\n                    modifier = Modifier\n                        .fillMaxWidth()\n                        .padding(12.dp),\n                    verticalAlignment = Alignment.CenterVertically,\n                    horizontalArrangement = Arrangement.SpaceBetween\n                ) {\n                    // Left side details\n                    Row(\n                        verticalAlignment = Alignment.CenterVertically,\n                        modifier = Modifier.weight(1f)\n                    ) {\n                        // Dynamic Material Icons\n                        val iconVector = when (appliance.iconName) {\n                            \"lightbulb\" -> Icons.Default.Lightbulb\n                            \"mode_fan\" -> Icons.Default.Air\n                            \"tv\" -> Icons.Default.Tv\n                            \"router\" -> Icons.Default.Router\n                            \"kitchen\" -> Icons.Default.Kitchen\n                            \"water\" -> Icons.Default.WaterDrop\n                            \"ac_unit\" -> Icons.Default.AcUnit\n                            \"laptop\" -> Icons.Default.Laptop\n                            \"microwave\" -> Icons.Default.SoupKitchen\n                            else -> Icons.Default.Smartphone\n                        }\n\n                        Surface(\n                            shape = RoundedCornerShape(8.dp),\n                            color = MaterialTheme.colorScheme.secondaryContainer.copy(alpha = 0.4f),\n                            modifier = Modifier.size(40.dp)\n                        ) {\n                            Box(contentAlignment = Alignment.Center) {\n                                Icon(\n                                    imageVector = iconVector,\n                                    contentDescription = null,\n                                    tint = MaterialTheme.colorScheme.primary,\n                                    modifier = Modifier.size(22.dp)\n                                )\n                            }\n                        }\n\n                        Spacer(modifier = Modifier.width(10.dp))\n\n                        Column {\n                            Text(\n                                text = appliance.nameBn,\n                                fontWeight = FontWeight.Bold,\n                                style = MaterialTheme.typography.bodyLarge\n                            )\n                            Text(\n                                text = \"${appliance.nominalWatts.toInt()} \340\246\223\340\246\257\340\246\274\340\246\276\340\246\237 \342\200\242 \340\246\270\340\247\215\340\246\237\340\246\276\340\246\260\340\247\215\340\246\237\340\246\206\340\246\252 \340\246\270\340\246\276\340\246\260\340\247\215\340\246\234: ${appliance.surgeMultiplier}x\",\n                                style = MaterialTheme.typography.bodySmall,\n                                color = MaterialTheme.colorScheme.onSurfaceVariant\n                            )\n                        }\n                    }\n\n                    // Right side counters\n                    Row(\n                        verticalAlignment = Alignment.CenterVertically,\n                        horizontalArrangement = Arrangement.spacedBy(8.dp)\n                    ) {\n                        IconButton(\n                            onClick = { viewModel.decrementAppliance(appliance.id) },\n                            colors = IconButtonDefaults.iconButtonColors(\n                                containerColor = MaterialTheme.colorScheme.surfaceVariant\n                            ),\n                            modifier = Modifier.size(32.dp)\n                        ) {\n                            Icon(Icons.Default.Remove, contentDescription = \"Decrement\", modifier = Modifier.size(16.dp))\n                        }\n\n                        Text(\n                            text = quantity.toString(),\n                            fontWeight = FontWeight.Bold,\n                            fontSize = 16.sp,\n                            modifier = Modifier.widthIn(min = 20.dp),\n                            textAlign = TextAlign.Center\n                        )\n\n                        IconButton(\n                            onClick = { viewModel.incrementAppliance(appliance.id) },\n                            colors = IconButtonDefaults.iconButtonColors(\n                                containerColor = MaterialTheme.colorScheme.primaryContainer\n                            ),\n                            modifier = Modifier.size(32.dp)\n                        ) {\n                            Icon(Icons.Default.Add, contentDescription = \"Increment\", modifier = Modifier.size(16.dp))\n                        }\n                    }\n                }\n            }\n        }\n\n        // Dynamic Calculations Results Panel\n        if (viewModel.totalRunningWatts > 0) {\n            Card(\n                colors = CardDefaults.cardColors(\n                    containerColor = MaterialTheme.colorScheme.surfaceVariant.copy(alpha = 0.5f)\n                ),\n                modifier = Modifier\n                    .fillMaxWidth()\n                    .padding(vertical = 4.dp),\n                shape = RoundedCornerShape(12.dp)\n            ) {\n                Column(modifier = Modifier.padding(16.dp)) {\n                    Text(\n                        text = \"\360\237\223\212 \340\246\262\340\247\213\340\246\241\340\247\207\340\246\260 \340\246\271\340\246\277\340\246\270\340\246\276\340\246\254 \340\246\223 \340\246\227\340\246\276\340\246\207\340\246\241\340\246\262\340\246\276\340\246\207\340\246\250 (Real-time Report)\",\n                        fontWeight = FontWeight.Bold,\n                        style = MaterialTheme.typography.titleMedium,\n                        color = MaterialTheme.colorScheme.primary\n                    )\n                    Spacer(modifier = Modifier.height(10.dp))\n\n                    Row(\n                        modifier = Modifier.fillMaxWidth(),\n                        horizontalArrangement = Arrangement.SpaceBetween\n                    ) {\n                        Text(\"\340\246\256\340\247\213\340\246\237 \340\246\232\340\246\262\340\246\256\340\246\276\340\246\250 \340\246\262\340\247\213\340\246\241:\", style = MaterialTheme.typography.bodyMedium)\n                        Text(\n                            \"${viewModel.totalRunningWatts.toInt()} Watts\",\n                            fontWeight = FontWeight.Bold,\n                            style = MaterialTheme.typography.bodyMedium\n                        )\n                    }\n\n                    Row(\n                        modifier = Modifier.fillMaxWidth().padding(top = 4.dp),\n                        horizontalArrangement = Arrangement.SpaceBetween\n                    ) {\n                        Text(\"\340\246\252\340\246\277\340\246\225 \340\246\270\340\246\276\340\246\260\340\247\215\340\246\234 \340\246\262\340\247\213\340\246\241 (\340\247\247\340\247\246 \340\246\270\340\247\207\340\246\225\340\247\207\340\246\250\340\247\215\340\246\241):\", style = MaterialTheme.typography.bodyMedium)\n                        Text(\n                            \"${viewModel.peakSurgeWatts.toInt()} Watts\",\n                            fontWeight = FontWeight.Bold,\n                            color = Color(0xFFE64A19),\n                            style = MaterialTheme.typography.bodyMedium\n                        )\n                    }\n\n                    Row(\n                        modifier = Modifier.fillMaxWidth().padding(top = 4.dp),\n                        horizontalArrangement = Arrangement.SpaceBetween\n                    ) {\n                        Text(\"\340\246\252\340\247\215\340\246\260\340\247\237\340\247\213\340\246\234\340\246\250\340\247\200\340\247\237 \340\246\266\340\246\225\340\247\215\340\246\244\340\246\277 (Wh):\", style = MaterialTheme.typography.bodyMedium)\n                        Text(\n                            \"${viewModel.targetRequiredEnergyWh.toInt()} Wh (${(viewModel.targetRequiredEnergyWh / 1000.0).format(2)} kWh)\",\n                            fontWeight = FontWeight.Bold,\n                            style = MaterialTheme.typography.bodyMedium\n                        )\n                    }\n\n                    HorizontalDivider(modifier = Modifier.padding(vertical = 8.dp))\n\n                    // Status analysis compared with configured battery size\n                    val batterySufficiency = viewModel.capacitySufficiencyStatus\n                    val statusText = when (batterySufficiency) {\n                        \"OPTIMAL\" -> \"\340\246\205\340\246\244\340\246\277\340\246\260\340\246\277\340\246\225\340\247\215\340\246\244 \340\246\254\340\247\215\340\246\257\340\246\276\340\246\225\340\246\206\340\246\252 \340\246\247\340\246\276\340\246\260\340\246\243\340\246\225\340\247\215\340\246\267\340\246\256\340\246\244\340\246\276 \340\246\206\340\246\233\340\247\207! (Optimal & Safe)\"\n                        \"SUFFICIENT\" -> \"\340\246\252\340\247\215\340\246\257\340\246\276\340\246\225 \340\246\247\340\246\276\340\246\260\340\246\243\340\246\225\340\247\215\340\246\267\340\246\256\340\246\244\340\246\276 \340\246\252\340\246\260\340\247\215\340\246\257\340\246\276\340\246\252\340\247\215\340\246\244! (Sufficient)\"\n                        \"LOW\" -> \"\340\246\254\340\247\215\340\246\257\340\246\276\340\246\237\340\246\276\340\246\260\340\246\277 \340\246\247\340\246\276\340\246\260\340\246\243\340\246\225\340\247\215\340\246\267\340\246\256\340\246\244\340\246\276 \340\246\225\340\246\256 (\340\246\254\340\247\215\340\246\257\340\246\276\340\246\225\340\246\206\340\246\252 \340\246\270\340\246\256\340\247\237 \340\246\225\340\246\256\340\247\207 \340\246\257\340\246\276\340\246\254\340\247\207)\"\n                        else -> \"\340\246\205\340\246\252\340\247\215\340\246\260\340\246\244\340\247\201\340\246\262 \340\246\254\340\247\215\340\246\257\340\246\276\340\246\237\340\246\276\340\246\260\340\246\277 \340\246\252\340\247\215\340\246\257\340\246\276\340\246\225! \340\246\252\340\246\260\340\247\215\340\246\257\340\246\276\340\246\252\340\247\215\340\246\244 \340\246\254\340\247\215\340\246\257\340\246\276\340\246\225\340\246\206\340\246\252 \340\246\252\340\246\276\340\246\254\340\247\207\340\246\250 \340\246\250\340\246\276\340\245\244\"\n                    }\n\n                    val statusColor = when (batterySufficiency) {\n                        \"OPTIMAL\" -> BatteryFull\n                        \"SUFFICIENT\" -> GreenPrimaryLight\n                        \"LOW\" -> BatteryHalf\n                        else -> BatteryLow\n                    }\n\n                    Row(\n                        modifier = Modifier.fillMaxWidth(),\n                        verticalAlignment = Alignment.CenterVertically\n                    ) {\n                        Icon(\n                            imageVector = if (batterySufficiency == \"OPTIMAL\" || batterySufficiency == \"SUFFICIENT\") Icons.Default.CheckCircle else Icons.Default.Warning,\n                            contentDescription = null,\n                            tint = statusColor,\n                            modifier = Modifier.size(20.dp)\n                        )\n                        Spacer(modifier = Modifier.width(6.dp))\n                        Text(\n                            text = statusText,\n                            fontWeight = FontWeight.Bold,\n                            color = statusColor,\n                            style = MaterialTheme.typography.bodySmall\n                        )\n                    }\n\n                    Spacer(modifier = Modifier.height(12.dp))\n\n                    Button(\n                        onClick = onProceedToSetup,\n                        modifier = Modifier.fillMaxWidth(),\n                        colors = ButtonDefaults.buttonColors(containerColor = MaterialTheme.colorScheme.primary)\n                    ) {\n                        Text(\"\340\246\252\340\247\215\340\246\257\340\246\276\340\246\225 \340\246\225\340\247\215\340\246\257\340\246\276\340\246\262\340\246\225\340\247\201\340\246\262\340\247\207\340\246\237\340\246\260\340\247\207 \340\246\252\340\247\215\340\246\257\340\246\276\340\246\225 \340\246\241\340\246\277\340\246\234\340\246\276\340\246\207\340\246\250 \340\246\256\340\247\207\340\246\262\340\246\276\340\246\250\", fontWeight = FontWeight.Bold)\n                        Spacer(modifier = Modifier.width(4.dp))\n                        Icon(Icons.Default.ArrowForward, contentDescription = null, modifier = Modifier.size(16.dp))\n                    }\n                }\n            }\n        }\n    }\n}"
      replacement_content: "// TAB 1: Household Appliance selection and Load calculator\n@Composable\nfun ApplianceSelectionTab(\n    viewModel: BatteryViewModel,\n    onProceedToSetup: () -> Unit\n) {\n    val scrollState = rememberScrollState()\n    val t = { key: String -> BatteryLocalizer.get(key, viewModel.appLanguage) }\n\n    Column(\n        modifier = Modifier\n            .fillMaxSize()\n            .verticalScroll(scrollState)\n            .padding(12.dp),\n        verticalArrangement = Arrangement.spacedBy(12.dp)\n    ) {\n        // Subheader introducing the section\n        Card(\n            colors = CardDefaults.cardColors(\n                containerColor = MaterialTheme.colorScheme.primaryContainer.copy(alpha = 0.15f)\n            ),\n            modifier = Modifier.fillMaxWidth()\n        ) {\n            Column(modifier = Modifier.padding(12.dp)) {\n                Text(\n                    text = t(\"connected_load\"),\n                    fontWeight = FontWeight.Bold,\n                    style = MaterialTheme.typography.bodyLarge,\n                    color = MaterialTheme.colorScheme.primary\n                )\n                Text(\n                    text = t(\"connected_load_desc\"),\n                    style = MaterialTheme.typography.bodySmall,\n                    color = MaterialTheme.colorScheme.onSurfaceVariant\n                )\n            }\n        }\n\n        // Global Target Backup Hours Card\n        Card(\n            modifier = Modifier.fillMaxWidth(),\n            colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.surface)\n        ) {\n            Column(modifier = Modifier.padding(16.dp)) {\n                Row(\n                    modifier = Modifier.fillMaxWidth(),\n                    horizontalArrangement = Arrangement.SpaceBetween,\n                    verticalAlignment = Alignment.CenterVertically\n                ) {\n                    Text(\n                        text = t(\"backup_target\"),\n                        fontWeight = FontWeight.Bold,\n                        style = MaterialTheme.typography.bodyLarge\n                    )\n                    Text(\n                        text = \"${viewModel.targetBackupHours.roundToInt()} ${t(\"hours_label\")}\",\n                        fontWeight = FontWeight.ExtraBold,\n                        color = MaterialTheme.colorScheme.primary,\n                        style = MaterialTheme.typography.titleLarge\n                    )\n                }\n                Slider(\n                    value = viewModel.targetBackupHours.toFloat(),\n                    onValueChange = { viewModel.targetBackupHours = it.roundToInt().toDouble() },\n                    valueRange = 1f..24f,\n                    steps = 22,\n                    modifier = Modifier.fillMaxWidth()\n                )\n                Row(\n                    modifier = Modifier.fillMaxWidth(),\n                    horizontalArrangement = Arrangement.SpaceBetween\n                ) {\n                    Text(t(\"hour_1\"), style = MaterialTheme.typography.bodySmall, color = Color.Gray)\n                    Text(t(\"hour_12\"), style = MaterialTheme.typography.bodySmall, color = Color.Gray)\n                    Text(t(\"hour_24\"), style = MaterialTheme.typography.bodySmall, color = Color.Gray)\n                }\n            }\n        }\n\n        // List of household appliances with Counter Controls\n        Text(\n            text = t(\"appliance_list_title\"),\n            fontWeight = FontWeight.Bold,\n            style = MaterialTheme.typography.titleMedium,\n            modifier = Modifier.padding(horizontal = 4.dp, vertical = 2.dp)\n        )\n\n        viewModel.standardAppliances.forEach { appliance ->\n            val quantity = viewModel.applianceQuantities[appliance.id] ?: 0\n            val displayName = when (viewModel.appLanguage) {\n                \"bn\" -> appliance.nameBn\n                else -> appliance.nameEn\n            }\n\n            Card(\n                modifier = Modifier.fillMaxWidth(),\n                colors = CardDefaults.cardColors(\n                    containerColor = if (quantity > 0) MaterialTheme.colorScheme.primaryContainer.copy(alpha = 0.15f) else MaterialTheme.colorScheme.surface\n                ),\n                border = if (quantity > 0) borderStroke(1.dp, MaterialTheme.colorScheme.primary.copy(alpha = 0.3f)) else null\n            ) {\n                Row(\n                    modifier = Modifier\n                        .fillMaxWidth()\n                        .padding(12.dp),\n                    verticalAlignment = Alignment.CenterVertically,\n                    horizontalArrangement = Arrangement.SpaceBetween\n                ) {\n                    // Left side details\n                    Row(\n                        verticalAlignment = Alignment.CenterVertically,\n                        modifier = Modifier.weight(1f)\n                    ) {\n                        // Dynamic Material Icons\n                        val iconVector = when (appliance.iconName) {\n                            \"lightbulb\" -> Icons.Default.Lightbulb\n                            \"mode_fan\" -> Icons.Default.Air\n                            \"tv\" -> Icons.Default.Tv\n                            \"router\" -> Icons.Default.Router\n                            \"kitchen\" -> Icons.Default.Kitchen\n                            \"water\" -> Icons.Default.WaterDrop\n                            \"ac_unit\" -> Icons.Default.AcUnit\n                            \"laptop\" -> Icons.Default.Laptop\n                            \"microwave\" -> Icons.Default.SoupKitchen\n                            else -> Icons.Default.Smartphone\n                        }\n\n                        Surface(\n                            shape = RoundedCornerShape(8.dp),\n                            color = MaterialTheme.colorScheme.secondaryContainer.copy(alpha = 0.4f),\n                            modifier = Modifier.size(40.dp)\n                        ) {\n                            Box(contentAlignment = Alignment.Center) {\n                                Icon(\n                                    imageVector = iconVector,\n                                    contentDescription = null,\n                                    tint = MaterialTheme.colorScheme.primary,\n                                    modifier = Modifier.size(22.dp)\n                                )\n                            }\n                        }\n\n                        Spacer(modifier = Modifier.width(10.dp))\n\n                        Column {\n                            Text(\n                                text = displayName,\n                                fontWeight = FontWeight.Bold,\n                                style = MaterialTheme.typography.bodyLarge\n                            )\n                            Text(\n                                text = \"${appliance.nominalWatts.toInt()} ${t(\"watts\")} \342\200\242 ${t(\"surge\")}: ${appliance.surgeMultiplier}x\",\n                                style = MaterialTheme.typography.bodySmall,\n                                color = MaterialTheme.colorScheme.onSurfaceVariant\n                            )\n                        }\n                    }\n\n                    // Right side counters\n                    Row(\n                        verticalAlignment = Alignment.CenterVertically,\n                        horizontalArrangement = Arrangement.spacedBy(8.dp)\n                    ) {\n                        IconButton(\n                            onClick = { viewModel.decrementAppliance(appliance.id) },\n                            colors = IconButtonDefaults.iconButtonColors(\n                                containerColor = MaterialTheme.colorScheme.surfaceVariant\n                            ),\n                            modifier = Modifier.size(32.dp)\n                        ) {\n                            Icon(Icons.Default.Remove, contentDescription = \"Decrement\", modifier = Modifier.size(16.dp))\n                        }\n\n                        Text(\n                            text = quantity.toString(),\n                            fontWeight = FontWeight.Bold,\n                            fontSize = 16.sp,\n                            modifier = Modifier.widthIn(min = 20.dp),\n                            textAlign = TextAlign.Center\n                        )\n\n                        IconButton(\n                            onClick = { viewModel.incrementAppliance(appliance.id) },\n                            colors = IconButtonDefaults.iconButtonColors(\n                                containerColor = MaterialTheme.colorScheme.primaryContainer\n                            ),\n                            modifier = Modifier.size(32.dp)\n                        ) {\n                            Icon(Icons.Default.Add, contentDescription = \"Increment\", modifier = Modifier.size(16.dp))\n                        }\n                    }\n                }\n            }\n        }\n\n        // Dynamic Calculations Results Panel\n        if (viewModel.totalRunningWatts > 0) {\n            Card(\n                colors = CardDefaults.cardColors(\n                    containerColor = MaterialTheme.colorScheme.surfaceVariant.copy(alpha = 0.5f)\n                ),\n                modifier = Modifier\n                    .fillMaxWidth()\n                    .padding(vertical = 4.dp),\n                shape = RoundedCornerShape(12.dp)\n            ) {\n                Column(modifier = Modifier.padding(16.dp)) {\n                    Text(\n                        text = t(\"pack_analysis\"),\n                        fontWeight = FontWeight.Bold,\n                        style = MaterialTheme.typography.titleMedium,\n                        color = MaterialTheme.colorScheme.primary\n                    )\n                    Spacer(modifier = Modifier.height(10.dp))\n\n                    Row(\n                        modifier = Modifier.fillMaxWidth(),\n                        horizontalArrangement = Arrangement.SpaceBetween\n                    ) {\n                        Text(t(\"total_running_load\"), style = MaterialTheme.typography.bodyMedium)\n                        Text(\n                            \"${viewModel.totalRunningWatts.toInt()} ${t(\"watts\")}\",\n                            fontWeight = FontWeight.Bold,\n                            style = MaterialTheme.typography.bodyMedium\n                        )\n                    }\n\n                    Row(\n                        modifier = Modifier.fillMaxWidth().padding(top = 4.dp),\n                        horizontalArrangement = Arrangement.SpaceBetween\n                    ) {\n                        Text(t(\"total_peak_load\"), style = MaterialTheme.typography.bodyMedium)\n                        Text(\n                            \"${viewModel.peakSurgeWatts.toInt()} ${t(\"watts\")}\",\n                            fontWeight = FontWeight.Bold,\n                            color = Color(0xFFE64A19),\n                            style = MaterialTheme.typography.bodyMedium\n                        )\n                    }\n\n                    Row(\n                        modifier = Modifier.fillMaxWidth().padding(top = 4.dp),\n                        horizontalArrangement = Arrangement.SpaceBetween\n                    ) {\n                        Text(t(\"daily_energy_req\"), style = MaterialTheme.typography.bodyMedium)\n                        Text(\n                            \"${viewModel.targetRequiredEnergyWh.toInt()} Wh (${(viewModel.targetRequiredEnergyWh / 1000.0).format(2)} kWh)\",\n                            fontWeight = FontWeight.Bold,\n                            style = MaterialTheme.typography.bodyMedium\n                        )\n                    }\n\n                    HorizontalDivider(modifier = Modifier.padding(vertical = 8.dp))\n\n                    // Status analysis compared with configured battery size\n                    val batterySufficiency = viewModel.capacitySufficiencyStatus\n                    val statusText = when (batterySufficiency) {\n                        \"OPTIMAL\" -> when (viewModel.appLanguage) {\n                            \"bn\" -> \"\340\246\205\340\246\244\340\246\277\340\246\260\340\246\277\340\246\225\340\247\215\340\246\244 \340\246\254\340\247\215\340\246\257\340\246\276\340\246\225\340\246\206\340\246\252 \340\246\247\340\246\276\340\246\260\340\246\243\340\246\225\340\247\215\340\246\267\340\246\256\340\246\244\340\246\276 \340\246\206\340\246\233\340\247\207! (Optimal & Safe)\"\n                            \"zh\" -> \"\346\234\211\345\205\205\350\266\263\347\232\204\345\244\207\344\273\275\345\256\271\351\207\217\357\274\201(\345\256\211\345\205\250\346\216\250\350\215\220)\"\n                            \"de\" -> \"Hervorragende Backup-Kapazit\303\244t! (Optimal)\"\n                            \"ko\" -> \"\354\227\254\354\234\240\353\241\234\354\232\264 \353\260\261\354\227\205 \354\232\251\353\237\211 \355\231\225\353\263\264! (\354\225\210\354\240\204 \353\260\217 \354\265\234\354\240\201)\"\n                            else -> \"Excellent Backup Capacity! (Optimal & Safe)\"\n                        }\n                        \"SUFFICIENT\" -> when (viewModel.appLanguage) {\n                            \"bn\" -> \"\340\246\252\340\247\215\340\246\257\340\246\276\340\246\225 \340\246\247\340\246\276\340\246\260\340\246\243\340\246\225\340\247\215\340\246\267\340\246\256\340\246\244\340\246\276 \340\246\252\340\246\260\340\247\215\340\246\257\340\246\276\340\246\252\340\247\215\340\246\244! (Sufficient)\"\n                            \"zh\" -> \"\347\224\265\346\261\240\345\214\205\345\256\271\351\207\217\345\205\205\350\266\263\357\274\201(\345\205\205\350\266\263)\"\n                            \"de\" -> \"Pack-Kapazit\303\244t ist ausreichend! (Sufficient)\"\n                            \"ko\" -> \"\353\260\260\355\204\260\353\246\254 \355\214\251 \354\232\251\353\237\211\354\235\264 \354\266\251\353\266\204\355\225\251\353\213\210\353\213\244! (\354\266\251\353\266\204)\"\n                            else -> \"Pack Capacity is Sufficient! (Sufficient)\"\n                        }\n                        \"LOW\" -> when (viewModel.appLanguage) {\n                            \"bn\" -> \"\340\246\254\340\247\215\340\246\257\340\246\276\340\246\237\340\246\276\340\246\260\340\246\277 \340\246\247\340\246\276\340\246\260\340\246\243\340\246\225\340\247\215\340\246\267\340\246\256\340\246\244\340\246\276 \340\246\225\340\246\256 (\340\246\254\340\247\215\340\246\257\340\246\276\340\246\225\340\246\206\340\246\252 \340\246\270\340\246\256\340\247\237 \340\246\225\340\246\256\340\247\207 \340\246\257\340\246\276\340\246\254\340\247\207)\"\n                            \"zh\" -> \"\347\224\265\346\261\240\345\256\271\351\207\217\350\276\203\344\275\216 (\345\244\207\344\273\275\346\227\266\351\227\264\345\260\206\347\274\251\347\237\255)\"\n                            \"de\" -> \"Geringe Akkukapazit\303\244t (Backupzeit verk\303\274rzt sich)\"\n                            \"ko\" -> \"\353\260\260\355\204\260\353\246\254 \354\232\251\353\237\211 \353\266\200\354\241\261 (\353\260\261\354\227\205 \354\213\234\352\260\204\354\235\264 \353\213\250\354\266\225\353\220\250)\"\n                            else -> \"Low battery capacity (backup time will be shorter)\"\n                        }\n                        else -> when (viewModel.appLanguage) {\n                            \"bn\" -> \"\340\246\205\340\246\252\340\247\215\340\246\260\340\246\244\340\247\201\340\246\262 \340\246\254\340\247\215\340\246\257\340\246\276\340\246\237\340\246\276\340\246\260\340\246\277 \340\246\252\340\247\215\340\246\257\340\246\276\340\246\225! \340\246\252\340\246\260\340\247\215\340\246\257\340\246\276\340\246\252\340\247\215\340\246\244 \340\246\254\340\247\215\340\246\257\340\246\276\340\246\225\340\246\206\340\246\252 \340\246\252\340\246\276\340\246\254\340\247\207\340\246\250 \340\246\250\340\246\276\340\245\244\"\n                            \"zh\" -> \"\347\224\265\346\261\240\345\214\205\345\256\271\351\207\217\344\270\215\350\266\263\357\274\201\346\227\240\346\263\225\346\273\241\350\266\263\347\233\256\346\240\207\345\244\207\344\273\275\343\200\202\"\n                            \"de\" -> \"Ungen\303\274gende Akkukapazit\303\244t! Ziel wird nicht erreicht.\"\n                            \"ko\" -> \"\353\260\260\355\204\260\353\246\254 \354\232\251\353\237\211\354\235\264 \353\247\244\354\232\260 \353\266\200\354\241\261\355\225\251\353\213\210\353\213\244! \353\252\251\355\221\234\353\245\274 \353\213\254\354\204\261\355\225\240 \354\210\230 \354\227\206\354\212\265\353\213\210\353\213\244.\"\n                            else -> \"Insufficient battery pack! Won\'t meet target backup.\"\n                        }\n                    }\n\n                    val statusColor = when (batterySufficiency) {\n                        \"OPTIMAL\" -> BatteryFull\n                        \"SUFFICIENT\" -> GreenPrimaryLight\n                        \"LOW\" -> BatteryHalf\n                        else -> BatteryLow\n                    }\n\n                    Row(\n                        modifier = Modifier.fillMaxWidth(),\n                        verticalAlignment = Alignment.CenterVertically\n                    ) {\n                        Icon(\n                            imageVector = if (batterySufficiency == \"OPTIMAL\" || batterySufficiency == \"SUFFICIENT\") Icons.Default.CheckCircle else Icons.Default.Warning,\n                            contentDescription = null,\n                            tint = statusColor,\n                            modifier = Modifier.size(20.dp)\n                        )\n                        Spacer(modifier = Modifier.width(6.dp))\n                        Text(\n                            text = statusText,\n                            fontWeight = FontWeight.Bold,\n                            color = statusColor,\n                            style = MaterialTheme.typography.bodySmall\n                        )\n                    }\n\n                    Spacer(modifier = Modifier.height(12.dp))\n\n                    Button(\n                        onClick = onProceedToSetup,\n                        modifier = Modifier.fillMaxWidth(),\n                        colors = ButtonDefaults.buttonColors(containerColor = MaterialTheme.colorScheme.primary)\n                    ) {\n                        Text(t(\"btn_proceed\"), fontWeight = FontWeight.Bold)\n                        Spacer(modifier = Modifier.width(4.dp))\n                        Icon(Icons.Default.ArrowForward, contentDescription = null, modifier = Modifier.size(16.dp))\n                    }\n                }\n            }\n        }\n    }\n}"
    }
