        lines {
          text: "    if (hours < 1.0) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        val minutes = (hours * 60).roundToInt()"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        return \"$minutes mins\""
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
