        }
        lines {
          text: "                        Icon(Icons.Default.ArrowForward, contentDescription = null, modifier = Modifier.size(16.dp))"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
