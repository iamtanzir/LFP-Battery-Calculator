        }
        lines {
          text: "                    Text(\"\340\246\270\340\246\202\340\246\260\340\246\225\340\247\215\340\246\267\340\246\243 \340\246\225\340\246\260\340\247\201\340\246\250\")"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                }"
