    instruction: "Add lang parameter to BatteryVisualHeader and translate all labels inside it"
    replacement_infos {
      original_chunk {
        target_content: "@Composable\nfun BatteryVisualHeader(\n    seriesCells: Int,\n    parallelCells: Int,\n    totalCapacityAh: Double,\n    nominalVoltage: Double,\n    totalKwh: Double,\n    usableKwh: Double,\n    dodPercent: Double,\n    cycleLife: Int,\n    cellName: String,\n    cellForm: LfpCellForm\n) {\n    Card(\n        modifier = Modifier\n            .fillMaxWidth()\n            .padding(horizontal = 12.dp, vertical = 6.dp),\n        colors = CardDefaults.cardColors(\n            containerColor = MaterialTheme.colorScheme.surfaceVariant.copy(alpha = 0.35f)\n        ),\n        shape = RoundedCornerShape(16.dp)\n    ) {\n        Column(\n            modifier = Modifier\n                .fillMaxWidth()\n                .padding(12.dp),\n            horizontalAlignment = Alignment.CenterHorizontally\n        ) {\n            Row(\n                modifier = Modifier.fillMaxWidth(),\n                horizontalArrangement = Arrangement.SpaceBetween,\n                verticalAlignment = Alignment.CenterVertically\n            ) {\n                // Info block\n                Column {\n                    Text(\n                        text = \"\340\246\252\340\247\215\340\246\257\340\246\276\340\246\225 \340\246\225\340\246\250\340\246\253\340\246\277\340\246\227\340\246\276\340\246\260\340\247\207\340\246\266\340\246\250\",\n                        style = MaterialTheme.typography.labelSmall,\n                        color = MaterialTheme.colorScheme.primary,\n                        fontWeight = FontWeight.Bold\n                    )\n                    Text(\n                        text = \"${seriesCells}S ${parallelCells}P LFP Pack\",\n                        style = MaterialTheme.typography.titleMedium,\n                        fontWeight = FontWeight.Bold,\n                        color = MaterialTheme.colorScheme.onSurface\n                    )\n                    Text(\n                        text = \"${nominalVoltage.format(1)} V | ${totalCapacityAh.roundToInt()} Ah Rated\",\n                        style = MaterialTheme.typography.bodySmall,\n                        color = MaterialTheme.colorScheme.onSurfaceVariant\n                    )\n                }\n\n                // Energy details\n                Column(horizontalAlignment = Alignment.End) {\n                    Text(\n                        text = \"\340\246\206\340\247\237\340\247\201\340\246\267\340\247\215\340\246\225\340\246\276\340\246\262 (CYCLE LIFE)\",\n                        style = MaterialTheme.typography.labelSmall,\n                        color = MaterialTheme.colorScheme.onSurfaceVariant,\n                        fontWeight = FontWeight.Bold\n                    )\n                    Text(\n                        text = \"~$cycleLife \340\246\270\340\246\276\340\246\207\340\246\225\340\247\207\340\246\262\",\n                        style = MaterialTheme.typography.titleMedium,\n                        fontWeight = FontWeight.ExtraBold,\n                        color = if (dodPercent <= 80.0) BatteryFull else BatteryHalf\n                    )\n                    Text(\n                        text = \"${dodPercent.roundToInt()}% DoD \340\246\241\340\246\277\340\246\270\340\246\232\340\246\276\340\246\260\340\247\215\340\246\234\340\247\207\",\n                        style = MaterialTheme.typography.bodySmall,\n                        color = MaterialTheme.colorScheme.onSurfaceVariant\n                    )\n                }\n            }\n\n            Spacer(modifier = Modifier.height(10.dp))\n\n            // Battery Cylinder Custom Drawing representing the DoD Usable energy\n            Row(\n                modifier = Modifier\n                    .fillMaxWidth()\n                    .height(70.dp),\n                verticalAlignment = Alignment.CenterVertically,\n                horizontalArrangement = Arrangement.Center\n            ) {\n                Box(\n                    modifier = Modifier\n                        .fillMaxWidth()\n                        .height(60.dp),\n                    contentAlignment = Alignment.Center\n                ) {\n                    val level = dodPercent / 100.0\n                    val animatedLevel by animateFloatAsState(\n                        targetValue = level.toFloat(),\n                        animationSpec = tween(600),\n                        label = \"BatteryLevelGauge\"\n                    )\n\n                    Canvas(modifier = Modifier.fillMaxSize()) {\n                        val strokeWidth = 2.5.dp.toPx()\n                        val capWidth = 10.dp.toPx()\n                        val capHeight = 18.dp.toPx()\n\n                        val mainBodyWidth = size.width - capWidth - 6.dp.toPx()\n                        val mainBodyHeight = size.height\n\n                        // 1. Draw Battery Outer Border Container (Main Body)\n                        drawRoundRect(\n                            color = Color.LightGray.copy(alpha = 0.4f),\n                            size = Size(mainBodyWidth, mainBodyHeight),\n                            cornerRadius = CornerRadius(10.dp.toPx(), 10.dp.toPx()),\n                            style = Stroke(width = strokeWidth)\n                        )\n\n                        // 2. Draw Battery Positive Terminal Cap (Right Side)\n                        drawRoundRect(\n                            color = Color.LightGray.copy(alpha = 0.4f),\n                            topLeft = Offset(mainBodyWidth, (mainBodyHeight - capHeight) / 2),\n                            size = Size(capWidth, capHeight),\n                            cornerRadius = CornerRadius(3.dp.toPx(), 3.dp.toPx())\n                        )\n\n                        // 3. Draw Inner Fluid Fill representing the Configurable DoD Usable Energy\n                        val innerPadding = 5.dp.toPx()\n                        val maxFillWidth = mainBodyWidth - (innerPadding * 2)\n                        val fillHeight = mainBodyHeight - (innerPadding * 2)\n\n                        val fillWidth = maxFillWidth * animatedLevel\n\n                        val brush = Brush.linearGradient(\n                            colors = listOf(\n                                GreenPrimaryLight,\n                                BatteryFull\n                            )\n                        )\n\n                        if (fillWidth > 0f) {\n                            drawRoundRect(\n                                brush = brush,\n                                topLeft = Offset(innerPadding, innerPadding),\n                                size = Size(fillWidth, fillHeight),\n                                cornerRadius = CornerRadius(6.dp.toPx(), 6.dp.toPx())\n                            )\n                        }\n\n                        // Draw lines showing depth limits (DoD threshold marker)\n                        if (animatedLevel < 1f) {\n                            val limitX = innerPadding + fillWidth\n                            drawLine(\n                                color = Color.Red.copy(alpha = 0.7f),\n                                start = Offset(limitX, innerPadding),\n                                end = Offset(limitX, innerPadding + fillHeight),\n                                strokeWidth = 2.dp.toPx()\n                            )\n                        }\n                    }\n\n                    // Inside overlays showing energy metrics\n                    Row(\n                        modifier = Modifier\n                            .fillMaxSize()\n                            .padding(horizontal = 16.dp),\n                        verticalAlignment = Alignment.CenterVertically,\n                        horizontalArrangement = Arrangement.SpaceBetween\n                    ) {\n                        Column {\n                            Text(\n                                text = \"\340\246\254\340\247\215\340\246\257\340\246\254\340\246\271\340\246\276\340\246\260\340\246\257\340\247\213\340\246\227\340\247\215\340\246\257: ${usableKwh.format(2)} kWh\",\n                                style = MaterialTheme.typography.bodySmall,\n                                fontWeight = FontWeight.Bold,\n                                color = MaterialTheme.colorScheme.onSurface\n                            )\n                            Text(\n                                \"Usable Battery Capacity\",\n                                style = MaterialTheme.typography.labelSmall,\n                                color = MaterialTheme.colorScheme.onSurfaceVariant,\n                                fontSize = 10.sp\n                            )\n                        }\n\n                        Column(horizontalAlignment = Alignment.End) {\n                            Text(\n                                text = \"\340\246\256\340\247\213\340\246\237 \340\246\266\340\246\225\340\247\215\340\246\244\340\246\277: ${totalKwh.format(2)} kWh\",\n                                style = MaterialTheme.typography.bodySmall,\n                                fontWeight = FontWeight.Bold,\n                                color = MaterialTheme.colorScheme.onSurfaceVariant\n                            )\n                            Text(\n                                \"Total System Storage\",\n                                style = MaterialTheme.typography.labelSmall,\n                                color = MaterialTheme.colorScheme.onSurfaceVariant,\n                                fontSize = 10.sp\n                            )\n                        }\n                    }\n                }\n            }\n\n            Spacer(modifier = Modifier.height(4.dp))\n            Row(\n                modifier = Modifier.fillMaxWidth(),\n                horizontalArrangement = Arrangement.SpaceBetween\n            ) {\n                Text(\n                    text = \"\340\246\270\340\247\207\340\246\262 \340\246\256\340\246\241\340\247\207\340\246\262: $cellName\",\n                    style = MaterialTheme.typography.labelSmall,\n                    color = MaterialTheme.colorScheme.onSurfaceVariant\n                )\n                Text(\n                    text = \"\340\246\237\340\246\276\340\246\207\340\246\252: ${if (cellForm == LfpCellForm.CYLINDRICAL) \"\340\246\270\340\246\277\340\246\262\340\246\277\340\246\250\340\247\215\340\246\241\340\247\215\340\246\260\340\246\277\340\246\225\340\247\215\340\246\257\340\246\276\340\246\262 (Cylindrical)\" else \"\340\246\252\340\247\215\340\246\260\340\246\277\340\246\234\340\246\256\340\247\207\340\246\237\340\246\277\340\246\225 (Prismatic)\"}\",\n                    style = MaterialTheme.typography.labelSmall,\n                    color = MaterialTheme.colorScheme.primary\n                )\n            }\n        }\n    }\n}"
        replacement_content: "@Composable\nfun BatteryVisualHeader(\n    seriesCells: Int,\n    parallelCells: Int,\n    totalCapacityAh: Double,\n    nominalVoltage: Double,\n    totalKwh: Double,\n    usableKwh: Double,\n    dodPercent: Double,\n    cycleLife: Int,\n    cellName: String,\n    cellForm: LfpCellForm,\n    lang: String\n) {\n    val t = { key: String -> BatteryLocalizer.get(key, lang) }\n    Card(\n        modifier = Modifier\n            .fillMaxWidth()\n            .padding(horizontal = 12.dp, vertical = 6.dp),\n        colors = CardDefaults.cardColors(\n            containerColor = MaterialTheme.colorScheme.surfaceVariant.copy(alpha = 0.35f)\n        ),\n        shape = RoundedCornerShape(16.dp)\n    ) {\n        Column(\n            modifier = Modifier\n                .fillMaxWidth()\n                .padding(12.dp),\n            horizontalAlignment = Alignment.CenterHorizontally\n        ) {\n            Row(\n                modifier = Modifier.fillMaxWidth(),\n                horizontalArrangement = Arrangement.SpaceBetween,\n                verticalAlignment = Alignment.CenterVertically\n            ) {\n                // Info block\n                Column {\n                    Text(\n                        text = t(\"pack_config\"),\n                        style = MaterialTheme.typography.labelSmall,\n                        color = MaterialTheme.colorScheme.primary,\n                        fontWeight = FontWeight.Bold\n                    )\n                    Text(\n                        text = \"${seriesCells}S ${parallelCells}P LFP Pack\",\n                        style = MaterialTheme.typography.titleMedium,\n                        fontWeight = FontWeight.Bold,\n                        color = MaterialTheme.colorScheme.onSurface\n                    )\n                    Text(\n                        text = \"${nominalVoltage.format(1)} V | ${totalCapacityAh.roundToInt()} Ah Rated\",\n                        style = MaterialTheme.typography.bodySmall,\n                        color = MaterialTheme.colorScheme.onSurfaceVariant\n                    )\n                }\n\n                // Energy details\n                Column(horizontalAlignment = Alignment.End) {\n                    Text(\n                        text = t(\"cycle_life\"),\n                        style = MaterialTheme.typography.labelSmall,\n                        color = MaterialTheme.colorScheme.onSurfaceVariant,\n                        fontWeight = FontWeight.Bold\n                    )\n                    Text(\n                        text = \"~$cycleLife ${t(\"cycles\")}\",\n                        style = MaterialTheme.typography.titleMedium,\n                        fontWeight = FontWeight.ExtraBold,\n                        color = if (dodPercent <= 80.0) BatteryFull else BatteryHalf\n                    )\n                    Text(\n                        text = t(\"at_dod\").replace(\"%s\", dodPercent.roundToInt().toString()),\n                        style = MaterialTheme.typography.bodySmall,\n                        color = MaterialTheme.colorScheme.onSurfaceVariant\n                    )\n                }\n            }\n\n            Spacer(modifier = Modifier.height(10.dp))\n\n            // Battery Cylinder Custom Drawing representing the DoD Usable energy\n            Row(\n                modifier = Modifier\n                    .fillMaxWidth()\n                    .height(70.dp),\n                verticalAlignment = Alignment.CenterVertically,\n                horizontalArrangement = Arrangement.Center\n            ) {\n                Box(\n                    modifier = Modifier\n                        .fillMaxWidth()\n                        .height(60.dp),\n                    contentAlignment = Alignment.Center\n                ) {\n                    val level = dodPercent / 100.0\n                    val animatedLevel by animateFloatAsState(\n                        targetValue = level.toFloat(),\n                        animationSpec = tween(600),\n                        label = \"BatteryLevelGauge\"\n                    )\n\n                    Canvas(modifier = Modifier.fillMaxSize()) {\n                        val strokeWidth = 2.5.dp.toPx()\n                        val capWidth = 10.dp.toPx()\n                        val capHeight = 18.dp.toPx()\n\n                        val mainBodyWidth = size.width - capWidth - 6.dp.toPx()\n                        val mainBodyHeight = size.height\n\n                        // 1. Draw Battery Outer Border Container (Main Body)\n                        drawRoundRect(\n                            color = Color.LightGray.copy(alpha = 0.4f),\n                            size = Size(mainBodyWidth, mainBodyHeight),\n                            cornerRadius = CornerRadius(10.dp.toPx(), 10.dp.toPx()),\n                            style = Stroke(width = strokeWidth)\n                        )\n\n                        // 2. Draw Battery Positive Terminal Cap (Right Side)\n                        drawRoundRect(\n                            color = Color.LightGray.copy(alpha = 0.4f),\n                            topLeft = Offset(mainBodyWidth, (mainBodyHeight - capHeight) / 2),\n                            size = Size(capWidth, capHeight),\n                            cornerRadius = CornerRadius(3.dp.toPx(), 3.dp.toPx())\n                        )\n\n                        // 3. Draw Inner Fluid Fill representing the Configurable DoD Usable Energy\n                        val innerPadding = 5.dp.toPx()\n                        val maxFillWidth = mainBodyWidth - (innerPadding * 2)\n                        val fillHeight = mainBodyHeight - (innerPadding * 2)\n\n                        val fillWidth = maxFillWidth * animatedLevel\n\n                        val brush = Brush.linearGradient(\n                            colors = listOf(\n                                GreenPrimaryLight,\n                                BatteryFull\n                            )\n                        )\n\n                        if (fillWidth > 0f) {\n                            drawRoundRect(\n                                brush = brush,\n                                topLeft = Offset(innerPadding, innerPadding),\n                                size = Size(fillWidth, fillHeight),\n                                cornerRadius = CornerRadius(6.dp.toPx(), 6.dp.toPx())\n                            )\n                        }\n\n                        // Draw lines showing depth limits (DoD threshold marker)\n                        if (animatedLevel < 1f) {\n                            val limitX = innerPadding + fillWidth\n                            drawLine(\n                                color = Color.Red.copy(alpha = 0.7f),\n                                start = Offset(limitX, innerPadding),\n                                end = Offset(limitX, innerPadding + fillHeight),\n                                strokeWidth = 2.dp.toPx()\n                            )\n                        }\n                    }\n\n                    // Inside overlays showing energy metrics\n                    Row(\n                        modifier = Modifier\n                            .fillMaxSize()\n                            .padding(horizontal = 16.dp),\n                        verticalAlignment = Alignment.CenterVertically,\n                        horizontalArrangement = Arrangement.SpaceBetween\n                    ) {\n                        Column {\n                            Text(\n                                text = \"${t(\"usable\")}: ${usableKwh.format(2)} kWh\",\n                                style = MaterialTheme.typography.bodySmall,\n                                fontWeight = FontWeight.Bold,\n                                color = MaterialTheme.colorScheme.onSurface\n                            )\n                            Text(\n                                \"Usable Battery Capacity\",\n                                style = MaterialTheme.typography.labelSmall,\n                                color = MaterialTheme.colorScheme.onSurfaceVariant,\n                                fontSize = 10.sp\n                            )\n                        }\n\n                        Column(horizontalAlignment = Alignment.End) {\n                            Text(\n                                text = \"${t(\"total_energy\")}: ${totalKwh.format(2)} kWh\",\n                                style = MaterialTheme.typography.bodySmall,\n                                fontWeight = FontWeight.Bold,\n                                color = MaterialTheme.colorScheme.onSurfaceVariant\n                            )\n                            Text(\n                                \"Total System Storage\",\n                                style = MaterialTheme.typography.labelSmall,\n                                color = MaterialTheme.colorScheme.onSurfaceVariant,\n                                fontSize = 10.sp\n                            )\n                        }\n                    }\n                }\n            }\n\n            Spacer(modifier = Modifier.height(4.dp))\n            Row(\n                modifier = Modifier.fillMaxWidth(),\n                horizontalArrangement = Arrangement.SpaceBetween\n            ) {\n                Text(\n                    text = \"${t(\"cell_model\")}: $cellName\",\n                    style = MaterialTheme.typography.labelSmall,\n                    color = MaterialTheme.colorScheme.onSurfaceVariant\n                )\n                Text(\n                    text = \"${t(\"type\")}: ${if (cellForm == LfpCellForm.CYLINDRICAL) t(\"cylindrical\") else t(\"prismatic\")}\",\n                    style = MaterialTheme.typography.labelSmall,\n                    color = MaterialTheme.colorScheme.primary\n                )\n            }\n        }\n    }\n}"
      }
      num_matches: 1
    }
  }
}
