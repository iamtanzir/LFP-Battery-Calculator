          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    val h = hours.toInt()"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    val m = ((hours - h) * 60).roundToInt()"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    return if (m == 0) \"${h}h\" else \"${h}h ${m}m\""
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
