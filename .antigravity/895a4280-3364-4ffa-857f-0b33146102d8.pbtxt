        }
        lines {
          text: "@Composable"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "fun BatteryVisualHeader("
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
