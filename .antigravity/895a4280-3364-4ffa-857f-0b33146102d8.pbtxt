        lines {
          text: "        \"ko\" -> \"\355\225\230\354\235\264\353\270\214\353\246\254\353\223\234 \354\213\234\354\212\244\355\205\234\354\235\200 \352\263\204\355\206\265\354\227\260\352\263\204\355\230\225\352\263\274 \353\217\205\353\246\275\355\230\225\354\235\230 \355\230\274\355\225\251\355\230\225\354\236\205\353\213\210\353\213\244. \354\240\204\353\240\245\353\247\235\352\263\274 \354\240\204\352\270\260\353\245\274 \352\263\265\354\234\240\355\225\230\353\251\264\354\204\234 \354\240\225\354\240\204 \354\213\234 \353\260\260\355\204\260\353\246\254 \353\260\261\354\227\205\354\235\204 \353\263\264\354\236\245\355\225\251\353\213\210\353\213\244.\""
