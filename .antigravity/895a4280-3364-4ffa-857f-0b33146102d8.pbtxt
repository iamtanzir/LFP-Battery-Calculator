\340\246\234: ${viewModel.recommendedInverterWatts.roundToInt()} \340\246\223\340\247\237\340\246\276\340\246\237 (Pure Sine Wave recommended)\",\n                        style = MaterialTheme.typography.bodySmall\n                    )\n                    Text(\n                        \"\342\200\242 \340\246\250\340\247\215\340\246\257\340\247\202\340\246\250\340\246\244\340\246\256 \340\247\247\340\247\246 \340\246\270\340\247\207. \340\246\270\340\246\276\340\246\260\340\247\215\340\246\234 \340\246\225\340\247\215\340\246\267\340\246\256\340\246\244\340\246\276: ${viewModel.recommendedInverterSurgeWatts.roundToInt()} \340\246\223\340\247\237\340\246\276\340\246\237\",\n                        style = MaterialTheme.typography.bodySmall,\n                        color = Color(0xFFE64A19),\n                        fontWeight = FontWeight.SemiBold\n                    )\n\n                    Spacer(modifier = Modifier.height(8.dp))\n\n                    // Cabling guide\n                    Text(\n                        \"\340\247\250. \340\246\254\340\247\215\340\246\257\340\246\276\340\246\237\340\246\276\340\246\260\340\246\277 \340\246\241\340\246\277\340\246\270\340\246\277 \340\246\225\340\247\215\340\246\257\340\246\276\340\246\254\340\246\262 \340\246\270\340\246\276\340\246\207\340\246\234 (Cabling & Safety):\",\n                        fontWeight = FontWeight.Bold,\n                        style = MaterialTheme.typography.bodyMedium\n                    )\n                    Text(\n                        \"\342\200\242 \340\246\270\340\246\260\340\247\215\340\246\254\340\246\276\340\246\247\340\246\277\340\246\225 \340\246\262\340\247\213\340\246\241 \340\246\225\340\246\276\340\246\260\340\247\207\340\246\250\340\247\215\340\246\237: ${viewModel.continuousRunningAmps.format(1)} Amperes\",\n                        style = MaterialTheme.typography.bodySmall\n                    )\n                    Text(\n                        \"\342\200\242 \340\246\270\340\247\215\340\246\237\340\246\276\340\246\260\340\247\215\340\246\237-\340\246\206\340\246\252 \340\246\252\340\246\277\340\246\225 \340\246\225\340\246\276\340\246\260\340\247\207\340\246\250\340\247\215\340\246\237: ${viewModel.startingSurgeAmps.format(1)} Amperes\",\n                        style = MaterialTheme.typography.bodySmall\n                    )\n                    Text(\n                        \"\342\200\242 \340\246\260\340\246\277\340\246\225\340\246\256\340\247\207\340\246\250\340\247\215\340\246\241\340\247\207\340\246\241 \340\246\241\340\246\277\340\246\270\340\246\277 \340\246\244\340\246\276\340\246\260: ${viewModel.recommendedCableSize}\",\n                        style = MaterialTheme.typography.bodySmall,\n                        fontWeight = FontWeight.Bold,\n                        color = GreenPrimaryLight\n                    )\n                    Text(\n                        \"\342\200\242 \340\246\260\340\246\277\340\246\225\340\246\256\340\247\207\340\246\250\340\247\215\340\246\241\340\247\207\340\246\241 \340\246\270\340\247\207\340\246\253\340\246\237\340\246\277 \340\246\253\340\246\277\340\246\211\340\246\234: ${(viewModel.startingSurgeAmps * 1.3).roundToInt()} A (DC Fuse)\",\n                        style = MaterialTheme.typography.bodySmall\n                    )\n\n                    Spacer(modifier = Modifier.height(8.dp))\n\n                    // Solar array recharge estimate\n                    if (viewModel.selectedGridType != \"ongrid\") {\n                        Text(\n                            \"\340\247\251. \340\246\270\340\247\213\340\246\262\340\246\276\340\246\260 \340\246\252\340\247\215\340\246\257\340\246\276\340\246\250\340\247\207\340\246\262 \340\246\260\340\246\277\340\246\232\340\246\276\340\246\260\340\247\215\340\246\234 \340\246\227\340\246\276\340\246\207\340\246\241 (Solar Panel Sizing):\",\n                            fontWeight = FontWeight.Bold,\n                            style = MaterialTheme.typography.bodyMedium\n                        )\n                        Text(\n                            \"\342\200\242 \340\246\206\340\246\252\340\246\250\340\246\276\340\246\260 ${viewModel.totalWattHours.toInt()} Wh \340\246\254\340\247\215\340\246\257\340\246\276\340\246\237\340\246\276\340\246\260\340\246\277 \340\247\253 \340\246\230\340\246\243\340\247\215\340\246\237\340\246\276\340\246\260 \340\246\260\340\247\214\340\246\246\340\247\215\340\246\260\340\247\207 \340\246\252\340\247\201\340\246\260\340\247\213\340\246\252\340\247\201\340\246\260\340\246\277 \340\246\260\340\246\277\340\246\232\340\246\276\340\246\260\340\247\215\340\246\234 \340\246\225\340\246\260\340\246\244\340\247\207 \340\246\250\340\247\215\340\246\257\340\247\202\340\246\250\340\246\244\340\246\256 ${viewModel.recommendedSolarWatts.roundToInt()} \340\246\223\340\247\237\340\246\276\340\246\237\340\247\207\340\246\260 \340\246\252\340\247\215\340\246\257\340\246\276\340\246\250\340\247\207\340\246\262 \340\246\205\340\247\215\340\246\257\340\246\276\340\246\260\340\247\207 \340\246\262\340\246\276\340\246\227\340\246\254\340\247\207\340\245\244\",\n                            style = MaterialTheme.typography.bodySmall\n                        )\n                    }\n                }\n            }\n        } else {\n            Card(\n                colors = CardDefaults.cardColors(\n                    containerColor = MaterialTheme.colorScheme.surfaceVariant.copy(alpha = 0.4f)\n                ),\n                modifier = Modifier.fillMaxWidth()\n            ) {\n                Box(modifier = Modifier.padding(16.dp), contentAlignment = Alignment.Center) {\n                    Text(\n                        text = \"\340\246\241\340\246\277\340\246\255\340\246\276\340\246\207\340\246\270 \340\246\270\340\246\277\340\246\262\340\247\207\340\246\225\340\247\215\340\246\237 \340\246\225\340\246\260\340\246\276 \340\246\245\340\246\276\340\246\225\340\246\262\340\247\207 \340\246\207\340\246\250\340\246\255\340\246\276\340\246\260\340\247\215\340\246\237\340\246\276\340\246\260 \340\246\223 \340\246\225\340\247\215\340\246\257\340\246\276\340\246\254\340\246\262\340\247\207\340\246\260 \340\246\270\340\247\215\340\246\252\340\247\207\340\246\270\340\246\277\340\246\253\340\246\277\340\246\225\340\247\207\340\246\266\340\246\250 \340\246\227\340\246\276\340\246\207\340\246\241\340\246\262\340\246\276\340\246\207\340\246\250 \340\246\217\340\246\226\340\246\276\340\246\250\340\247\207 \340\246\246\340\247\207\340\246\226\340\246\244\340\247\207 \340\246\252\340\246\276\340\246\254\340\247\207\340\246\250\340\245\244\",\n                        style = MaterialTheme.typography.bodySmall,\n                        textAlign = TextAlign.Center,\n                        color = MaterialTheme.colorScheme.onSurfaceVariant\n                    )\n                }\n            }\n        }\n    }\n}\n\n@Composable\nfun BulletPoint(text: String) {\n    Row(\n        modifier = Modifier\n            .fillMaxWidth()\n            .padding(vertical = 2.dp),\n        verticalAlignment = Alignment.Top\n    ) {\n        Text(\"\342\200\242 \", fontWeight = FontWeight.ExtraBold, color = MaterialTheme.colorScheme.primary)\n        Text(\n            text = text,\n            style = MaterialTheme.typography.bodySmall,\n            color = MaterialTheme.colorScheme.onSurfaceVariant\n        )\n    }\n}\n\n// Helpers\nfun borderStroke(width: androidx.compose.ui.unit.Dp, color: Color) =\n    androidx.compose.foundation.BorderStroke(width, color)\n\n\n// TAB 4: Saved Systems History Tab\n@Composable\nfun SavedSystemsTab(\n    savedConfigs: List<BatteryConfig>,\n    onLoadConfig: (BatteryConfig) -> Unit,\n    onDeleteConfig: (Int) -> Unit\n) {\n    if (savedConfigs.isEmpty()) {\n        Box(\n            modifier = Modifier\n                .fillMaxSize()\n                .padding(32.dp),\n            contentAlignment = Alignment.Center\n        ) {\n            Column(\n                horizontalAlignment = Alignment.CenterHorizontally,\n                verticalArrangement = Arrangement.Center\n            ) {\n                Icon(\n                    imageVector = Icons.Default.History,\n                    contentDescription = null,\n                    modifier = Modifier.size(64.dp),\n                    tint = MaterialTheme.colorScheme.onSurfaceVariant.copy(alpha = 0.4f)\n                )\n                Spacer(modifier = Modifier.height(12.dp))\n                Text(\n                    text = \"\340\246\225\340\247\213\340\246\250\340\247\213 \340\246\270\340\247\207\340\246\255 \340\246\225\340\246\260\340\246\276 \340\246\252\340\247\215\340\246\257\340\246\276\340\246\225 \340\246\250\340\247\207\340\246\207\",\n                    fontWeight = FontWeight.Bold,\n                    style = MaterialTheme.typography.titleMedium,\n                    color = MaterialTheme.colorScheme.onSurfaceVariant\n                )\n                Text(\n                    text = \"\340\246\217\340\246\225\340\246\237\340\246\277 \340\246\254\340\247\215\340\246\257\340\246\276\340\246\237\340\246\276\340\246\260\340\246\277 \340\246\252\340\247\215\340\246\257\340\246\276\340\246\225 \340\246\244\340\247\210\340\246\260\340\246\277 \340\246\254\340\246\276 \340\246\225\340\246\276\340\246\270\340\247\215\340\246\237\340\246\256\340\246\276\340\246\207\340\246\234 \340\246\225\340\246\260\340\247\207 \340\246\225\340\247\215\340\246\257\340\246\276\340\246\262\340\246\225\340\247\201\340\246\262\340\247\207\340\246\237\340\246\260 \340\246\245\340\247\207\340\246\225\340\247\207 \340\246\270\340\247\207\340\246\255 \340\246\225\340\246\260\340\247\207 \340\246\260\340\246\276\340\246\226\340\247\201\340\246\250\340\245\244\",\n                    style = MaterialTheme.typography.bodySmall,\n                    textAlign = TextAlign.Center,\n                    color = MaterialTheme.colorScheme.onSurfaceVariant.copy(alpha = 0.7f),\n                    modifier = Modifier.padding(top = 4.dp)\n                )\n            }\n        }\n    } else {\n        LazyColumn(\n            modifier = Modifier\n                .fillMaxSize()\n                .padding(horizontal = 16.dp),\n            verticalArrangement = Arrangement.spacedBy(10.dp)\n        ) {\n            item {\n                Text(\n                    text = \"\340\246\270\340\246\202\340\246\260\340\246\225\340\247\215\340\246\267\340\246\277\340\246\244 \340\246\241\340\246\277\340\246\234\340\246\276\340\246\207\340\246\250\340\246\270\340\246\256\340\247\202\340\246\271\",\n                    style = MaterialTheme.typography.titleMedium,\n                    fontWeight = FontWeight.Bold,\n                    color = MaterialTheme.colorScheme.primary,\n                    modifier = Modifier.padding(vertical = 8.dp)\n                )\n            }\n\n            items(savedConfigs, key = { it.id }) { config ->\n                val nominalV = config.seriesCells * 3.2\n                val totalKwh = (nominalV * config.cellCapacityAh) / 1000.0\n                val usableKwh = totalKwh * (config.depthOfDischargePercent / 100.0)\n\n                Card(\n                    modifier = Modifier\n                        .fillMaxWidth()\n                        .clickable { onLoadConfig(config) }\n                        .testTag(\"saved_config_item_${config.id}\"),\n                    colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.surface)\n                ) {\n                    Row(\n                        modifier = Modifier\n                            .fillMaxWidth()\n                            .padding(16.dp),\n                        verticalAlignment = Alignment.CenterVertically,\n                        horizontalArrangement = Arrangement.SpaceBetween\n                    ) {\n                        Column(modifier = Modifier.weight(1f)) {\n                            Text(\n                                text = config.name,\n                                fontWeight = FontWeight.Bold,\n                                style = MaterialTheme.typography.bodyLarge,\n                                color = MaterialTheme.colorScheme.onSurface\n                            )\n                            Spacer(modifier = Modifier.height(4.dp))\n                            Text(\n                                text = \"${config.seriesCells}S ${config.parallelCells}P \342\200\242 ${nominalV.format(1)}V \342\200\242 ${config.cellCapacityAh.toInt()}Ah Rated\",\n                                style = MaterialTheme.typography.bodySmall,\n                                color = MaterialTheme.colorScheme.onSurfaceVariant\n                            )\n                            Text(\n                                text = \"\340\246\254\340\247\215\340\246\257\340\246\254\340\246\271\340\246\276\340\246\260\340\246\257\340\247\213\340\246\227\340\247\215\340\246\257: ${usableKwh.format(2)} kWh (${config.depthOfDischargePercent.roundToInt()}% DoD)\",\n                                style = MaterialTheme.typography.bodySmall,\n                                color = MaterialTheme.colorScheme.primary,\n                                fontWeight = FontWeight.SemiBold\n                            )\n                        }\n\n                        IconButton(\n                            onClick = { onDeleteConfig(config.id) },\n                            modifier = Modifier.testTag(\"delete_config_${config.id}\")\n                        ) {\n                            Icon(\n                                imageVector = Icons.Default.Delete,\n                                contentDescription = \"Delete design\",\n                                tint = MaterialTheme.colorScheme.error.copy(alpha = 0.8f)\n                            )\n                        }\n                    }\n                }\n            }\n        }\n    }\n}\n"
    }
