        }
        lines {
          text: "                        drawRoundRect("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                            color = Color.LightGray.copy(alpha = 0.5f),"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                            topLeft = Offset(mainBodyWidth, (mainBodyHeight - capHeight) / 2),"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                            size = Size(capWidth, capHeight),"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
