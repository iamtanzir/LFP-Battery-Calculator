          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                                        text = \"\340\246\254\340\247\207\340\246\270 \340\246\262\340\246\276\340\246\207\340\246\253: ${choice.baseCycles} \340\246\270\340\246\276\340\246\207\340\246\225\340\247\207\340\246\262 \342\200\242 \340\246\253\340\246\260\340\247\215\340\246\256: ${if (choice.form == LfpCellForm.CYLINDRICAL) \"Cylindrical\" else \"Prismatic\"}\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
