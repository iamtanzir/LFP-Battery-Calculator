          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                // Slider for Series S Count"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                Slider("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                    value = viewModel.seriesCells.toFloat(),"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                    onValueChange = { viewModel.seriesCells = it.roundToInt() },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                    valueRange = 1f..32f,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                    steps = 30,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
