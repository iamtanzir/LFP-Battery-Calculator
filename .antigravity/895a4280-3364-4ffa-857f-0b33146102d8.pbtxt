ing(16.dp)\n        ) {\n            Text(\n                text = t(\"unit_converter\"),\n                style = MaterialTheme.typography.titleMedium,\n                fontWeight = FontWeight.Bold,\n                color = MaterialTheme.colorScheme.primary,\n                modifier = Modifier.padding(bottom = 8.dp)\n            )\n            Text(\n                text = t(\"unit_converter_desc\"),\n                style = MaterialTheme.typography.bodySmall,\n                color = MaterialTheme.colorScheme.onSurfaceVariant,\n                modifier = Modifier.padding(bottom = 16.dp)\n            )\n\n            // Input field for conversion value\n            OutlinedTextField(\n                value = convertValueStr,\n                onValueChange = { newValue ->\n                    // Validate input (allow only numbers and dots)\n                    if (newValue.matches(Regex(\"^[0-9.]*$\"))) {\n                        convertValueStr = newValue\n                    }\n                },\n                label = { Text(t(\"value_to_convert\")) },\n                keyboardOptions = KeyboardOptions(keyboardType = KeyboardType.Number),\n                modifier = Modifier.fillMaxWidth()\n            )\n\n            // From Unit Dropdown\n            Row(\n                modifier = Modifier\n                    .fillMaxWidth()\n                    .padding(top = 16.dp),\n                horizontalArrangement = Arrangement.SpaceBetween,\n                verticalAlignment = Alignment.CenterVertically\n            ) {\n                Text(\"From: $fromUnit\")\n                IconButton(onClick = { fromExpanded = true }) {\n                    Icon(Icons.Filled.ArrowDropDown, \"Dropdown\")\n                }\n            }\n            DropdownMenu(\n                expanded = fromExpanded,\n                onDismissRequest = { fromExpanded = false },\n            ) {\n                units.forEach { unit ->\n                    DropdownMenuItem(\n          