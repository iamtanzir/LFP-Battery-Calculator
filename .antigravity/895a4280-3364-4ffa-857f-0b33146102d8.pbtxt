        }
        lines {
          text: "                    },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    modifier = Modifier.testTag(\"save_config_confirm\")"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
