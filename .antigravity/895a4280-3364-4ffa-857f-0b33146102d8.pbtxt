        }
        lines {
          text: "        colors = CardDefaults.cardColors("
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            containerColor = MaterialTheme.colorScheme.surfaceVariant.copy(alpha = 0.35f)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
