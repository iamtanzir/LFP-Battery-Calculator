          text: "            .padding(16.dp),"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        verticalArrangement = Arrangement.spacedBy(16.dp)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    ) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        // Series & Voltage Section"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        Card("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            modifier = Modifier.fillMaxWidth(),"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.surface)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        ) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            Column(modifier = Modifier.padding(16.dp)) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                Row("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                    modifier = Modifier.fillMaxWidth(),"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                    horizontalArrangement = Arrangement.SpaceBetween,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                    verticalAlignment = Alignment.CenterVertically"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                ) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                    Text("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                        text = \"Series Cells (Nominal Voltage)\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                        fontWeight = FontWeight.Bold,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                        style = MaterialTheme.typography.titleMedium"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                    )"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                    Text("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                        text = \"${viewModel.seriesCells}S (${viewModel.packNominalVoltage}V)\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                        fontWeight = FontWeight.ExtraBold,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                        color = MaterialTheme.colorScheme.primary,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                        style = MaterialTheme.typography.titleMedium"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                    )"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
