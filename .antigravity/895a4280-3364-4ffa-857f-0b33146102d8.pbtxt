        lines {
          text: "                        Text(\"\340\246\252\340\246\277\340\246\225 \340\246\270\340\246\276\340\246\260\340\247\215\340\246\234 \340\246\262\340\247\213\340\246\241 (\340\247\247\340\247\246 \340\246\270\340\247\207\340\246\225\340\247\207\340\246\250\340\247\215\340\246\241):\", style = MaterialTheme.typography.bodyMedium)"
