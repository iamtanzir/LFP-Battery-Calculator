247\253 \340\246\230\340\246\243\340\247\215\340\246\237\340\246\276\340\246\260 \340\246\260\340\247\214\340\246\246\340\247\215\340\246\260\340\247\207 \340\246\252\340\247\201\340\246\260\340\247\213\340\246\252\340\247\201\340\246\260\340\246\277 \340\246\260\340\246\277\340\246\232\340\246\276\340\246\260\340\247\215\340\246\234 \340\246\225\340\246\260\340\246\244\340\247\207 \340\246\250\340\247\215\340\246\257\340\247\202\340\246\250\340\246\244\340\246\256 ${viewModel.recommendedSolarWatts.roundToInt()} \340\246\223\340\247\237\340\246\276\340\246\237\340\247\207\340\246\260 \340\246\252\340\247\215\340\246\257\340\246\276\340\246\250\340\247\207\340\246\262 \340\246\205\340\247\215\340\246\257\340\246\276\340\246\260\340\247\207 \340\246\262\340\246\276\340\246\227\340\246\254\340\247\207\340\245\244\"\n        \"zh\" -> \"\342\200\242 \345\234\2505\345\260\217\346\227\266\346\234\211\346\225\210\345\205\211\347\205\247\344\270\213\345\256\214\345\205\250\345\205\205\346\273\241\346\202\250\347\232\204 ${viewModel.totalWattHours.toInt()} Wh \347\224\265\346\261\240\357\274\214\350\207\263\345\260\221\351\234\200\350\246\201 ${viewModel.recommendedSolarWatts.roundToInt()} \347\223\246\347\211\271\347\232\204\345\244\252\351\230\263\350\203\275\347\224\265\346\261\240\346\235\277\343\200\202\"\n        \"de\" -> \"\342\200\242 Um Ihre ${viewModel.totalWattHours.toInt()} Wh Batterie in 5 Sonnenstunden vollst\303\244ndig aufzuladen, sind mindestens ${viewModel.recommendedSolarWatts.roundToInt()} W Solarmodule erforderlich.\"\n        \"ko\" -> \"\342\200\242 ${viewModel.totalWattHours.toInt()} Wh \353\260\260\355\204\260\353\246\254\353\245\274 \355\225\230\353\243\250 5\354\213\234\352\260\204 \354\235\274\354\241\260 \354\213\234\352\260\204 \352\270\260\354\244\200 \354\231\204\354\266\251\355\225\230\352\270\260 \354\234\204\355\225\264\354\204\234\353\212\224 \354\265\234\354\206\214 ${viewModel.recommendedSolarWatts.roundToInt()} W \355\203\234\354\226\221\352\264\221 \355\214\250\353\204\220 \354\226\264\353\240\210\354\235\264\352\260\200 \352\266\214\354\236\245\353\220\251\353\213\210\353\213\244.\"\n        else -> \"\342\200\242 To fully recharge your ${viewModel.totalWattHours.toInt()} Wh battery bank in 5 peak sun hours, a solar PV array of at least ${viewModel.recommendedSolarWatts.roundToInt()} Watts is required.\"\n    }\n    val emptyWarning = when (viewModel.appLanguage) {\n        \"bn\" -> \"\340\246\241\340\246\277\340\246\255\340\246\276\340\246\207\340\246\270 \340\246\270\340\246\277\340\246\262\340\247\207\340\246\225\340\247\215\340\246\237 \340\246\225\340\246\260\340\246\276 \340\246\245\340\246\276\340\246\225\340\246\262\340\247\207 \340\246\207\340\246\250\340\246\255\340\246\276\340\246\260\340\247\215\340\246\237\340\246\276\340\246\260 \340\246\223 \340\246\225\340\247\215\340\246\257\340\246\276\340\246\254\340\246\262\340\247\207\340\246\260 \340\246\270\340\247\215\340\246\252\340\247\207\340\246\270\340\246\277\340\246\253\340\246\277\340\246\225\340\247\207\340\246\266\340\246\250 \340\246\227\340\246\276\340\246\207\340\246\241\340\246\262\340\246\276\340\246\207\340\246\250 \340\246\217\340\246\226\340\246\276\340\246\250\340\247\207 \340\246\246\340\247\207\340\246\226\340\246\244\340\247\207 \340\246\252\340\246\276\340\246\254\340\247\207\340\246\250\340\245\244\"\n        \"zh\" -> \"\351\200\211\346\213\251\345\256\266\347\224\265\350\264\237\350\275\275\345\220\216\357\274\214\346\255\244\345\244\204\345\260\206\346\230\276\347\244\272\351\200\206\345\217\230\345\231\250\343\200\201\347\224\265\347\274\206\344\270\216\351\205\215\345\245\227\350\276\205\346\226\231\347\232\204\346\216\250\350\215\220\350\247\204\346\240\274\346\214\207\345\215\227\343\200\202\"\n        \"de\" -> \"W\303\244hlen Sie Verbraucher aus, um hier Spezifikationen f\303\274r Wechselrichter und Kabel zu sehen.\"\n        \"ko\" -> \"\352\260\200\354\240\204 \353\266\200\355\225\230\353\245\274 \354\204\240\355\203\235\355\225\230\354\213\234\353\251\264 \354\235\270\353\262\204\355\204\260, DC \354\274\200\354\235\264\353\270\224 \353\223\261\354\235\230 \354\266\224\354\262\234 \352\260\200\354\235\264\353\223\234\353\235\274\354\235\270\354\235\264 \354\227\254\352\270\260\354\227\220 \355\221\234\354\213\234\353\220\251\353\213\210\353\213\244.\"\n        else -> \"Select household appliances first to see custom inverter, cabling, and engineering specifications.\"\n    }\n\n    Column(\n        modifier = Modifier\n            .fillMaxSize()\n            .verticalScroll(scrollState)\n            .padding(12.dp),\n        verticalArrangement = Arrangement.spacedBy(14.dp)\n    ) {\n        // Grid Selector\n        Card(\n            modifier = Modifier.fillMaxWidth(),\n            colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.surface)\n        ) {\n            Column(modifier = Modifier.padding(16.dp)) {\n                Text(\n                    text = t(\"solar_grid_title\"),\n                    fontWeight = FontWeight.Bold,\n                    style = MaterialTheme.typography.titleMedium,\n                    color = MaterialTheme.colorScheme.primary\n                )\n                Text(\n                    text = t(\"select_grid_type\"),\n                    style = MaterialTheme.typography.bodySmall,\n                    color = MaterialTheme.colorScheme.onSurfaceVariant,\n                    modifier = Modifier.padding(bottom = 12.dp)\n                )\n\n                Row(\n                    modifier = Modifier.fillMaxWidth(),\n                    horizontalArrangement = Arrangement.spacedBy(8.dp)\n                ) {\n                    val gridTypes = listOf(\n                        \"offgrid\" to t(\"offgrid\"),\n                        \"ongrid\" to t(\"ongrid\"),\n                        \"hybrid\" to t(\"hybrid\")\n                    )\n                    gridTypes.forEach { (type, label) ->\n                        val selected = viewModel.selectedGridType == type\n                        ElevatedFilterChip(\n                            selected = selected,\n                            onClick = { viewModel.selectedGridType = type },\n                            label = { Text(label, fontSize = 11.sp, fontWeight = FontWeight.Bold) },\n                            modifier = Modifier.weight(1f)\n                        )\n                    }\n                }\n            }\n        }\n\n        // Dynamic guidelines based on selection\n        Card(\n            modifier = Modifier.fillMaxWidth(),\n            colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.surface)\n        ) {\n            Column(modifier = Modifier.padding(16.dp)) {\n                when (viewModel.selectedGridType) {\n                    \"offgrid\" -> {\n                        Text(\n                            text = offgridTitle,\n                            fontWeight = FontWeight.Bold,\n                            style = MaterialTheme.typography.titleMedium,\n                            color = MaterialTheme.colorScheme.primary\n                        )\n                        Spacer(modifier = Modifier.height(8.dp))\n                        Text(\n                            text = offgridDesc,\n                            style = MaterialTheme.typography.bodyMedium,\n                            color = MaterialTheme.colorScheme.onSurface\n                        )\n                        Spacer(modifier = Modifier.height(12.dp))\n\n                        Text(advantagesLabel, fontWeight = FontWeight.Bold, color = BatteryFull)\n                        BulletPoint(offgridAdv1)\n                        BulletPoint(offgridAdv2)\n                        BulletPoint(offgridAdv3)\n\n                        Spacer(modifier = Modifier.height(8.dp))\n\n                        Text(disadvantagesLabel, fontWeight = FontWeight.Bold, color = BatteryLow)\n                        BulletPoint(offgridDis1)\n                        BulletPoint(offgridDis2)\n                    }\n                    \"ongrid\" -> {\n                        Text(\n                            text = ongridTitle,\n                            fontWeight = FontWeight.Bold,\n                            style = MaterialTheme.typography.titleMedium,\n                            color = MaterialTheme.colorScheme.primary\n                        )\n                        Spacer(modifier = Modifier.height(8.dp))\n                        Text(\n                            text = ongridDesc,\n                            style = MaterialTheme.typography.bodyMedium,\n                            color = MaterialTheme.colorScheme.onSurface\n                        )\n                        Spacer(modifier = Modifier.height(12.dp))\n\n                        Text(advantagesLabel, fontWeight = FontWeight.Bold, color = BatteryFull)\n                        BulletPoint(ongridAdv1)\n                        BulletPoint(ongridAdv2)\n                        BulletPoint(ongridAdv3)\n\n                        Spacer(modifier = Modifier.height(8.dp))\n\n                        Text(disadvantagesLabel, fontWeight = FontWeight.Bold, color = BatteryLow)\n                        BulletPoint(onggridDis1)\n                        BulletPoint(ongridDis2)\n                    }\n                    \"hybrid\" -> {\n                        Text(\n                            text = hybridTitle,\n                            fontWeight = FontWeight.Bold,\n                            style = MaterialTheme.typography.titleMedium,\n                            color = MaterialTheme.colorScheme.primary\n                        )\n                        Spacer(modifier = Modifier.height(8.dp))\n                        Text(\n                            text = hybridDesc,\n                            style = MaterialTheme.typography.bodyMedium,\n                            color = MaterialTheme.colorScheme.onSurface\n                        )\n                        Spacer(modifier = Modifier.height(12.dp))\n\n                        Text(advantagesLabel, fontWeight = FontWeight.Bold, color = BatteryFull)\n                        BulletPoint(hybridAdv1)\n                        BulletPoint(hybridAdv2)\n                        BulletPoint(hybridAdv3)\n\n                        Spacer(modifier = Modifier.height(8.dp))\n\n                        Text(disadvantagesLabel, fontWeight = FontWeight.Bold, color = BatteryLow)\n                        BulletPoint(hybridDis1)\n                    }\n                }\n            }\n        }\n\n        // Custom tailored design specifications panel\n        if (viewModel.totalRunningWatts > 0) {\n            Card(\n                colors = CardDefaults.cardColors(\n                    containerColor = MaterialTheme.colorScheme.primaryContainer.copy(alpha = 0.15f)\n                ),\n                modifier = Modifier.fillMaxWidth(),\n                shape = RoundedCornerShape(12.dp),\n                border = borderStroke(1.dp, MaterialTheme.colorScheme.primary.copy(alpha = 0.2f))\n            ) {\n                Column(modifier = Modifier.padding(16.dp)) {\n                    Text(\n                        text = guideHeader,\n                        fontWeight = FontWeight.Bold,\n                        style = MaterialTheme.typography.titleMedium,\n                        color = MaterialTheme.colorScheme.primary\n                    )\n                    Spacer(modifier = Modifier.height(4.dp))\n                    Text(\n                        text = guideSubHeader,\n                        style = MaterialTheme.typography.bodySmall,\n                        color = MaterialTheme.colorScheme.onSurfaceVariant\n                    )\n\n                    Spacer(modifier = Modifier.height(12.dp))\n\n                    // Inverter guide\n                    Text(\n                        text = invTitle,\n                        fontWeight = FontWeight.Bold,\n                        style = MaterialTheme.typography.bodyMedium\n                    )\n                    Text(\n                        text = invMinSize,\n                        style = MaterialTheme.typography.bodySmall\n                    )\n                    Text(\n                        text = invSurgeSize,\n                        style = MaterialTheme.typography.bodySmall,\n                        color = Color(0xFFE64A19),\n                        fontWeight = FontWeight.SemiBold\n                    )\n\n                    Spacer(modifier = Modifier.height(8.dp))\n\n                    // Cabling guide\n                    Text(\n                        text = cableTitle,\n                        fontWeight = FontWeight.Bold,\n                        style = MaterialTheme.typography.bodyMedium\n                    )\n                    Text(\n                        text = maxCurrent,\n                        style = MaterialTheme.typography.bodySmall\n                    )\n                    Text(\n                        text = startCurrent,\n                        style = MaterialTheme.typography.bodySmall\n                    )\n                    Text(\n                        text = recommendedCable,\n                        style = MaterialTheme.typography.bodySmall,\n                        fontWeight = FontWeight.Bold,\n                        color = GreenPrimaryLight\n                    )\n                    Text(\n                        text = recommendedFuse,\n                        style = MaterialTheme.typography.bodySmall\n                    )\n\n                    Spacer(modifier = Modifier.height(8.dp))\n\n                    // Solar array recharge estimate\n                    if (viewModel.selectedGridType != \"ongrid\") {\n                        Text(\n                            text = solarTitle,\n                            fontWeight = FontWeight.Bold,\n                            style = MaterialTheme.typography.bodyMedium\n                        )\n                        Text(\n                            text = solarDesc,\n                            style = MaterialTheme.typography.bodySmall\n                        )\n                    }\n                }\n            }\n        } else {\n            Card(\n                colors = CardDefaults.cardColors(\n                    containerColor = MaterialTheme.colorScheme.surfaceVariant.copy(alpha = 0.4f)\n                ),\n                modifier = Modifier.fillMaxWidth()\n            ) {\n                Box(modifier = Modifier.padding(16.dp), contentAlignment = Alignment.Center) {\n                    Text(\n                        text = emptyWarning,\n                        style = MaterialTheme.typography.bodySmall,\n                        textAlign = TextAlign.Center,\n                        color = MaterialTheme.colorScheme.onSurfaceVariant\n                    )\n                }\n            }\n        }\n    }\n}"
    }
