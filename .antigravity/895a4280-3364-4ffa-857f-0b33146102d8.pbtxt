          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                        Text(\"\340\246\252\340\247\215\340\246\260\340\247\237\340\247\213\340\246\234\340\246\250\340\247\200\340\247\237 \340\246\266\340\246\225\340\247\215\340\246\244\340\246\277 (Wh):\", style = MaterialTheme.typography.bodyMedium)"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
