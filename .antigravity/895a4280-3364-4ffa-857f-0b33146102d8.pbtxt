        }
        lines {
          text: "// TAB 2: Configurable LFP battery cells & pack details calculator"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "@Composable"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
