        lines {
          text: "        \"de\" -> \"Hybridsysteme kombinieren On-Grid und Off-Grid. Sie k\303\266nnen Strom ins Netz einspeisen und bieten gleichzeitig Akku-Backup bei Netzausfall.\""
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
