          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                                Spacer(modifier = Modifier.width(4.dp))"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                                Column {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                                    Text("
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
