    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "// TAB 2: Configurable LFP battery cells & pack details calculator\n@Composable\nfun CalculatorConfigTab(\n    viewModel: BatteryViewModel,\n    onSaveClicked: () -> Unit\n) {\n    val scrollState = rememberScrollState()\n\n    Column(\n        modifier = Modifier\n            .fillMaxSize()\n            .verticalScroll(scrollState)\n            .padding(12.dp),\n        verticalArrangement = Arrangement.spacedBy(14.dp)\n    ) {\n        // Cell choice section (From 15Ah to 314Ah)\n        Card(\n            modifier = Modifier.fillMaxWidth(),\n            colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.surface)\n        ) {\n            Column(modifier = Modifier.padding(16.dp)) {\n                Text(\n                    text = \"LFP \340\246\270\340\247\207\340\246\262 \340\246\270\340\246\277\340\246\262\340\247\207\340\246\225\340\246\266\340\246\250 (15Ah - 314Ah)\",\n                    fontWeight = FontWeight.Bold,\n                    style = MaterialTheme.typography.titleMedium,\n                    color = MaterialTheme.colorScheme.primary\n                )\n                Text(\n                    text = \"\340\246\206\340\246\252\340\246\250\340\246\276\340\246\260 \340\246\254\340\247\215\340\246\257\340\246\276\340\246\237\340\246\276\340\246\260\340\246\277\340\246\260 \340\246\270\340\247\207\340\246\262 \340\246\237\340\246\276\340\246\207\340\246\252 \340\246\250\340\246\277\340\246\260\340\247\215\340\246\254\340\246\276\340\246\232\340\246\250 \340\246\225\340\246\260\340\247\201\340\246\250\340\245\244 \340\246\217\340\246\237\340\246\277 \340\246\205\340\246\237\340\247\213\340\246\256\340\247\207\340\246\237\340\246\277\340\246\225 \340\246\270\340\246\276\340\246\207\340\246\225\340\247\207\340\246\262 \340\246\262\340\246\276\340\246\207\340\246\253 \340\246\250\340\246\277\340\246\260\340\247\215\340\246\247\340\246\276\340\246\260\340\246\243 \340\246\225\340\246\260\340\246\254\340\247\207\340\245\244\",\n                    style = MaterialTheme.typography.bodySmall,\n                    color = MaterialTheme.colorScheme.onSurfaceVariant,\n                    modifier = Modifier.padding(bottom = 12.dp)\n                )\n\n                // Grid selection of Cell choices\n                Column(verticalArrangement = Arrangement.spacedBy(8.dp)) {\n                    viewModel.cellChoices.forEach { choice ->\n                        val selected = viewModel.selectedCellChoice.id == choice.id\n                        val cardBg = if (selected) MaterialTheme.colorScheme.primaryContainer.copy(alpha = 0.25f) else MaterialTheme.colorScheme.surfaceVariant.copy(alpha = 0.2f)\n                        val border = if (selected) borderStroke(1.5.dp, MaterialTheme.colorScheme.primary) else borderStroke(0.5.dp, Color.LightGray.copy(alpha = 0.5f))\n\n                        Row(\n                            modifier = Modifier\n                                .fillMaxWidth()\n                                .clip(RoundedCornerShape(8.dp))\n                                .background(cardBg)\n                                .border(border, RoundedCornerShape(8.dp))\n                                .clickable { viewModel.applyCellChoice(choice.id) }\n                                .padding(12.dp),\n                            horizontalArrangement = Arrangement.SpaceBetween,\n                            verticalAlignment = Alignment.CenterVertically\n                        ) {\n                            Row(verticalAlignment = Alignment.CenterVertically) {\n                                RadioButton(\n                                    selected = selected,\n                                    onClick = { viewModel.applyCellChoice(choice.id) }\n                                )\n                                Spacer(modifier = Modifier.width(4.dp))\n                                Column {\n                                    Text(\n                                        text = choice.modelName,\n                                        fontWeight = FontWeight.Bold,\n                                        style = MaterialTheme.typography.bodyMedium\n                                    )\n                                    Text(\n                                        text = \"\340\246\254\340\247\207\340\246\270 \340\246\262\340\246\276\340\246\207\340\246\253: ${choice.baseCycles} \340\246\270\340\246\276\340\246\207\340\246\225\340\247\207\340\246\262 \342\200\242 \340\246\253\340\246\260\340\247\215\340\246\256: ${if (choice.form == LfpCellForm.CYLINDRICAL) \"Cylindrical\" else \"Prismatic\"}\",\n                                        style = MaterialTheme.typography.labelSmall,\n                                        color = MaterialTheme.colorScheme.onSurfaceVariant\n                                    )\n                                }\n                            }\n\n                            Text(\n                                text = \"${choice.capacityAh.toInt()} Ah\",\n                                fontWeight = FontWeight.Bold,\n                                color = MaterialTheme.colorScheme.primary,\n                                style = MaterialTheme.typography.bodyMedium\n                            )\n                        }\n                    }\n                }\n            }\n        }\n\n        // Series count & Voltage configuration\n        Card(\n            modifier = Modifier.fillMaxWidth(),\n            colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.surface)\n        ) {\n            Column(modifier = Modifier.padding(16.dp)) {\n                Row(\n                    modifier = Modifier.fillMaxWidth(),\n                    horizontalArrangement = Arrangement.SpaceBetween,\n                    verticalAlignment = Alignment.CenterVertically\n                ) {\n                    Text(\n                        text = \"\340\246\270\340\246\277\340\246\260\340\246\277\340\246\234 \340\246\270\340\247\207\340\246\262 \340\246\223 \340\246\255\340\247\213\340\246\262\340\247\215\340\246\237\340\247\207\340\246\234 (Series - S)\",\n                        fontWeight = FontWeight.Bold,\n                        style = MaterialTheme.typography.titleMedium\n                    )\n                    Text(\n                        text = \"${viewModel.seriesCells}S (${viewModel.packNominalVoltage.format(1)} V)\",\n                        fontWeight = FontWeight.ExtraBold,\n                        color = MaterialTheme.colorScheme.primary,\n                        style = MaterialTheme.typography.titleMedium\n                    )\n                }\n\n                Spacer(modifier = Modifier.height(8.dp))\n\n                Slider(\n                    value = viewModel.seriesCells.toFloat(),\n                    onValueChange = { viewModel.seriesCells = it.roundToInt() },\n                    valueRange = 1f..32f,\n                    steps = 30,\n                    modifier = Modifier.fillMaxWidth()\n                )\n\n                Spacer(modifier = Modifier.height(4.dp))\n\n                // Standard S quick buttons\n                Row(\n                    modifier = Modifier.fillMaxWidth(),\n                    horizontalArrangement = Arrangement.spacedBy(8.dp)\n                ) {\n                    val quickVoltages = listOf(\n                        4 to \"12V (4S)\",\n                        8 to \"24V (8S)\",\n                        16 to \"48V (16S)\"\n                    )\n                    quickVoltages.forEach { (sCount, label) ->\n                        val selected = viewModel.seriesCells == sCount\n                        SuggestionChip(\n                            onClick = { viewModel.applySVoltPreset(sCount) },\n                            label = { Text(label) },\n                            colors = SuggestionChipDefaults.suggestionChipColors(\n                                containerColor = if (selected) MaterialTheme.colorScheme.primaryContainer else Color.Transparent,\n                                labelColor = if (selected) MaterialTheme.colorScheme.onPrimaryContainer else MaterialTheme.colorScheme.onSurface\n                            ),\n                            modifier = Modifier.weight(1f)\n                        )\n                    }\n                }\n            }\n        }\n\n        // Parallel count settings\n        Card(\n            modifier = Modifier.fillMaxWidth(),\n            colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.surface)\n        ) {\n            Column(modifier = Modifier.padding(16.dp)) {\n                Row(\n                    modifier = Modifier.fillMaxWidth(),\n                    horizontalArrangement = Arrangement.SpaceBetween,\n                    verticalAlignment = Alignment.CenterVertically\n                ) {\n                    Text(\n                        text = \"\340\246\252\340\247\215\340\246\257\340\246\276\340\246\260\340\246\276\340\246\262\340\246\276\340\246\262 \340\246\270\340\247\207\340\246\262 \340\246\223 \340\246\256\340\247\213\340\246\237 \340\246\217\340\246\256\340\247\215\340\246\252\340\246\277\340\246\257\340\246\274\340\246\276\340\246\260 (Parallel - P)\",\n                        fontWeight = FontWeight.Bold,\n                        style = MaterialTheme.typography.titleMedium\n                    )\n                    Text(\n                        text = \"${viewModel.parallelCells}P (${viewModel.packCapacityAh.toInt()} Ah)\",\n                        fontWeight = FontWeight.ExtraBold,\n                        color = MaterialTheme.colorScheme.primary,\n                        style = MaterialTheme.typography.titleMedium\n                    )\n                }\n\n                Spacer(modifier = Modifier.height(8.dp))\n\n                Slider(\n                    value = viewModel.parallelCells.toFloat(),\n                    onValueChange = { viewModel.parallelCells = it.roundToInt() },\n                    valueRange = 1f..16f,\n                    steps = 14,\n                    modifier = Modifier.fillMaxWidth()\n                )\n            }\n        }\n\n        // Discharge depth settings\n        Card(\n            modifier = Modifier.fillMaxWidth(),\n            colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.surface)\n        ) {\n            Column(modifier = Modifier.padding(16.dp)) {\n                Row(\n                    modifier = Modifier.fillMaxWidth(),\n                    horizontalArrangement = Arrangement.SpaceBetween,\n                    verticalAlignment = Alignment.CenterVertically\n                ) {\n                    Text(\n                        text = \"\340\246\241\340\246\277\340\246\270\340\246\232\340\246\276\340\246\260\340\247\215\340\246\234 \340\246\241\340\247\207\340\246\252\340\246\245 \340\246\270\340\247\207\340\246\237\340\246\277\340\246\202\340\246\270 (DoD %)\",\n                        fontWeight = FontWeight.Bold,\n                        style = MaterialTheme.typography.titleMedium\n                    )\n                    Text(\n                        text = \"${viewModel.depthOfDischargePercent.roundToInt()}%\",\n                        fontWeight = FontWeight.ExtraBold,\n                        color = if (viewModel.depthOfDischargePercent <= 80.0) BatteryFull else BatteryHalf,\n                        style = MaterialTheme.typography.titleMedium\n                    )\n                }\n\n                Text(\n                    text = \"LFP \340\246\254\340\247\215\340\246\257\340\246\276\340\246\237\340\246\276\340\246\260\340\246\277 \340\246\252\340\247\215\340\246\257\340\246\276\340\246\225 \340\247\256\340\247\246% \340\246\241\340\246\277\340\246\270\340\246\232\340\246\276\340\246\260\340\247\215\340\246\234\340\247\207 \340\246\260\340\246\276\340\246\226\340\246\262\340\247\207 \340\246\270\340\246\254\340\246\232\340\247\207\340\247\237\340\247\207 \340\246\246\340\247\200\340\246\260\340\247\215\340\246\230\340\246\270\340\247\215\340\246\245\340\246\276\340\246\257\340\246\274\340\247\200 \340\246\271\340\247\237 \340\246\217\340\246\254\340\246\202 \340\246\270\340\246\276\340\246\207\340\246\225\340\247\207\340\246\262 \340\246\262\340\246\276\340\246\207\340\246\253 \340\246\254\340\246\271\340\247\201\340\246\243 \340\246\254\340\247\207\340\247\234\340\247\207 \340\246\257\340\246\276\340\247\237\340\245\244\",\n                    style = MaterialTheme.typography.bodySmall,\n                    color = MaterialTheme.colorScheme.onSurfaceVariant,\n                    modifier = Modifier.padding(top = 4.dp, bottom = 12.dp)\n                )\n\n                Slider(\n                    value = viewModel.depthOfDischargePercent.toFloat(),\n                    onValueChange = { viewModel.depthOfDischargePercent = it.roundToInt().toDouble() },\n                    valueRange = 10f..100f,\n                    modifier = Modifier.fillMaxWidth()\n                )\n\n                Row(\n                    modifier = Modifier.fillMaxWidth(),\n                    horizontalArrangement = Arrangement.spacedBy(8.dp)\n                ) {\n                    val dops = listOf(\n                        80.0 to \"80% (\340\246\254\340\247\207\340\246\270\340\247\215\340\246\237 \340\246\262\340\246\276\340\246\207\340\246\253)\",\n                        90.0 to \"90% (\340\246\255\340\246\276\340\246\260\340\246\270\340\246\276\340\246\256\340\247\215\340\246\257)\",\n                        100.0 to \"100% (\340\246\270\340\246\260\340\247\215\340\246\254\340\247\213\340\246\232\340\247\215\340\246\232 \340\246\260\340\247\207\340\246\236\340\247\215\340\246\234)\"\n                    )\n                    dops.forEach { (dod, label) ->\n                        val selected = viewModel.depthOfDischargePercent == dod\n                        SuggestionChip(\n                            onClick = { viewModel.depthOfDischargePercent = dod },\n                            label = { Text(label, fontSize = 11.sp) },\n                            colors = SuggestionChipDefaults.suggestionChipColors(\n                                containerColor = if (selected) MaterialTheme.colorScheme.primaryContainer else Color.Transparent,\n                                labelColor = if (selected) MaterialTheme.colorScheme.onPrimaryContainer else MaterialTheme.colorScheme.onSurface\n                            ),\n                            modifier = Modifier.weight(1f)\n                        )\n                    }\n                }\n            }\n        }\n\n        // Save Battery Pack Button\n        Button(\n            onClick = onSaveClicked,\n            modifier = Modifier\n                .fillMaxWidth()\n                .height(48.dp)\n                .testTag(\"save_config_button\"),\n            colors = ButtonDefaults.buttonColors(containerColor = MaterialTheme.colorScheme.primary)\n        ) {\n            Icon(Icons.Default.Save, contentDescription = null)\n            Spacer(modifier = Modifier.width(8.dp))\n            Text(\"\340\246\241\340\246\277\340\246\234\340\246\276\340\246\207\340\246\250\340\246\237\340\246\277 \340\246\270\340\247\207\340\246\255 \340\246\225\340\246\260\340\247\207 \340\246\260\340\246\276\340\246\226\340\247\201\340\246\250\", fontWeight = FontWeight.Bold)\n        }\n    }\n}"
      replacement_content: "// TAB 2: Configurable LFP battery cells & pack details calculator\n@Composable\nfun CalculatorConfigTab(\n    viewModel: BatteryViewModel,\n    onSaveClicked: () -> Unit\n) {\n    val scrollState = rememberScrollState()\n    val t = { key: String -> BatteryLocalizer.get(key, viewModel.appLanguage) }\n\n    val baseLifeLabel = when (viewModel.appLanguage) {\n        \"bn\" -> \"\340\246\254\340\247\207\340\246\270 \340\246\262\340\246\276\340\246\207\340\246\253\"\n        \"zh\" -> \"\345\237\272\347\241\200\345\257\277\345\221\275\"\n        \"de\" -> \"Basislebensdauer\"\n        \"ko\" -> \"\352\270\260\354\244\200 \354\210\230\353\252\205\"\n        else -> \"Base Life\"\n    }\n    val formLabel = when (viewModel.appLanguage) {\n        \"bn\" -> \"\340\246\253\340\246\260\340\247\215\340\246\256\"\n        \"zh\" -> \"\345\275\242\346\200\201\"\n        \"de\" -> \"Form\"\n        \"ko\" -> \"\355\230\225\355\203\234\"\n        else -> \"Form\"\n    }\n\n    Column(\n        modifier = Modifier\n            .fillMaxSize()\n            .verticalScroll(scrollState)\n            .padding(12.dp),\n        verticalArrangement = Arrangement.spacedBy(14.dp)\n    ) {\n        // Cell choice section (From 15Ah to 314Ah)\n        Card(\n            modifier = Modifier.fillMaxWidth(),\n            colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.surface)\n        ) {\n            Column(modifier = Modifier.padding(16.dp)) {\n                Text(\n                    text = t(\"select_lfp_cell\"),\n                    fontWeight = FontWeight.Bold,\n                    style = MaterialTheme.typography.titleMedium,\n                    color = MaterialTheme.colorScheme.primary\n                )\n                Text(\n                    text = t(\"select_lfp_cell_desc\"),\n                    style = MaterialTheme.typography.bodySmall,\n                    color = MaterialTheme.colorScheme.onSurfaceVariant,\n                    modifier = Modifier.padding(bottom = 12.dp)\n                )\n\n                // Grid selection of Cell choices\n                Column(verticalArrangement = Arrangement.spacedBy(8.dp)) {\n                    viewModel.cellChoices.forEach { choice ->\n                        val selected = viewModel.selectedCellChoice.id == choice.id\n                        val cardBg = if (selected) MaterialTheme.colorScheme.primaryContainer.copy(alpha = 0.25f) else MaterialTheme.colorScheme.surfaceVariant.copy(alpha = 0.2f)\n                        val border = if (selected) borderStroke(1.5.dp, MaterialTheme.colorScheme.primary) else borderStroke(0.5.dp, Color.LightGray.copy(alpha = 0.5f))\n\n                        Row(\n                            modifier = Modifier\n                                .fillMaxWidth()\n                                .clip(RoundedCornerShape(8.dp))\n                                .background(cardBg)\n                                .border(border, RoundedCornerShape(8.dp))\n                                .clickable { viewModel.applyCellChoice(choice.id) }\n                                .padding(12.dp),\n                            horizontalArrangement = Arrangement.SpaceBetween,\n                            verticalAlignment = Alignment.CenterVertically\n                        ) {\n                            Row(verticalAlignment = Alignment.CenterVertically) {\n                                RadioButton(\n                                    selected = selected,\n                                    onClick = { viewModel.applyCellChoice(choice.id) }\n                                )\n                                Spacer(modifier = Modifier.width(4.dp))\n                                Column {\n                                    Text(\n                                        text = choice.modelName,\n                                        fontWeight = FontWeight.Bold,\n                                        style = MaterialTheme.typography.bodyMedium\n                                    )\n                                    Text(\n                                        text = \"$baseLifeLabel: ${choice.baseCycles} ${t(\"cycles\")} \342\200\242 $formLabel: ${if (choice.form == LfpCellForm.CYLINDRICAL) t(\"cylindrical\") else t(\"prismatic\")}\",\n                                        style = MaterialTheme.typography.labelSmall,\n                                        color = MaterialTheme.colorScheme.onSurfaceVariant\n                                    )\n                                }\n                            }\n\n                            Text(\n                                text = \"${choice.capacityAh.toInt()} Ah\",\n                                fontWeight = FontWeight.Bold,\n                                color = MaterialTheme.colorScheme.primary,\n                                style = MaterialTheme.typography.bodyMedium\n                            )\n                        }\n                    }\n                }\n            }\n        }\n\n        // Series count & Voltage configuration\n        Card(\n            modifier = Modifier.fillMaxWidth(),\n            colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.surface)\n        ) {\n            Column(modifier = Modifier.padding(16.dp)) {\n                Row(\n                    modifier = Modifier.fillMaxWidth(),\n                    horizontalArrangement = Arrangement.SpaceBetween,\n                    verticalAlignment = Alignment.CenterVertically\n                ) {\n                    Text(\n                        text = t(\"series_parallel\"),\n                        fontWeight = FontWeight.Bold,\n                        style = MaterialTheme.typography.titleMedium\n                    )\n                    Text(\n                        text = \"${viewModel.seriesCells}S (${viewModel.packNominalVoltage.format(1)} V)\",\n                        fontWeight = FontWeight.ExtraBold,\n                        color = MaterialTheme.colorScheme.primary,\n                        style = MaterialTheme.typography.titleMedium\n                    )\n                }\n\n                Spacer(modifier = Modifier.height(8.dp))\n\n                Slider(\n                    value = viewModel.seriesCells.toFloat(),\n                    onValueChange = { viewModel.seriesCells = it.roundToInt() },\n                    valueRange = 1f..32f,\n                    steps = 30,\n                    modifier = Modifier.fillMaxWidth()\n                )\n\n                Spacer(modifier = Modifier.height(4.dp))\n\n                // Standard S quick buttons\n                Row(\n                    modifier = Modifier.fillMaxWidth(),\n                    horizontalArrangement = Arrangement.spacedBy(8.dp)\n                ) {\n                    val quickVoltages = listOf(\n                        4 to \"12V (4S)\",\n                        8 to \"24V (8S)\",\n                        16 to \"48V (16S)\"\n                    )\n                    quickVoltages.forEach { (sCount, label) ->\n                        val selected = viewModel.seriesCells == sCount\n                        SuggestionChip(\n                            onClick = { viewModel.applySVoltPreset(sCount) },\n                            label = { Text(label) },\n                            colors = SuggestionChipDefaults.suggestionChipColors(\n                                containerColor = if (selected) MaterialTheme.colorScheme.primaryContainer else Color.Transparent,\n                                labelColor = if (selected) MaterialTheme.colorScheme.onPrimaryContainer else MaterialTheme.colorScheme.onSurface\n                            ),\n                            modifier = Modifier.weight(1f)\n                        )\n                    }\n                }\n            }\n        }\n\n        // Parallel count settings\n        Card(\n            modifier = Modifier.fillMaxWidth(),\n            colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.surface)\n        ) {\n            Column(modifier = Modifier.padding(16.dp)) {\n                Row(\n                    modifier = Modifier.fillMaxWidth(),\n                    horizontalArrangement = Arrangement.SpaceBetween,\n                    verticalAlignment = Alignment.CenterVertically\n                ) {\n                    Text(\n                        text = t(\"parallel_count\"),\n                        fontWeight = FontWeight.Bold,\n                        style = MaterialTheme.typography.titleMedium\n                    )\n                    Text(\n                        text = \"${viewModel.parallelCells}P (${viewModel.packCapacityAh.toInt()} Ah)\",\n                        fontWeight = FontWeight.ExtraBold,\n                        color = MaterialTheme.colorScheme.primary,\n                        style = MaterialTheme.typography.titleMedium\n                    )\n                }\n\n                Spacer(modifier = Modifier.height(8.dp))\n\n                Slider(\n                    value = viewModel.parallelCells.toFloat(),\n                    onValueChange = { viewModel.parallelCells = it.roundToInt() },\n                    valueRange = 1f..16f,\n                    steps = 14,\n                    modifier = Modifier.fillMaxWidth()\n                )\n            }\n        }\n\n        // Discharge depth settings\n        Card(\n            modifier = Modifier.fillMaxWidth(),\n            colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.surface)\n        ) {\n            Column(modifier = Modifier.padding(16.dp)) {\n                Row(\n                    modifier = Modifier.fillMaxWidth(),\n                    horizontalArrangement = Arrangement.SpaceBetween,\n                    verticalAlignment = Alignment.CenterVertically\n                ) {\n                    Text(\n                        text = t(\"depth_of_discharge\"),\n                        fontWeight = FontWeight.Bold,\n                        style = MaterialTheme.typography.titleMedium\n                    )\n                    Text(\n                        text = \"${viewModel.depthOfDischargePercent.roundToInt()}%\",\n                        fontWeight = FontWeight.ExtraBold,\n                        color = if (viewModel.depthOfDischargePercent <= 80.0) BatteryFull else BatteryHalf,\n                        style = MaterialTheme.typography.titleMedium\n                    )\n                }\n\n                Text(\n                    text = t(\"dod_desc\"),\n                    style = MaterialTheme.typography.bodySmall,\n                    color = MaterialTheme.colorScheme.onSurfaceVariant,\n                    modifier = Modifier.padding(top = 4.dp, bottom = 12.dp)\n                )\n\n                Slider(\n                    value = viewModel.depthOfDischargePercent.toFloat(),\n                    onValueChange = { viewModel.depthOfDischargePercent = it.roundToInt().toDouble() },\n                    valueRange = 10f..100f,\n                    modifier = Modifier.fillMaxWidth()\n                )\n\n                Row(\n                    modifier = Modifier.fillMaxWidth(),\n                    horizontalArrangement = Arrangement.spacedBy(8.dp)\n                ) {\n                    val dops = listOf(80.0, 90.0, 100.0)\n                    dops.forEach { dod ->\n                        val selected = viewModel.depthOfDischargePercent == dod\n                        val label = when (dod) {\n                            80.0 -> when (viewModel.appLanguage) {\n                                \"bn\" -> \"80% (\340\246\254\340\247\207\340\246\270\340\247\215\340\246\237 \340\246\262\340\246\276\340\246\207\340\246\253)\"\n                                \"zh\" -> \"80% (\346\234\200\344\275\263\345\257\277\345\221\275)\"\n                                \"de\" -> \"80% (Beste Lebensdauer)\"\n                                \"ko\" -> \"80% (\354\265\234\352\263\240 \354\210\230\353\252\205)\"\n                                else -> \"80% (Best Life)\"\n                            }\n                            90.0 -> when (viewModel.appLanguage) {\n                                \"bn\" -> \"90% (\340\246\255\340\246\276\340\246\260\340\246\270\340\246\276\340\246\256\340\247\215\340\246\257)\"\n                                \"zh\" -> \"90% (\345\271\263\350\241\241)\"\n                                \"de\" -> \"90% (Ausgewogen)\"\n                                \"ko\" -> \"90% (\352\267\240\355\230\225)\"\n                                else -> \"90% (Balanced)\"\n                            }\n                            else -> when (viewModel.appLanguage) {\n                                \"bn\" -> \"100% (\340\246\270\340\246\260\340\247\215\340\246\254\340\247\213\340\246\232\340\247\215\340\246\232 \340\246\260\340\247\207\340\246\236\340\247\215\340\246\234)\"\n                                \"zh\" -> \"100% (\346\234\200\345\244\247\350\214\203\345\233\264)\"\n                                \"de\" -> \"100% (Max. Reichweite)\"\n                                \"ko\" -> \"100% (\354\265\234\353\214\200 \353\262\224\354\234\204)\"\n                                else -> \"100% (Max Range)\"\n                            }\n                        }\n                        SuggestionChip(\n                            onClick = { viewModel.depthOfDischargePercent = dod },\n                            label = { Text(label, fontSize = 11.sp) },\n                            colors = SuggestionChipDefaults.suggestionChipColors(\n                                containerColor = if (selected) MaterialTheme.colorScheme.primaryContainer else Color.Transparent,\n                                labelColor = if (selected) MaterialTheme.colorScheme.onPrimaryContainer else MaterialTheme.colorScheme.onSurface\n                            ),\n                            modifier = Modifier.weight(1f)\n                        )\n                    }\n                }\n            }\n        }\n\n        // Save Battery Pack Button\n        Button(\n            onClick = onSaveClicked,\n            modifier = Modifier\n                .fillMaxWidth()\n                .height(48.dp)\n                .testTag(\"save_config_button\"),\n            colors = ButtonDefaults.buttonColors(containerColor = MaterialTheme.colorScheme.primary)\n        ) {\n            Icon(Icons.Default.Save, contentDescription = null)\n            Spacer(modifier = Modifier.width(8.dp))\n            Text(t(\"save_design_btn\"), fontWeight = FontWeight.Bold)\n        }\n    }\n}"
    }
