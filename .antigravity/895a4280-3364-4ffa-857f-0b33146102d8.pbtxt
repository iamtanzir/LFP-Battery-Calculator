        lines {
          text: "                            imageVector = if (batterySufficiency == \"OPTIMAL\" || batterySufficiency == \"SUFFICIENT\") Icons.Default.CheckCircle else Icons.Default.Warning,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
