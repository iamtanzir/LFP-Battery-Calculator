        lines {
          text: "        \"zh\" -> \"\347\246\273\347\275\221\345\244\252\351\230\263\350\203\275\347\263\273\347\273\237\344\270\215\350\277\236\346\216\245\347\224\265\347\275\221\357\274\214\345\256\214\345\205\250\347\213\254\347\253\213\350\277\220\350\241\214\343\200\202\347\231\275\345\244\251\347\224\261\345\244\252\351\230\263\350\203\275\344\276\233\347\224\265\357\274\214\345\244\234\351\227\264\347\224\261\347\224\265\346\261\240\347\273\204\344\276\233\347\224\265\343\200\202\""
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        \"de\" -> \"Off-Grid-Solarsysteme sind nicht an das Stromnetz angeschlossen. Sie sind autark. Tags\303\274ber Solarstrom, nachts Akkubetrieb.\""
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        \"ko\" -> \"\354\230\244\355\224\204\352\267\270\353\246\254\353\223\234 \355\203\234\354\226\221\352\264\221 \354\213\234\354\212\244\355\205\234\354\235\200 \354\240\204\353\240\245\353\247\235\352\263\274 \354\227\260\352\262\260\353\220\230\354\247\200 \354\225\212\354\235\200 \354\236\220\353\246\275\355\230\225 \354\213\234\354\212\244\355\205\234\354\236\205\353\213\210\353\213\244. \353\202\256\354\227\220\353\212\224 \355\203\234\354\226\221\352\264\221\354\234\274\353\241\234, \353\260\244\354\227\220\353\212\224 \353\260\260\355\204\260\353\246\254\353\241\234 \354\240\204\353\240\245\354\235\204 \352\263\265\352\270\211\355\225\251\353\213\210\353\213\244.\""
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        else -> \"Off-grid solar systems are fully independent from the utility grid. Daytime loads run on solar, and nighttime is sustained by battery packs.\""
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
