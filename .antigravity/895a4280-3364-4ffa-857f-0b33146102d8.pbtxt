        }
        lines {
          text: "// TAB 1: Household Appliance selection and Load calculator"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "@Composable"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "fun ApplianceSelectionTab("
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    viewModel: BatteryViewModel,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
