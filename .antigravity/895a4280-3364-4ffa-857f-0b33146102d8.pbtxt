del.usableWattHours / 1000.0\n \n            BatteryVisualHeader(\n                seriesCells = viewModel.seriesCells,\n                parallelCells = viewModel.parallelCells,\n                totalCapacityAh = viewModel.packCapacityAh,\n                nominalVoltage = viewModel.packNominalVoltage,\n                totalKwh = totalKwh,\n                usableKwh = usableKwh,\n                dodPercent = viewModel.depthOfDischargePercent,\n                cycleLife = viewModel.cycleLifeEstimate,\n                cellName = viewModel.selectedCellChoice.modelName,\n                cellForm = viewModel.selectedCellChoice.form\n            )\n \n            // Multi-tab Navigation Bar\n            ScrollableTabRow(\n                selectedTabIndex = activeTab,\n                containerColor = MaterialTheme.colorScheme.background,\n                contentColor = MaterialTheme.colorScheme.primary,\n                edgePadding = 12.dp,\n                modifier = Modifier.fillMaxWidth()\n            ) {\n                Tab(\n                    selected = activeTab == 0,\n                    onClick = { activeTab = 0 },\n                    text = { Text(\"\340\247\247. \340\246\262\340\247\213\340\246\241 \340\246\270\340\246\277\340\246\262\340\247\207\340\246\225\340\246\266\340\246\250\", fontWeight = FontWeight.Bold) },\n                    icon = { Icon(Icons.Default.Bolt, contentDescription = null) }\n                )\n                Tab(\n                    selected = activeTab == 1,\n                    onClick = { activeTab = 1 },\n                    text = { Text(\"\340\247\250. \340\246\252\340\247\215\340\246\257\340\246\276\340\246\225 \340\246\225\340\247\215\340\246\257\340\246\276\340\246\262\340\246\225\340\247\201\340\246\262\340\247\207\340\246\237\340\246\260\", fontWeight = FontWeight.Bold) },\n                    icon = { Icon(Icons.Default.Settings, contentDescription = null) }\n                )\n                Tab(\n                    