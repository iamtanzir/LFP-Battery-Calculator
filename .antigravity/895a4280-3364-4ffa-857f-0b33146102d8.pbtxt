  file_change {
    absolute_path_uri: "file:///app/src/main/java/com/example/ui/BatteryViewModel.kt"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "package com.example.ui\n\nimport android.app.Application\nimport androidx.compose.runtime.getValue\nimport androidx.compose.runtime.mutableStateOf\nimport androidx.compose.runtime.setValue\nimport androidx.lifecycle.AndroidViewModel\nimport androidx.lifecycle.ViewModel\nimport androidx.lifecycle.ViewModelProvider\nimport androidx.lifecycle.viewModelScope\nimport com.example.data.AppDatabase\nimport com.example.data.BatteryConfig\nimport com.example.data.BatteryRepository\nimport kotlinx.coroutines.flow.SharingStarted\nimport kotlinx.coroutines.flow.StateFlow\nimport kotlinx.coroutines.flow.stateIn\nimport kotlinx.coroutines.launch\n\nclass BatteryViewModel(application: Application) : AndroidViewModel(application) {\n    private val repository: BatteryRepository\n\n    init {\n        val database = AppDatabase.getDatabase(application)\n        repository = BatteryRepository(database.batteryDao())\n    }\n\n    // Input States\n    var seriesCells by mutableStateOf(4)\n    var parallelCells by mutableStateOf(1)\n    var cellVoltage by mutableStateOf(3.2)\n    var cellCapacityAh by mutableStateOf(100.0)\n    var depthOfDischargePercent by mutableStateOf(80.0)\n\n    // Saved Configs Flow\n    val savedConfigs: StateFlow<List<BatteryConfig>> = repository.allConfigs\n        .stateIn(\n            scope = viewModelScope,\n            started = SharingStarted.WhileSubscribed(5000),\n            initialValue = emptyList()\n        )\n\n    // Calculations (Derived State)\n    val packNominalVoltage: Double\n        get() = seriesCells * cellVoltage\n\n    val packCapacityAh: Double\n        get() = parallelCells * cellCapacityAh\n\n    val totalWattHours: Double\n        get() = packNominalVoltage * packCapacityAh\n\n    val usableWattHours: Double\n        get() = totalWattHours * (depthOfDischargePercent / 100.0)\n\n    val usableCapacityAh: Double\n        get() = packCapacityAh * (depthOfDischargePercent / 100.0)\n\n    val cycleLifeEstimate: Int\n        get() = estimateCycleLife(depthOfDischargePercent)\n\n    // Estimate cycle life curve of premium LFP chemistry\n    private fun estimateCycleLife(dod: Double): Int {\n        return when {\n            dod >= 100.0 -> 2500\n            dod >= 90.0 -> {\n                val fraction = (100.0 - dod) / 10.0\n                (2500 + fraction * 1000).toInt()\n            }\n            dod >= 80.0 -> {\n                val fraction = (90.0 - dod) / 10.0\n                (3500 + fraction * 1500).toInt()\n            }\n            dod >= 50.0 -> {\n                val fraction = (80.0 - dod) / 30.0\n                (5000 + fraction * 3000).toInt()\n            }\n            dod >= 20.0 -> {\n                val fraction = (50.0 - dod) / 30.0\n                (8000 + fraction * 4000).toInt()\n            }\n            else -> {\n                val fraction = (20.0 - Math.max(0.0, dod)) / 20.0\n                (12000 + fraction * 3000).toInt()\n            }\n        }\n    }\n\n    // Load custom presets\n    fun applySVoltPreset(sCount: Int) {\n        seriesCells = sCount\n    }\n\n    fun applyAhPreset(ahValue: Double) {\n        cellCapacityAh = ahValue\n    }\n\n    // Save current design\n    fun saveCurrentConfig(name: String) {\n        if (name.isBlank()) return\n        viewModelScope.launch {\n            repository.insert(\n                BatteryConfig(\n                    name = name.trim(),\n                    seriesCells = seriesCells,\n                    parallelCells = parallelCells,\n                    cellVoltage = cellVoltage,\n                    cellCapacityAh = cellCapacityAh,\n                    depthOfDischargePercent = depthOfDischargePercent\n                )\n            )\n        }\n    }\n\n    // Delete a saved design\n    fun deleteConfig(id: Int) {\n        viewModelScope.launch {\n            repository.deleteById(id)\n        }\n    }\n\n    // Load a saved design\n    fun loadConfig(config: BatteryConfig) {\n        seriesCells = config.seriesCells\n        parallelCells = config.parallelCells\n        cellVoltage = config.cellVoltage\n        cellCapacityAh = config.cellCapacityAh\n        depthOfDischargePercent = config.depthOfDischargePercent\n    }\n}\n\nclass BatteryViewModelFactory(private val application: Application) : ViewModelProvider.Factory {\n    override fun <T : ViewModel> create(modelClass: Class<T>): T {\n        if (modelClass.isAssignableFrom(BatteryViewModel::class.java)) {\n            @Suppress(\"UNCHECKED_CAST\")\n            return BatteryViewModel(application) as T\n        }\n        throw IllegalArgumentException(\"Unknown ViewModel class\")\n    }\n}\n"
    }
