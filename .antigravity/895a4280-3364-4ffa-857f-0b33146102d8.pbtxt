          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                                    val soc = 100f - (relativeX / graphWidth * 100f)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                                    touchSoC = soc.coerceIn(0f, 100f)"
