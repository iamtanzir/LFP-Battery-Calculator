        lines {
          text: "                            color = Color.LightGray.copy(alpha = 0.4f),"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                            topLeft = Offset(mainBodyWidth, (mainBodyHeight - capHeight) / 2),"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                            size = Size(capWidth, capHeight),"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
