        }
        lines {
          text: "                        Text(\"\340\246\256\340\247\213\340\246\237 \340\246\232\340\246\262\340\246\256\340\246\276\340\246\250 \340\246\262\340\247\213\340\246\241:\", style = MaterialTheme.typography.bodyMedium)"
