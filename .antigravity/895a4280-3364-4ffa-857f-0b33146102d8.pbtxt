          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "// Appliance Load Run-Time Estimator Tab"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "@Composable"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "fun ApplianceLoadsTab(usableWh: Double) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    val scrollState = rememberScrollState()"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    val standardLoads = listOf("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        ApplianceLoad(\"LED Bulbs\", 15, \"ic_lightbulb\", Icons.Default.Lightbulb, \"Essential illumination\"),"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        ApplianceLoad(\"Wi-Fi Router\", 20, \"ic_router\", Icons.Default.NetworkWifi, \"Stay connected\"),"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        ApplianceLoad(\"Smart TV\", 80, \"ic_tv\", Icons.Default.Tv, \"Entertainment system\"),"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        ApplianceLoad(\"Mini Fridge\", 60, \"ic_minifridge\", Icons.Default.Kitchen, \"Compact cooler\"),"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        ApplianceLoad(\"Full Refrigerator\", 150, \"ic_fridge\", Icons.Default.Kitchen, \"Family-size appliance\"),"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        ApplianceLoad(\"Microwave\", 1000, \"ic_microwave\", Icons.Default.SoupKitchen, \"Quick food heating\"),"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        ApplianceLoad(\"Power Tools\", 400, \"ic_drill\", Icons.Default.Construction, \"Workshop gear\"),"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        ApplianceLoad(\"Air Conditioner\", 1200, \"ic_ac\", Icons.Default.AcUnit, \"Climate cooling\")"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    )"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    Column("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        modifier = Modifier"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            .fillMaxSize()"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            .verticalScroll(scrollState)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            .padding(16.dp)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    ) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        Text("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            text = \"Appliance Load Simulator\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            style = MaterialTheme.typography.titleMedium,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            fontWeight = FontWeight.Bold,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            color = MaterialTheme.colorScheme.primary"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        )"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        Text("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            text = \"Estimates run time based on your configured usable energy capacity of ${(usableWh / 1000.0).format(2)} kWh:\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            style = MaterialTheme.typography.bodySmall,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            color = MaterialTheme.colorScheme.onSurfaceVariant,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            modifier = Modifier.padding(bottom = 16.dp)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        )"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        standardLoads.forEach { appliance ->"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            val hours = usableWh / appliance.wattage"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
