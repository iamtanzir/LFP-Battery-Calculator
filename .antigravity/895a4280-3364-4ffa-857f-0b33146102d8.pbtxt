        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    // Status analysis compared with configured battery size"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    val batterySufficiency = viewModel.capacitySufficiencyStatus"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    val statusText = when (batterySufficiency) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                        \"OPTIMAL\" -> \"\340\246\205\340\246\244\340\246\277\340\246\260\340\246\277\340\246\225\340\247\215\340\246\244 \340\246\254\340\247\215\340\246\257\340\246\276\340\246\225\340\246\206\340\246\252 \340\246\247\340\246\276\340\246\260\340\246\243\340\246\225\340\247\215\340\246\267\340\246\256\340\246\244\340\246\276 \340\246\206\340\246\233\340\247\207! (Optimal & Safe)\""
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                        \"SUFFICIENT\" -> \"\340\246\252\340\247\215\340\246\257\340\246\276\340\246\225 \340\246\247\340\246\276\340\246\260\340\246\243\340\246\225\340\247\215\340\246\267\340\246\256\340\246\244\340\246\276 \340\246\252\340\246\260\340\247\215\340\246\257\340\246\276\340\246\252\340\247\215\340\246\244! (Sufficient)\""
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                        \"LOW\" -> \"\340\246\254\340\247\215\340\246\257\340\246\276\340\246\237\340\246\276\340\246\260\340\246\277 \340\246\247\340\246\276\340\246\260\340\246\243\340\246\225\340\247\215\340\246\267\340\246\256\340\246\244\340\246\276 \340\246\225\340\246\256 (\340\246\254\340\247\215\340\246\257\340\246\276\340\246\225\340\246\206\340\246\252 \340\246\270\340\246\256\340\247\237 \340\246\225\340\246\256\340\247\207 \340\246\257\340\246\276\340\246\254\340\247\207)\""
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                        else -> \"\340\246\205\340\246\252\340\247\215\340\246\260\340\246\244\340\247\201\340\246\262 \340\246\254\340\247\215\340\246\257\340\246\276\340\246\237\340\246\276\340\246\260\340\246\277 \340\246\252\340\247\215\340\246\257\340\246\276\340\246\225! \340\246\252\340\246\260\340\247\215\340\246\257\340\246\276\340\246\252\340\247\215\340\246\244 \340\246\254\340\247\215\340\246\257\340\246\276\340\246\225\340\246\206\340\246\252 \340\246\252\340\246\276\340\246\254\340\247\207\340\246\250 \340\246\250\340\246\276\340\245\244\""
