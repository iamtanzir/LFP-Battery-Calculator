\235\204 \354\204\240\355\203\235\355\225\230\354\213\255\354\213\234\354\230\244. \352\260\201\355\230\225 \354\205\200\354\235\200 \352\263\240\354\232\251\353\237\211\354\235\264\353\251\260, \354\233\220\355\206\265\355\230\225 \354\205\200\354\235\200 \353\247\244\354\232\260 \352\262\254\352\263\240\355\225\230\352\263\240 \353\206\222\354\235\200 \353\260\251\354\240\204\354\234\250\354\235\204 \354\247\200\354\233\220\355\225\251\353\213\210\353\213\244.\",\n            \"series_parallel\" to \"2. \354\247\201\353\240\254 \353\260\217 \353\263\221\353\240\254 (S/P) \354\227\260\352\262\260\",\n            \"series_count\" to \"\354\247\201\353\240\254 \354\205\200 \354\210\230 (S):\",\n            \"parallel_count\" to \"\353\263\221\353\240\254 \354\205\200 \354\210\230 (P):\",\n            \"config_voltage_desc\" to \"4S (12.8V) \353\260\217 8S (25.6V)\352\260\200 \355\221\234\354\244\200 \354\213\234\354\212\244\355\205\234 \354\240\204\354\225\225\354\236\205\353\213\210\353\213\244.\",\n            \"depth_of_discharge\" to \"3. \353\260\251\354\240\204 \352\271\212\354\235\264 (DoD) \354\240\234\355\225\234\",\n            \"dod_desc\" to \"\353\260\251\354\240\204 \352\271\212\354\235\264\353\245\274 \354\244\204\354\235\264\353\251\264(\354\230\210: 80%\353\241\234 \354\240\234\355\225\234), \353\247\244\354\235\274 \354\266\251\353\260\251\354\240\204\355\225\230\353\212\224 \354\203\201\355\231\251\354\227\220\354\204\234\353\217\204 LFP \354\205\200\354\235\204 10~15\353\205\204 \353\217\231\354\225\210 \354\234\240\354\247\200\355\225\240 \354\210\230 \354\236\210\354\212\265\353\213\210\353\213\244.\",\n            \"save_design_btn\" to \"\353\224\224\354\236\220\354\235\270 \354\240\200\354\236\245\355\225\230\352\270\260\",\n            \"pack_analysis\" to \"\353\260\260\355\204\260\353\246\254 \355\214\251 \353\266\204\354\204\235\",\n            \"pack_total_wh\" to \"\355\214\251 \354\264\235 \354\227\220\353\204\210\354\247\200 (Wh):\",\n            \"pack_usable_wh\" to \"\355\214\251 \354\202\254\354\232\251 \352\260\200\353\212\245 \354\227\220\353\204\210\354\247\200 (Wh):\",\n            \"peak_surge_10s\" to \"\355\224\274\355\201\254 \354\204\234\354\247\200 \353\266\200\355\225\230 (10\354\264\210):\",\n            \"required_energy_wh\" to \"\355\225\204\354\232\224\355\225\234 \354\227\220\353\204\210\354\247\200 (Wh):\",\n            \"estimated_backup\" to \"\354\230\210\354\203\201 \353\260\261\354\227\205 \354\213\234\352\260\204:\",\n            \"estimated_lifespan\" to \"\354\230\210\354\203\201 \354\202\254\354\232\251 \354\210\230\353\252\205:\",\n            \n            \"solar_grid_title\" to \"\352\267\270\353\246\254\353\223\234 \354\234\240\355\230\225 \353\260\217 \355\203\234\354\226\221\352\264\221 \353\224\224\354\236\220\354\235\270\",\n            \"select_grid_type\" to \"1. \355\203\234\354\226\221\352\264\221 \354\213\234\354\212\244\355\205\234 \354\234\240\355\230\225 \354\204\240\355\203\235\",\n            \"offgrid\" to \"\354\230\244\355\224\204\352\267\270\353\246\254\353\223\234 (\353\260\260\355\204\260\353\246\254 \354\240\204\354\232\251 \353\217\205\353\246\275\355\230\225)\",\n            \"ongrid\" to \"\354\230\250\352\267\270\353\246\254\353\223\234 (\352\263\204\355\206\265 \354\227\260\352\263\204\355\230\225)\",\n            \"hybrid\" to \"\355\225\230\354\235\264\353\270\214\353\246\254\353\223\234 (\352\263\204\355\206\265 \354\227\260\352\263\204 + \353\260\260\355\204\260\353\246\254 \353\260\261\354\227\205)\",\n            \"mats_title\" to \"2. \355\225\265\354\213\254 \354\236\245\353\271\204 \352\266\214\354\236\245 \354\202\254\355\225\255\",\n            \"mats_panels\" to \"\355\203\234\354\226\221\352\264\221 \353\260\234\354\240\204 \355\214\250\353\204\220 \354\232\251\353\237\211:\",\n            \"mats_controller\" to \"\354\266\251\354\240\204 \354\273\250\355\212\270\353\241\244\353\237\254 (MPPT):\",\n            \"mats_inverter\" to \"\354\235\270\353\262\204\355\204\260 \354\232\251\353\237\211 (\354\265\234\354\206\214):\",\n            \"accessory_title\" to \"3. \354\225\210\354\240\204 \354\227\260\352\262\260 \353\260\217 \354\225\241\354\204\270\354\204\234\353\246\254\",\n            \"acc_cable\" to \"\354\247\201\353\245\230 \354\274\200\354\235\264\353\270\224 \352\265\265\352\270\260:\",\n            \"acc_fuse\" to \"\353\260\260\355\204\260\353\246\254 \355\214\251 \353\251\224\354\235\270 \355\223\250\354\246\210 \354\240\225\352\262\251:\",\n            \"acc_bms\" to \"\352\266\214\354\236\245 BMS \355\227\210\354\232\251 \354\240\204\353\245\230:\",\n            \"sun_hours_disclaimer\" to \"* \355\203\234\354\226\221\352\264\221 \353\260\234\354\240\204 \352\263\204\354\202\260\354\235\200 \355\225\230\353\243\250 \355\217\211\352\267\240 4.5\354\235\274\354\241\260\354\213\234\352\260\204 (PSH) \352\270\260\354\244\200\354\236\205\353\213\210\353\213\244.\",\n            \n            \"saved_designs_title\" to \"\354\240\200\354\236\245\353\220\234 \353\224\224\354\236\220\354\235\270\",\n            \"no_saved\" to \"\354\240\200\354\236\245\353\220\234 \352\265\254\354\204\261 \354\204\244\354\240\225\354\235\204 \354\260\276\354\235\204 \354\210\230 \354\227\206\354\212\265\353\213\210\353\213\244.\",\n            \"no_saved_desc\" to \"\354\234\204\354\235\230 \'\355\214\251 \352\263\204\354\202\260\352\270\260\' \355\203\255\354\227\220\354\204\234 \353\202\230\353\247\214\354\235\230 \353\247\236\354\266\244 \353\224\224\354\236\220\354\235\270\354\235\204 \354\204\244\352\263\204\355\225\230\352\263\240 \354\240\200\354\236\245\355\225\264\353\263\264\354\204\270\354\232\224.\",\n            \"load_btn\" to \"\353\266\210\353\237\254\354\230\244\352\270\260\",\n            \"delete_btn\" to \"\354\202\255\354\240\234\",\n            \n            \"dialog_save_title\" to \"\353\260\260\355\204\260\353\246\254 \353\224\224\354\236\220\354\235\270 \354\240\200\354\236\245\",\n            \"dialog_save_desc\" to \"\354\235\264 \354\273\244\354\212\244\355\205\200 LFP \355\214\251 \354\204\244\354\240\225\354\235\204 \353\241\234\354\273\254 \352\270\260\352\270\260 \353\215\260\354\235\264\355\204\260\353\262\240\354\235\264\354\212\244\354\227\220 \354\240\200\354\236\245\355\225\251\353\213\210\353\213\244.\",\n            \"dialog_input_label\" to \"\353\224\224\354\236\220\354\235\270 \354\235\264\353\246\204\",\n            \"dialog_save\" to \"\354\240\200\354\236\245\",\n            \"dialog_cancel\" to \"\354\267\250\354\206\214\",\n            \n            \"years\" to \"\353\205\204\",\n            \"cycles\" to \"\354\202\254\354\235\264\355\201\264\",\n            \"at_dod\" to \"%s%% DoD \353\260\251\354\240\204 \354\213\234\",\n            \"select_language_title\" to \"\354\226\270\354\226\264 \354\204\240\355\203\235\"\n        )\n    )\n\n    fun get(key: String, lang: String): String {\n        val selectedLang = if (translations.containsKey(lang)) lang else \"en\"\n        val langMap = translations[selectedLang] ?: translations[\"en\"]!!\n        return langMap[key] ?: translations[\"en\"]!![key] ?: key\n    }\n}\n"
    }
