        }
        lines {
          text: "                // Grid selection of Cell choices"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                Column(verticalArrangement = Arrangement.spacedBy(8.dp)) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    viewModel.cellChoices.forEach { choice ->"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                        val selected = viewModel.selectedCellChoice.id == choice.id"
