        }
        lines {
          text: "                        if (configNameInput.isNotBlank()) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                            viewModel.saveCurrentConfig(configNameInput)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
