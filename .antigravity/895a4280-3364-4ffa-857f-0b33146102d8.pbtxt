        lines {
          text: "        \"ko\" -> \"\354\230\244\355\224\204\352\267\270\353\246\254\353\223\234 \355\203\234\354\226\221\352\264\221 \354\213\234\354\212\244\355\205\234\354\235\200 \354\240\204\353\240\245\353\247\235\352\263\274 \354\227\260\352\262\260\353\220\230\354\247\200 \354\225\212\354\235\200 \354\236\220\353\246\275\355\230\225 \354\213\234\354\212\244\355\205\234\354\236\205\353\213\210\353\213\244. \353\202\256\354\227\220\353\212\224 \355\203\234\354\226\221\352\264\221\354\234\274\353\241\234, \353\260\244\354\227\220\353\212\224 \353\260\260\355\204\260\353\246\254\353\241\234 \354\240\204\353\240\245\354\235\204 \352\263\265\352\270\211\355\225\251\353\213\210\353\213\244.\""
