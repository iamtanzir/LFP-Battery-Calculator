  file_change {
    absolute_path_uri: "file:///app/src/main/java/com/example/ui/BatteryCalculatorScreen.kt"
    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "// TAB 4: Saved Systems History Tab\n@Composable\nfun SavedSystemsTab(\n    savedConfigs: List<BatteryConfig>,\n    onLoadConfig: (BatteryConfig) -> Unit,\n    onDeleteConfig: (Int) -> Unit\n) {\n    if (savedConfigs.isEmpty()) {\n        Box(\n            modifier = Modifier\n                .fillMaxSize()\n                .padding(32.dp),\n            contentAlignment = Alignment.Center\n        ) {\n            Column(\n                horizontalAlignment = Alignment.CenterHorizontally,\n                verticalArrangement = Arrangement.Center\n            ) {\n                Icon(\n                    imageVector = Icons.Default.History,\n                    contentDescription = null,\n                    modifier = Modifier.size(64.dp),\n                    tint = MaterialTheme.colorScheme.onSurfaceVariant.copy(alpha = 0.4f)\n                )\n                Spacer(modifier = Modifier.height(12.dp))\n                Text(\n                    text = \"\340\246\225\340\247\213\340\246\250\340\247\213 \340\246\270\340\247\207\340\246\255 \340\246\225\340\246\260\340\246\276 \340\246\252\340\247\215\340\246\257\340\246\276\340\246\225 \340\246\250\340\247\207\340\246\207\",\n                    fontWeight = FontWeight.Bold,\n                    style = MaterialTheme.typography.titleMedium,\n                    color = MaterialTheme.colorScheme.onSurfaceVariant\n                )\n                Text(\n                    text = \"\340\246\217\340\246\225\340\246\237\340\246\277 \340\246\254\340\247\215\340\246\257\340\246\276\340\246\237\340\246\276\340\246\260\340\246\277 \340\246\252\340\247\215\340\246\257\340\246\276\340\246\225 \340\246\244\340\247\210\340\246\260\340\246\277 \340\246\254\340\246\276 \340\246\225\340\246\276\340\246\270\340\247\215\340\246\237\340\246\256\340\246\276\340\246\207\340\246\234 \340\246\225\340\246\260\340\247\207 \340\246\225\340\247\215\340\246\257\340\246\276\340\246\262\340\246\225\340\247\201\340\246\262\340\247\207\340\246\237\340\246\260 \340\246\245\340\247\207\340\246\225\340\247\207 \340\246\270\340\247\207\340\246\255 \340\246\225\340\246\260\340\247\207 \340\246\260\340\246\276\340\246\226\340\247\201\340\246\250\340\245\244\",\n                    style = MaterialTheme.typography.bodySmall,\n                    textAlign = TextAlign.Center,\n                    color = MaterialTheme.colorScheme.onSurfaceVariant.copy(alpha = 0.7f),\n                    modifier = Modifier.padding(top = 4.dp)\n                )\n            }\n        }\n    } else {\n        LazyColumn(\n            modifier = Modifier\n                .fillMaxSize()\n                .padding(horizontal = 16.dp),\n            verticalArrangement = Arrangement.spacedBy(10.dp)\n        ) {\n            item {\n                Text(\n                    text = \"\340\246\270\340\246\202\340\246\260\340\246\225\340\247\215\340\246\267\340\246\277\340\246\244 \340\246\241\340\246\277\340\246\234\340\246\276\340\246\207\340\246\250\340\246\270\340\246\256\340\247\202\340\246\271\",\n                    style = MaterialTheme.typography.titleMedium,\n                    fontWeight = FontWeight.Bold,\n                    color = MaterialTheme.colorScheme.primary,\n                    modifier = Modifier.padding(vertical = 8.dp)\n                )\n            }\n\n            items(savedConfigs, key = { it.id }) { config ->\n                val nominalV = config.seriesCells * 3.2\n                val totalKwh = (nominalV * config.cellCapacityAh) / 1000.0\n                val usableKwh = totalKwh * (config.depthOfDischargePercent / 100.0)\n\n                Card(\n                    modifier = Modifier\n                        .fillMaxWidth()\n                        .clickable { onLoadConfig(config) }\n                        .testTag(\"saved_config_item_${config.id}\"),\n                    colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.surface)\n                ) {\n                    Row(\n                        modifier = Modifier\n                            .fillMaxWidth()\n                            .padding(16.dp),\n                        verticalAlignment = Alignment.CenterVertically,\n                        horizontalArrangement = Arrangement.SpaceBetween\n                    ) {\n                        Column(modifier = Modifier.weight(1f)) {\n                            Text(\n                                text = config.name,\n                                fontWeight = FontWeight.Bold,\n                                style = MaterialTheme.typography.bodyLarge,\n                                color = MaterialTheme.colorScheme.onSurface\n                            )\n                            Spacer(modifier = Modifier.height(4.dp))\n                            Text(\n                                text = \"${config.seriesCells}S ${config.parallelCells}P \342\200\242 ${nominalV.format(1)}V \342\200\242 ${config.cellCapacityAh.toInt()}Ah Rated\",\n                                style = MaterialTheme.typography.bodySmall,\n                                color = MaterialTheme.colorScheme.onSurfaceVariant\n                            )\n                            Text(\n                                text = \"\340\246\254\340\247\215\340\246\257\340\246\254\340\246\271\340\246\276\340\246\260\340\246\257\340\247\213\340\246\227\340\247\215\340\246\257: ${usableKwh.format(2)} kWh (${config.depthOfDischargePercent.roundToInt()}% DoD)\",\n                                style = MaterialTheme.typography.bodySmall,\n                                color = MaterialTheme.colorScheme.primary,\n                                fontWeight = FontWeight.SemiBold\n                            )\n                        }\n\n                        IconButton(\n                            onClick = { onDeleteConfig(config.id) },\n                            modifier = Modifier.testTag(\"delete_config_${config.id}\")\n                        ) {\n                            Icon(\n                                imageVector = Icons.Default.Delete,\n                                contentDescription = \"Delete design\",\n                                tint = MaterialTheme.colorScheme.error.copy(alpha = 0.8f)\n                            )\n                        }\n                    }\n                }\n            }\n        }\n    }\n}"
      replacement_content: "// TAB 4: Saved Systems History Tab\n@Composable\nfun SavedSystemsTab(\n    savedConfigs: List<BatteryConfig>,\n    lang: String,\n    onLoadConfig: (BatteryConfig) -> Unit,\n    onDeleteConfig: (Int) -> Unit\n) {\n    val t = { key: String -> BatteryLocalizer.get(key, lang) }\n    val usableLabel = when (lang) {\n        \"bn\" -> \"\340\246\254\340\247\215\340\246\257\340\246\254\340\246\271\340\246\276\340\246\260\340\246\257\340\247\213\340\246\227\340\247\215\340\246\257\"\n        \"zh\" -> \"\345\217\257\347\224\250\350\203\275\351\207\217\"\n        \"de\" -> \"Nutzbar\"\n        \"ko\" -> \"\352\260\200\354\232\251 \354\227\220\353\204\210\354\247\200\"\n        else -> \"Usable\"\n    }\n\n    if (savedConfigs.isEmpty()) {\n        Box(\n            modifier = Modifier\n                .fillMaxSize()\n                .padding(32.dp),\n            contentAlignment = Alignment.Center\n        ) {\n            Column(\n                horizontalAlignment = Alignment.CenterHorizontally,\n                verticalArrangement = Arrangement.Center\n            ) {\n                Icon(\n                    imageVector = Icons.Default.History,\n                    contentDescription = null,\n                    modifier = Modifier.size(64.dp),\n                    tint = MaterialTheme.colorScheme.onSurfaceVariant.copy(alpha = 0.4f)\n                )\n                Spacer(modifier = Modifier.height(12.dp))\n                Text(\n                    text = t(\"no_saved\"),\n                    fontWeight = FontWeight.Bold,\n                    style = MaterialTheme.typography.titleMedium,\n                    color = MaterialTheme.colorScheme.onSurfaceVariant\n                )\n                Text(\n                    text = t(\"no_saved_desc\"),\n                    style = MaterialTheme.typography.bodySmall,\n                    textAlign = TextAlign.Center,\n                    color = MaterialTheme.colorScheme.onSurfaceVariant.copy(alpha = 0.7f),\n                    modifier = Modifier.padding(top = 4.dp)\n                )\n            }\n        }\n    } else {\n        LazyColumn(\n            modifier = Modifier\n                .fillMaxSize()\n                .padding(horizontal = 16.dp),\n            verticalArrangement = Arrangement.spacedBy(10.dp)\n        ) {\n            item {\n                Text(\n                    text = t(\"saved_designs_title\"),\n                    style = MaterialTheme.typography.titleMedium,\n                    fontWeight = FontWeight.Bold,\n                    color = MaterialTheme.colorScheme.primary,\n                    modifier = Modifier.padding(vertical = 8.dp)\n                )\n            }\n\n            items(savedConfigs, key = { it.id }) { config ->\n                val nominalV = config.seriesCells * 3.2\n                val totalKwh = (nominalV * config.cellCapacityAh) / 1000.0\n                val usableKwh = totalKwh * (config.depthOfDischargePercent / 100.0)\n\n                Card(\n                    modifier = Modifier\n                        .fillMaxWidth()\n                        .clickable { onLoadConfig(config) }\n                        .testTag(\"saved_config_item_${config.id}\"),\n                    colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.surface)\n                ) {\n                    Row(\n                        modifier = Modifier\n                            .fillMaxWidth()\n                            .padding(16.dp),\n                        verticalAlignment = Alignment.CenterVertically,\n                        horizontalArrangement = Arrangement.SpaceBetween\n                    ) {\n                        Column(modifier = Modifier.weight(1f)) {\n                            Text(\n                                text = config.name,\n                                fontWeight = FontWeight.Bold,\n                                style = MaterialTheme.typography.bodyLarge,\n                                color = MaterialTheme.colorScheme.onSurface\n                            )\n                            Spacer(modifier = Modifier.height(4.dp))\n                            Text(\n                                text = \"${config.seriesCells}S ${config.parallelCells}P \342\200\242 ${nominalV.format(1)}V \342\200\242 ${config.cellCapacityAh.toInt()}Ah Rated\",\n                                style = MaterialTheme.typography.bodySmall,\n                                color = MaterialTheme.colorScheme.onSurfaceVariant\n                            )\n                            Text(\n                                text = \"$usableLabel: ${usableKwh.format(2)} kWh (${config.depthOfDischargePercent.roundToInt()}% DoD)\",\n                                style = MaterialTheme.typography.bodySmall,\n                                color = MaterialTheme.colorScheme.primary,\n                                fontWeight = FontWeight.SemiBold\n                            )\n                        }\n\n                        IconButton(\n                            onClick = { onDeleteConfig(config.id) },\n                            modifier = Modifier.testTag(\"delete_config_${config.id}\")\n                        ) {\n                            Icon(\n                                imageVector = Icons.Default.Delete,\n                                contentDescription = t(\"delete_btn\"),\n                                tint = MaterialTheme.colorScheme.error.copy(alpha = 0.8f)\n                            )\n                        }\n                    }\n                }\n            }\n        }\n    }\n}"
    }
